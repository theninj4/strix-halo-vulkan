[Unit]
Description=ai
After=network.target

[Service]
Type=simple
WorkingDirectory=###
; The LLM machine's line (research/p18-full-context.md, CONCURRENCY.md): three
; conversations at once, each with the model's whole trained context, 262 144
; cells (7.3 GB of KV cache a slot, C6), prefilled in 8192-token batches, which
; cost decode nothing (P16). Voice commands (X-Priority: interactive or
; service_tier "priority") go first and restore their system prompt's
; checkpoint (C4); concurrent decodes share a pass (C5). ~98 GB resident,
; ~68 s to come up.
;ExecStart=###/ai -addr 0.0.0.0:11434 -token= -llm -llm-ctx 262144 -llm-batch 8192 -llm-slots 3
ExecStart=###/ai -addr 0.0.0.0:11434 -token= -embed -tts -tts-gpu -stt -image -edits 3 -wyoming 0.0.0.0:10300
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
