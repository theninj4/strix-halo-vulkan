[Unit]
Description=ai
After=network.target

[Service]
Type=simple
WorkingDirectory=###
; The LLM machine's line (research/p18-full-context.md): the model's whole
; trained context, 262 144 cells (7.3 GB of KV cache), prefilled in 8192-token
; batches, which cost decode nothing (P16) and are the fastest prefill for a
; long prompt. ~83 GB resident, ~66 s to come up.
;ExecStart=###/ai -addr 0.0.0.0:11434 -token= -llm -llm-ctx 262144 -llm-batch 8192
ExecStart=###/ai -addr 0.0.0.0:11434 -token= -embed -tts -tts-gpu -stt -image -edits 3 -wyoming 0.0.0.0:10300
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
