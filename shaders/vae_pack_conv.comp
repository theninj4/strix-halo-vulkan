#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// Pack one fp32 NCHW activation into the blocked fp16 layout
// shaders/vae_conv_wmma.comp reads its B fragments out of, with a one-pixel
// zero border on every side.
//
//     [ceil(C/16)][H+2][W+2][16]
//
// -- channel tiles outermost, then the padded row, then the padded column,
// then 16 channels *contiguous*. That last axis is the whole point, and it is
// IDEAS §5.1b's coverage law meeting the one thing an im2col cannot avoid.
//
// A convolution's B operand is the patch matrix: for one tap (dh, dw) the
// fragment it wants is 16 channels x 16 output pixels, i.e. element (k, n) =
// act[c0 + k, oh + dh, ow0 + n + dw]. With the 16 channels contiguous, that
// fragment is 16 pixels x 32 contiguous bytes at 32-byte spacing -- one
// *fully contiguous 512 B block*, which is exactly a column-major fragment
// load of stride 16. And unlike every tiled layout in this engine so far, it
// stays contiguous at any pixel offset, which is what the +-1 horizontal tap
// shift needs: a layout that tiled the pixel axis in 16s would have the
// dw = -1 window straddle two tiles.
//
// The border is what makes the taps branchless. Every address the kernel
// forms is a real address holding either a real activation or a zero, so
// there is no edge case in the inner loop and no masking of the K axis --
// the convolution's zero padding is *in the data*. It costs (H+2)(W+2)/HW,
// which at 1024x1024 is 0.4%.
//
// Channels past pc.C are zeroed too, so a C that is not a multiple of 16 is
// a padded K rather than a special case (the decoder's conv_in is 16, and
// nothing else is under 128).
//
// The 16-channel axis is the transpose of how NCHW stores it, so the pass
// stages a 16 x BP block through LDS: the read walks whole rows of one
// channel, the write walks whole pixels of 16. Both sides are coalesced;
// neither is a 4-byte gather.
//
// pc.inOff is the fp32 source, pc.outOff the fp16 destination in halves,
// pc.C/H/W the source shape and pc.aux1 the padded row width -- which is
// W+2 except at the very small images the tests decode, where it is held at
// 16 so that the last sixteen pixels of a channel plane are all inside the
// bottom border row. vae_conv_wmma.comp's address clamp lands exactly there
// and has to find zeros. One workgroup per (channel tile, padded row).

#include "vae_common.glsl"

layout(binding = 2) writeonly buffer HAct { float16_t hact[]; };

// Negative control (zimage/vae/gpu_conv_test.go): replicate the edge pixel
// instead of zeroing the border, which is the padding mode a conv port gets
// wrong by habit rather than by accident. It is the cheapest wrong answer
// this pass can give -- it touches 4096 of a 1024x1024 image's pixels -- and
// whether the decoded image notices is a question worth an assertion.
#ifndef PAD_CLAMP
#define PAD_CLAMP 0
#endif

#define WG 256
#define BP 256
#define TILE 16

layout(local_size_x = WG) in;

shared float16_t stage[TILE * BP];

void main() {
    uint Wp = pc.aux1;
    uint Hp = pc.H + 2u;
    uint ct = gl_WorkGroupID.x / Hp;
    uint hp = gl_WorkGroupID.x - ct * Hp;
    uint tid = gl_LocalInvocationID.x;

#if PAD_CLAMP
    bool rowLive = true;
    uint h = uint(clamp(int(hp) - 1, 0, int(pc.H) - 1));
#else
    bool rowLive = hp >= 1u && hp <= pc.H;
    uint h = hp - 1u;
#endif
    uint dst = pc.outOff + (ct * Hp + hp) * Wp * TILE;

    for (uint p0 = 0u; p0 < Wp; p0 += BP) {
        uint n = min(uint(BP), Wp - p0);
        barrier();
        // Read: one channel at a time, consecutive threads on consecutive
        // columns, so each pass is a contiguous sweep of one source row.
        for (uint c = 0u; c < TILE; ++c) {
            uint ch = ct * TILE + c;
            bool chLive = rowLive && ch < pc.C;
            for (uint p = tid; p < n; p += WG) {
                uint wp = p0 + p;
                float v = 0.0;
#if PAD_CLAMP
                if (chLive) {
                    uint w = uint(clamp(int(wp) - 1, 0, int(pc.W) - 1));
                    v = act[pc.inOff + (ch * pc.H + h) * pc.W + w];
                }
#else
                if (chLive && wp >= 1u && wp <= pc.W) {
                    v = act[pc.inOff + (ch * pc.H + h) * pc.W + (wp - 1u)];
                }
#endif
                stage[c * BP + p] = float16_t(v);
            }
        }
        barrier();
        // Write: consecutive threads on consecutive halves.
        for (uint i = tid; i < n * TILE; i += WG) {
            uint p = i >> 4;
            uint c = i & 15u;
            hact[dst + (p0 + p) * TILE + c] = stage[c * BP + p];
        }
    }
}
