#version 450

#if defined(PRECISION_F16) || defined(PRECISION_Q8) || defined(PRECISION_Q4)
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#endif
#if defined(PRECISION_Q8) || defined(PRECISION_Q4)
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#endif

#ifndef TILE
#define TILE 16
#endif

// C = A * B via classic shared-memory tiling. A is MxK, B is KxN, C is MxN.
// PRECISION_Q8/PRECISION_Q4 quantize only B (the weights), matching
// gemm_naive.comp's scheme: one float16 scale per `block`-sized run of
// columns within a row of B. Each B tile element is dequantized once while
// filling shared memory, same as the plain fp32/fp16 paths, so the inner
// product loop is identical regardless of weight format.
layout(local_size_x = TILE, local_size_y = TILE) in;

#ifdef PRECISION_F16
layout(binding = 0) readonly buffer A { float16_t a[]; };
#else
layout(binding = 0) readonly buffer A { float a[]; };
#endif

#if defined(PRECISION_Q8)
layout(binding = 1) readonly buffer B { int8_t b[]; };
layout(binding = 2) readonly buffer Scales { float16_t scales[]; };
#elif defined(PRECISION_Q4)
layout(binding = 1) readonly buffer B { uint8_t b[]; }; // 2 signed nibbles per byte
layout(binding = 2) readonly buffer Scales { float16_t scales[]; };
#elif defined(PRECISION_F16)
layout(binding = 1) readonly buffer B { float16_t b[]; };
layout(binding = 2) readonly buffer Scales { float dummy[]; };
#else
layout(binding = 1) readonly buffer B { float b[]; };
layout(binding = 2) readonly buffer Scales { float dummy[]; };
#endif
layout(binding = 3) writeonly buffer C { float c[]; };

layout(push_constant) uniform PC {
    uint M;
    uint N;
    uint K;
    uint block; // quantization block size along N; unused for f32/f16
} pc;

float loadB(uint k, uint col) {
#if defined(PRECISION_Q8)
    uint idx = k * pc.N + col;
    uint blocksPerRow = pc.N / pc.block;
    uint blockIdx = k * blocksPerRow + (col / pc.block);
    return float(b[idx]) * float(scales[blockIdx]);
#elif defined(PRECISION_Q4)
    uint idx = k * pc.N + col;
    uint byteIdx = idx / 2u;
    uint packed = uint(b[byteIdx]);
    int nibble = (idx & 1u) == 0u ? int(packed & 0xFu) : int(packed >> 4u);
    int signedNibble = nibble - 8;
    uint blocksPerRow = pc.N / pc.block;
    uint blockIdx = k * blocksPerRow + (col / pc.block);
    return float(signedNibble) * float(scales[blockIdx]);
#elif defined(PRECISION_F16)
    return float(b[k * pc.N + col]);
#else
    return b[k * pc.N + col];
#endif
}

shared float tileA[TILE][TILE];
shared float tileB[TILE][TILE];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint lx = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;

    float acc = 0.0;
    uint numTiles = (pc.K + TILE - 1u) / TILE;
    for (uint t = 0u; t < numTiles; t++) {
        uint aCol = t * TILE + lx;
        uint bRow = t * TILE + ly;
#ifdef PRECISION_F16
        tileA[ly][lx] = (row < pc.M && aCol < pc.K) ? float(a[row * pc.K + aCol]) : 0.0;
#else
        tileA[ly][lx] = (row < pc.M && aCol < pc.K) ? a[row * pc.K + aCol] : 0.0;
#endif
        tileB[ly][lx] = (bRow < pc.K && col < pc.N) ? loadB(bRow, col) : 0.0;
        barrier();
        for (uint k = 0u; k < TILE; k++) {
            acc += tileA[ly][k] * tileB[k][lx];
        }
        barrier();
    }

    if (row < pc.M && col < pc.N) {
        c[row * pc.N + col] = acc;
    }
}
