#version 450

#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_control_flow_attributes : enable

// conv2d as an implicit GEMM on the matrix cores -- PIPELINE.md stage 8.
//
// This is the operator stage 7's profiler left pointing at: shaders/
// vae_conv2d.comp is 85% of a 1024x1024 decode at 3.0-3.2 TFLOP/s against a
// 55.5 TFLOP/s fp16 ceiling, and unlike everything else optimised in this
// pipeline it was never a GEMM with the wrong kernel in front of it. It is
// one now:
//
//     C[OC, H*W] = A[OC, taps*C] * B[taps*C, H*W]
//
// with A the filter (reshaped, nothing moves) and B the im2col patch matrix,
// which is never materialised: a patch column is an *address* into the
// activation, so the B fragment for tap (dh, dw), channel tile ct and pixel
// tile p0 is read straight out of the blocked layout shaders/
// vae_pack_conv.comp writes. At 1024x1024 with 256 channels a materialised
// im2col would be 4.7 GB; this reads the 0.5 GB the activation already is.
//
// Both operands are 512 B contiguous fragment loads, which is the finding
// every WMMA stage in this engine has repeated (§2.8, stage 3c, stage 7) and
// the reason the layouts are what they are:
//
//   A  the filter, packed once at load into 16x16 tiles holding element
//      (oc, k) at oc*16 + k, tiles ordered k-fastest -- a row-major fragment
//      load of stride 16. k = tap*C + ic, so a k-tile is 16 input channels
//      at one tap and the tap loop is the outer one.
//   B  the activation, 16 channels contiguous per pixel -- a *column*-major
//      fragment load of stride 16, at any pixel offset. vae_pack_conv.comp
//      says why that last clause is the whole design.
//
// The accumulators are fp32, which is what makes narrowing the operands safe
// here at all: stage 2 measured this decoder's activations at absmax 497 --
// 132x inside fp16's 65504 -- while its *sums* are what reach 1.16e7, and a
// matrix core accumulates in fp32 natively.
//
// The grid is (H * ceil(W/BN), ceil(OC/BM)): x walks pixel tiles inside one
// image row -- a tile never straddles two rows, since a tap shift would then
// wrap the wrong pixels in -- and y walks output-channel slabs. That order is
// deliberate and is §2.4 with the answer coming out the other way: the
// resident workgroups are a row of C, sharing one BM x K slab of the filter
// (288 KB at BM=64, K=2304, hot in L2) while the activation streams past
// once. It is the weight that is small here, so the launch order that ruins
// the DiT is the right one.
//
// The bias is loaded *into* the accumulators rather than added afterwards:
// the host expands each conv bias to [OC, 16] fp32, so one row-major
// accumulator load of stride 16 broadcasts bias[oc] across the tile's 16
// pixels. No epilogue pass, no extra dispatch, and nothing in the inner loop.

#include "vae_common.glsl"

layout(binding = 2) readonly buffer HAct { float16_t hact[]; };
layout(binding = 3) readonly buffer W16 { float16_t w16[]; };

#ifndef WM
#define WM 4        // accumulator tiles per wave, output-channel direction
#endif
#ifndef WN
#define WN 4        // accumulator tiles per wave, pixel direction
#endif
#ifndef WAVES_M
#define WAVES_M 1
#endif
#ifndef WAVES_N
#define WAVES_N 1
#endif
#ifndef BK_TILES
#define BK_TILES 1  // input-channel tiles per inner step
#endif
#ifndef WAVE
#define WAVE 64     // threads per wave; the host pins this when it is 32
#endif
// Negative control (zimage/vae/gpu_conv_test.go). The horizontal tap shift is
// the one thing this kernel's layout exists to make cheap -- a 16-pixel
// fragment window that starts at an arbitrary pixel -- so the control drops
// it and keeps everything else, which is what a kernel that had quietly
// rounded the window down to a tile boundary would compute.
#ifndef NO_TAP_SHIFT
#define NO_TAP_SHIFT 0
#endif

#define TILE 16
#define BM (WAVES_M * WM * TILE)
#define BN (WAVES_N * WN * TILE)
#define NTHREADS (WAVES_M * WAVES_N * WAVE)

layout(local_size_x = NTHREADS) in;

#define FRAG_A_T coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA>
#define FRAG_B_T coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB>
#define ACC_T coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>

// One 16x16 fp32 tile per wave, for the masked store below. 4 KB at four
// waves, which is nothing against the 64 KB that would bound occupancy.
shared float scratch[WAVES_M * WAVES_N * TILE * TILE];

void main() {
    uint waveM = gl_SubgroupID / WAVES_N;
    uint waveN = gl_SubgroupID % WAVES_N;

    uint tilesPerRow = pc.aux0;
    uint row = gl_WorkGroupID.x / tilesPerRow;
    uint col0 = (gl_WorkGroupID.x - row * tilesPerRow) * BN;

    uint wm0 = gl_WorkGroupID.y * BM + waveM * (WM * TILE);  // output channel
    uint wn0 = col0 + waveN * (WN * TILE);                   // output column

    uint ctiles = (pc.C + TILE - 1u) / TILE;
    uint taps = pc.KH * pc.KW;
    uint Wp = pc.aux1;
    uint plane = (pc.H + 2u) * Wp;
    // Every pixel address is clamped to the last whole fragment of its own
    // channel plane, so that no address this kernel forms can leave the
    // buffer whatever W and BN are. What makes the clamp harmless is that the
    // fragment it lands on is the *end of the bottom border row*, which is
    // sixteen zeros: the pack holds Wp at 16 or more for exactly that reason,
    // since at Wp < 16 the clamped window reaches back into the last real row
    // and hands the last output row two columns of somebody else's pixels.
    uint pmax = plane - TILE;

    ACC_T acc[WM][WN];
    [[unroll]] for (uint i = 0u; i < WM; i++) {
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            if (pc.bOff != NO_BIAS) {
                coopMatLoad(acc[i][j], wbuf, pc.bOff + (wm0 + i * TILE) * TILE,
                    TILE, gl_CooperativeMatrixLayoutRowMajor);
            } else {
                acc[i][j] = ACC_T(0.0);
            }
        }
    }

    for (uint tap = 0u; tap < taps; tap++) {
        int dh = int(tap / pc.KW) - int(pc.pad);
#if NO_TAP_SHIFT
        int dw = 0;
#else
        int dw = int(tap % pc.KW) - int(pc.pad);
#endif
        // The +1s are the border: output pixel (row, c) is padded pixel
        // (row+1, c+1), so the tap shift is a plain add and never leaves the
        // buffer.
        uint pixBase = uint(int((row + 1u) * Wp + wn0 + 1u) + dh * int(Wp) + dw);
        uint pix[WN];
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            pix[j] = min(pixBase + j * TILE, pmax);
        }
        uint ktap = tap * ctiles;

        for (uint ic0 = 0u; ic0 < ctiles; ic0 += BK_TILES) {
            [[unroll]] for (uint kt = 0u; kt < BK_TILES; kt++) {
                uint ct = ic0 + kt;
                if (ct >= ctiles) {
                    continue;
                }
                FRAG_A_T fragA[WM];
                FRAG_B_T fragB[WN];
                [[unroll]] for (uint i = 0u; i < WM; i++) {
                    coopMatLoad(fragA[i], w16,
                        pc.gemmB + (((wm0 + i * TILE) / TILE) * (taps * ctiles) + ktap + ct) * (TILE * TILE),
                        TILE, gl_CooperativeMatrixLayoutRowMajor);
                }
                [[unroll]] for (uint j = 0u; j < WN; j++) {
                    coopMatLoad(fragB[j], hact, pc.inOff + (ct * plane + pix[j]) * TILE,
                        TILE, gl_CooperativeMatrixLayoutColumnMajor);
                }
                [[unroll]] for (uint i = 0u; i < WM; i++) {
                    [[unroll]] for (uint j = 0u; j < WN; j++) {
                        acc[i][j] = coopMatMulAdd(fragA[i], fragB[j], acc[i][j]);
                    }
                }
            }
        }
    }

    // The store writes NCHW fp32, which is what every other kernel in this
    // decoder reads: tile (i, j) is 16 channels x 16 consecutive pixels of one
    // row, so a row-major store of stride H*W puts WN*16 contiguous floats in
    // each of 16 channel planes.
    //
    // A tile that hangs off either edge -- OC not a multiple of BM, W not a
    // multiple of BN -- goes through LDS instead and is written element by
    // element. Both happen: conv_out has three output channels, and the 16x16
    // reference latent makes W as small as 16. The sync is subgroup-scoped
    // because the branch is wave-uniform and not workgroup-uniform.
    uint HW = pc.H * pc.W;
    uint rowBase = pc.outOff + row * pc.W;
    uint mine = gl_SubgroupID * (TILE * TILE);
    [[unroll]] for (uint i = 0u; i < WM; i++) {
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            uint oc0 = wm0 + i * TILE;
            uint p0 = wn0 + j * TILE;
            if (oc0 + TILE <= pc.OC && p0 + TILE <= pc.W) {
                coopMatStore(acc[i][j], act, rowBase + oc0 * HW + p0, HW,
                    gl_CooperativeMatrixLayoutRowMajor);
            } else if (oc0 < pc.OC && p0 < pc.W) {
                subgroupMemoryBarrierShared();
                subgroupBarrier();
                coopMatStore(acc[i][j], scratch, mine, TILE,
                    gl_CooperativeMatrixLayoutRowMajor);
                subgroupMemoryBarrierShared();
                subgroupBarrier();
                for (uint e = gl_SubgroupInvocationID; e < TILE * TILE; e += gl_SubgroupSize) {
                    uint m = e >> 4, n = e & 15u;
                    if (oc0 + m < pc.OC && p0 + n < pc.W) {
                        act[rowBase + (oc0 + m) * HW + p0 + n] = scratch[mine + e];
                    }
                }
            }
        }
    }
}
