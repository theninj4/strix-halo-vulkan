#version 450
// A gated residual, end to end: RMS norm over the whole row of the branch
// output, the adaLN gate, and the add into the residual stream.
//
// dit_rmsnorm.comp followed by dit_gate_add.comp is 315 MB of traffic at 4096
// tokens against this one's 189 -- the normalised tensor is written and read
// back for nothing -- and the block does this twice, once for attention and
// once for the feed forward.
//
// pc.inOff is the branch output, pc.outOff the residual stream (updated in
// place), pc.wOff the norm's learned weight in the weight arena, and pc.aux0
// the gate in the *activation* arena, since adaLN forms it per step.

#include "dit_common.glsl"

#define WG 256
layout(local_size_x = WG) in;

shared float partial[WG];

void main() {
    uint r = gl_WorkGroupID.x;
    uint t = gl_LocalInvocationID.x;
    if (r >= pc.tokens) {
        return;
    }
    uint src = pc.inOff + r * pc.dim;
    uint dst = pc.outOff + r * pc.dim;

    float s = 0.0;
    for (uint c = t; c < pc.dim; c += WG) {
        float v = act[src + c];
        s += v * v;
    }
    partial[t] = s;
    barrier();
    for (uint step = WG / 2u; step > 0u; step >>= 1) {
        if (t < step) {
            partial[t] += partial[t + step];
        }
        barrier();
    }
    float inv = inversesqrt(partial[0] / float(pc.dim) + uintBitsToFloat(pc.eps));

    for (uint c = t; c < pc.dim; c += WG) {
        act[dst + c] += act[pc.aux0 + c] * (act[src + c] * inv * wbuf[pc.wOff + c]);
    }
}
