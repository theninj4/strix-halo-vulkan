#version 450
// (H*W, C) -> (C, H, W), adding the attention block's residual on the way
// back, and the output projection's bias with it. Fused because the
// alternative is a second full pass over the tensor for an elementwise add,
// and IDEAS §3.2's point is that these passes are pure bandwidth and the only
// win is not doing them.
//
// The bias is here because the projection kernel this pass was written for
// had none and wrote a bare A*B, so the VAE's four biases lived in the
// passes already reading those tensors. pc.aux0 is NO_BIAS on the path in
// use today (qvae_gemm_f32.comp, IMAGE.md Q9b), which seeds each accumulator
// from the bias instead -- float addition is not associative, and starting
// from the bias is what keeps that GEMM bit-identical to the scalar one.

#include "vae_common.glsl"

layout(local_size_x = 256) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint hw = pc.H * pc.W;
    if (idx >= hw * pc.C) {
        return;
    }
    uint p = idx % hw;
    uint c = idx / hw;
    float v = act[pc.inOff + p * pc.C + c] + act[pc.resOff + idx];
    if (pc.aux0 != NO_BIAS) {
        v += wbuf[pc.aux0 + c];
    }
    act[pc.outOff + idx] = v;
}
