#version 450
// max(x, 0), elementwise.
//
// taef1's activation (IMAGE.md I2), and the only kernel the preview decoder
// adds to the set stage 8 left behind: everything else in that graph is a 3x3
// convolution, a nearest 2x upsample or a residual add, all of which the
// AutoencoderKL decoder already put on the device.

#include "vae_common.glsl"

layout(local_size_x = 256) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.aux0) {
        return;
    }
    act[pc.outOff + idx] = max(act[pc.inOff + idx], 0.0);
}
