#version 450
// The gated residual: x += gate * y, with gate a row vector broadcast down
// the sequence.
//
// Both of the block's residuals have this shape -- attention's and the feed
// forward's -- and in both the gate comes from adaLN (dit_adaln.comp) and so
// lives in the activation arena rather than the weight arena, which is why
// its offset is pc.aux0 and not pc.wOff.
//
// x is updated in place: the residual stream is one tensor for the whole
// block, which is what lets stage 4 run 34 of these back to back without a
// copy between them.
//
// pc.aux2 = 0 drops the gate, which is the context refiner's path: two of the
// DiT's 34 blocks are built with modulation=False and add their branch output
// to the residual ungated (stage 4c).

#include "dit_common.glsl"

#extension GL_EXT_control_flow_attributes : enable
// HOIST (KERNELS.md G6, research §5.4): every load of the row issued before
// its first store. The residual is read and written through one binding, so
// the plain loop is load, wait, store, a 256-byte request at a time a wave
// (h3_norm_mod.comp's HOIST). Rows up to STEPS * 256 wide. The default build
// is the plain loop, which every host that has not re-run its gate keeps.
#ifndef HOIST
#define HOIST 0
#endif
#define STEPS 24

layout(local_size_x = 256) in;

void main() {
    uint r = gl_WorkGroupID.x;
    if (r >= pc.tokens) {
        return;
    }
    // One workgroup per row rather than a flat grid: the gate is indexed by
    // the column, and a flat grid would pay an integer division by a width
    // that is not a power of two (3840) on every element (IDEAS §1.2).
    uint base = r * pc.dim;
#if HOIST
    float x[STEPS], y[STEPS], g[STEPS];
    [[unroll]] for (uint j = 0u; j < STEPS; j++) {
        uint c = gl_LocalInvocationID.x + j * 256u;
        if (c < pc.dim) {
            y[j] = act[pc.inOff + base + c];
            x[j] = act[pc.outOff + base + c];
            if (pc.aux2 != 0u) {
                g[j] = act[pc.aux0 + c];
            }
        }
    }
    [[unroll]] for (uint j = 0u; j < STEPS; j++) {
        uint c = gl_LocalInvocationID.x + j * 256u;
        if (c < pc.dim) {
            float v = y[j];
            if (pc.aux2 != 0u) {
                v *= g[j];
            }
            act[pc.outOff + base + c] = x[j] + v;
        }
    }
#else
    for (uint c = gl_LocalInvocationID.x; c < pc.dim; c += 256u) {
        float v = act[pc.inOff + base + c];
        if (pc.aux2 != 0u) {
            v *= act[pc.aux0 + c];
        }
        act[pc.outOff + base + c] += v;
    }
#endif
}
