// Kev (CLASSIFICATION.md K7.3): gated full attention on the matrix cores,
// under Kev's block-causal mask.
//
// K4's kev_attention walks keys one at a time. It is the correctness kernel
// and it was 637 ms of a 1375 ms pass at 2,439 tokens. This is the same
// function as a flash attention on 16x16x16 fp16 cooperative matrices, laid
// out after dit_attention_wmma.comp (whose header explains the two tricks
// used here): per-row scalars -- the running max and the rescale -- are
// staged in LDS as a tile with the value replicated across its row and loaded
// back as an accumulator of the same layout, so `o * corr` and `s - max` are
// element-wise operations on matrices whose lane mapping is the same whatever
// it is; and the mask is applied where P is written to LDS.
//
// One wave a (16 query rows, query head). Head dim 256 is 16 k-steps for
// Q K^T and 16 output tiles for P V; a key block is KTIL x 16 keys.
//
// **The mask is per (row, key)**, because a 16-row tile can straddle the end
// of the state and the start of a branch, or two branches:
//
//	allowed(r, key) = key <= cell(r) && (key in [sLo(r), sHi(r)) || key >= lo(r))
//
// with cell(r) the row's cache cell (its metadata's fourth word) and lo(r)
// the cell of its segment's first token, and [sLo, sHi) its request's state
// cells (K7.5: a pass may hold several requests). A state row has an empty
// state range and lo at its state's first cell, so it is plain causal.
//
// **Branches start on 64-aligned cells** (the host lays them out so), which
// is what keeps this kernel exact across layouts: a key block then holds the
// state's keys or one branch's, never a mix, so a row meets the same blocks
// with the same contents wherever its branch sits in the cache, and a block
// it may see none of is an exact no-op (a rescale by 1, a sum of zeros).
// Without it, removing one question moved the others' answers by ~1e-4.
// The cells after a segment up to the boundary are masked but still inside
// a block its rows see, and 0 x their V is not a no-op on the matrix cores:
// kev_attn_prep zeroes that V padding (K7.7).
//
// A key block no row of the tile may see (other branches', other requests')
// is skipped. A row's first processed block need not hold one of its keys
// (K7.5), so a row whose running max is still -inf is not rescaled.
//
// Operands: q fp16 [rows][16][256], pre-scaled by log2(e)/16 (exp2 below);
// K and V fp16 [cells][4][256]. The K^T operand is K read column-major, V
// is read row-major, both with the 1024-half row stride of a cell.
//
// Fields (dit_common.glsl):
//
//	inOff   q (fp16 arena)                  outOff  o_proj's A operand (fp16), row stride lda
//	kOff    key cache (fp16 arena)          vOff    value cache
//	aux1    token metadata, 8 words a row (see kev_gdn_prep.comp) in the fp32 arena
//	gemmK   P, for the gates, row stride aux0          tokens  the pass's rows

#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

#include "dit_common.glsl"

layout(binding = 2) buffer HAct { float16_t hact[]; };

#ifndef KTIL
#define KTIL 4
#endif

#define TILE 16
#define HD 256u
#define HDT 16u
#define NQ 16u
#define NKV 4u
#define CELL (NKV * HD)     // halves a cache cell
#define QROW (NQ * HD)      // halves a q row
#define BN (KTIL * TILE)
#define WAVE 64

layout(local_size_x = WAVE) in;

#define ACC  coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define ACCH coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define FRAG_A coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA>
#define FRAG_B coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB>

shared float stage[TILE * TILE];
shared float bcorr[TILE * TILE];
shared float16_t pbuf[TILE * BN];
shared float rowMax[TILE];
shared float blkMax[TILE];
shared uint rowCell[TILE];
shared uint rowLo[TILE];     // lo(r): the cell where the row's own segment begins
shared uint rowSLo[TILE];    // the row's request's state cells [sLo, sHi) (K7.5)
shared uint rowSHi[TILE];
shared uint useful;
shared uint tileHi;

void main() {
    uint q0 = gl_WorkGroupID.x * TILE;
    uint h = gl_WorkGroupID.y;
    uint g = h / (NQ / NKV);
    uint lane = gl_LocalInvocationID.x;
    uint n = pc.tokens;

    if (lane == 0u) {
        tileHi = 0u;
    }
    barrier();
    if (lane < TILE) {
        uint r = q0 + lane;
        uint cell = 0u, lo = 1u, sLo = 0u, sHi = 0u; // a pad row sees nothing
        if (r < n) {
            cell = floatBitsToUint(act[pc.aux1 + r * 8u + 3u]);
            lo = cell - (r - floatBitsToUint(act[pc.aux1 + r * 8u + 2u]));
            sLo = floatBitsToUint(act[pc.aux1 + r * 8u + 4u]);
            sHi = floatBitsToUint(act[pc.aux1 + r * 8u + 5u]);
            atomicMax(tileHi, cell + 1u);
        }
        rowCell[lane] = cell;
        rowLo[lane] = lo;
        rowSLo[lane] = sLo;
        rowSHi[lane] = sHi;
        rowMax[lane] = -1.0 / 0.0;
    }
    barrier();
    uint hi = tileHi;

    FRAG_A fragQ[HDT];
    [[unroll]] for (uint kt = 0u; kt < HDT; ++kt) {
        coopMatLoad(fragQ[kt], hact, pc.inOff + q0 * QROW + h * HD + kt * TILE, QROW,
            gl_CooperativeMatrixLayoutRowMajor);
    }
    ACC o[HDT];
    [[unroll]] for (uint j = 0u; j < HDT; ++j) {
        o[j] = ACC(0.0);
    }
    ACC lsum = ACC(0.0);
    const FRAG_B ones = FRAG_B(float16_t(1.0));

    uint kBase = pc.kOff + g * HD, vBase = pc.vOff + g * HD;
    for (uint base = 0u; base < hi; base += BN) {
        // Skip a block none of the tile's rows may see a key of: other
        // branches', other requests' (K7.5).
        if (lane == 0u) {
            useful = 0u;
        }
        barrier();
        if (lane < TILE) {
            uint b1 = base + BN;
            bool see = (rowSLo[lane] < min(b1, rowSHi[lane]) && base < rowSHi[lane]) ||
                       (max(base, rowLo[lane]) <= min(b1 - 1u, rowCell[lane]));
            if (see) {
                atomicOr(useful, 1u);
            }
        }
        barrier();
        if (useful == 0u) {
            continue;
        }

        ACC s[KTIL];
        [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
            s[kk] = ACC(0.0);
        }
        [[unroll]] for (uint kt = 0u; kt < HDT; ++kt) {
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                FRAG_B fk;
                coopMatLoad(fk, hact, kBase + (base + kk * TILE) * CELL + kt * TILE, CELL,
                    gl_CooperativeMatrixLayoutColumnMajor);
                s[kk] = coopMatMulAdd(fragQ[kt], fk, s[kk]);
            }
        }

        // This block's max per row, over allowed keys only.
        if (lane < TILE) {
            blkMax[lane] = -1.0 / 0.0;
        }
        [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
            barrier();
            coopMatStore(s[kk], stage, 0u, TILE, gl_CooperativeMatrixLayoutRowMajor);
            barrier();
            if (lane < TILE) {
                float mx = blkMax[lane];
                uint cell = rowCell[lane], rlo = rowLo[lane];
                for (uint c = 0u; c < TILE; ++c) {
                    uint key = base + kk * TILE + c;
                    if (key <= cell && ((key >= rowSLo[lane] && key < rowSHi[lane]) || key >= rlo)) {
                        mx = max(mx, stage[lane * TILE + c]);
                    }
                }
                blkMax[lane] = mx;
            }
        }
        barrier();
        for (uint i = lane; i < TILE * TILE; i += WAVE) {
            uint r = i / TILE;
            float mo = rowMax[r];
            float mn = max(mo, blkMax[r]);
            stage[i] = mn;
            // A row that has seen no key yet has mo = mn = -inf: nothing to
            // rescale (K7.5: its first block need not hold one of its keys).
            bcorr[i] = mn == -1.0 / 0.0 ? 1.0 : exp2(mo - mn);
        }
        barrier();
        if (lane < TILE) {
            rowMax[lane] = max(rowMax[lane], blkMax[lane]);
        }
        ACC mrow, ccorr;
        coopMatLoad(mrow, stage, 0u, TILE, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(ccorr, bcorr, 0u, TILE, gl_CooperativeMatrixLayoutRowMajor);
        [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
            ACC p = s[kk] - mrow;
            [[unroll]] for (uint e = 0u; e < p.length(); ++e) {
                p[e] = exp2(p[e]);
            }
            coopMatStore(ACCH(p), pbuf, kk * TILE, BN, gl_CooperativeMatrixLayoutRowMajor);
        }
        [[unroll]] for (uint j = 0u; j < HDT; ++j) {
            o[j] = o[j] * ccorr;
        }
        lsum = lsum * ccorr;
        barrier();
        // The mask, on P: a masked key contributes nothing to P V or the sum.
        for (uint i = lane; i < TILE * BN; i += WAVE) {
            uint r = i / BN;
            uint key = base + i % BN;
            if (!(key <= rowCell[r] && ((key >= rowSLo[r] && key < rowSHi[r]) || key >= rowLo[r]))) {
                pbuf[i] = float16_t(0.0);
            }
        }
        barrier();

        FRAG_A fragP[KTIL];
        [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
            coopMatLoad(fragP[kk], pbuf, kk * TILE, BN, gl_CooperativeMatrixLayoutRowMajor);
        }
        [[unroll]] for (uint j = 0u; j < HDT; ++j) {
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                FRAG_B fv;
                coopMatLoad(fv, hact, vBase + (base + kk * TILE) * CELL + j * TILE, CELL,
                    gl_CooperativeMatrixLayoutRowMajor);
                o[j] = coopMatMulAdd(fragP[kk], fv, o[j]);
            }
        }
        [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
            lsum = coopMatMulAdd(fragP[kk], ones, lsum);
        }
        barrier();
    }

    // o / sum, times sigmoid(gate), into o_proj's A operand.
    coopMatStore(lsum, stage, 0u, TILE, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint i = lane; i < TILE * TILE; i += WAVE) {
        bcorr[i] = 1.0 / stage[(i / TILE) * TILE];
    }
    barrier();
    ACC cinv;
    coopMatLoad(cinv, bcorr, 0u, TILE, gl_CooperativeMatrixLayoutRowMajor);
    // Only the pass's rows are written: a kernel does not write outside its
    // pass. The tile goes through LDS and lanes store its real rows.
    [[unroll]] for (uint j = 0u; j < HDT; ++j) {
        ACC gate;
        coopMatLoad(gate, act, pc.gemmK + q0 * pc.aux0 + h * 512u + 256u + j * TILE, pc.aux0,
            gl_CooperativeMatrixLayoutRowMajor);
        [[unroll]] for (uint e = 0u; e < gate.length(); ++e) {
            gate[e] = 1.0 / (1.0 + exp(-gate[e]));
        }
        barrier();
        coopMatStore(o[j] * cinv * gate, stage, 0u, TILE, gl_CooperativeMatrixLayoutRowMajor);
        barrier();
        for (uint i = lane; i < TILE * TILE; i += WAVE) {
            uint r = q0 + i / TILE;
            if (r < n) {
                hact[pc.outOff + r * pc.lda + h * HD + j * TILE + i % TILE] = float16_t(stage[i]);
            }
        }
    }
}
