#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// The epilogues of MuQ's Res2d blocks (MUSIC.md A14d), over a convolution's
// GEMM output, fp32 [F][kStride][512] (one output frequency row a GEMM):
//
//   mode 0  relu(y + b)            -> hact, bordered [F+2][span][512]
//   mode 1  relu(y + b + sc)       -> the same          (sc carries its bias)
//   mode 2  relu(y + b + sc + b3)  -> hact[outOff + (t - dim)*lda + c*F + f]
//           for t in [dim, dim + span): the Linear's operand in
//           rearrange("b c f t -> b t (c f)") order
//
// Modes 0 and 1 write zero where the global time is outside the song, so
// the next convolution sees its padding there.
//
//   pc.inOff  y, act            pc.kOff  sc, act (modes 1, 2)
//   pc.wOff   b, wbuf           pc.aux0  b3, wbuf (mode 2)
//   pc.headDim  the mode        pc.heads F (frequency rows)
//   pc.tokens   times           pc.kStride  y's (and sc's) time pitch
//   pc.span     the bordered pitch (modes 0, 1)
//   pc.aux1     the chunk's first time, global (an int)
//   pc.aux2     the song's times (modes 0, 1)
//   pc.lda      the operand's row pitch (mode 2); pc.dim its first time and
//               pc.span the times it takes
#include "dit_common.glsl"
layout(binding = 2) writeonly buffer HAct { float16_t hact[]; };
layout(local_size_x = 256) in;
void main() {
    uint c = gl_GlobalInvocationID.x & 511u;
    uint t = gl_GlobalInvocationID.x >> 9;
    uint f = gl_WorkGroupID.y;
    if (t >= pc.tokens || f >= pc.heads) {
        return;
    }
    uint i = (f * pc.kStride + t) * 512u + c;
    float y = act[pc.inOff + i] + wbuf[pc.wOff + c];
    if (pc.headDim >= 1u) {
        y += act[pc.kOff + i];
    }
    if (pc.headDim == 2u) {
        y += wbuf[pc.aux0 + c];
    }
    y = max(y, 0.0);
    if (pc.headDim == 2u) {
        if (t >= pc.dim && t < pc.dim + pc.span) {
            hact[pc.outOff + (t - pc.dim) * pc.lda + c * pc.heads + f] = float16_t(y);
        }
        return;
    }
    int g = int(pc.aux1) + int(t);
    if (g < 0 || g >= int(pc.aux2)) {
        y = 0.0;
    }
    hact[pc.outOff + ((f + 1u) * pc.span + t + 1u) * 512u + c] = float16_t(y);
}
