#version 450

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_control_flow_attributes : enable

// The hyper-connection down projection at **one token**: LLM.md L7d.
//
// L7c-6 priced it. At T=1 a mixer is 293.5 us of which the down projection is
// 237.6 at **29 GB/s**, 8.3x off this machine's bus, while the up projection
// beside it reads the same kind of weight at 143. Nothing about the
// arithmetic is different; the grid is. `llm_gemm.comp` blocks the output
// columns — BN=48 over a fused N of 336 — so the whole matrix is **seven
// workgroups** on a 40-CU device, each pulling 1 MB of weight through one
// wave, and fifteen of every sixteen rows of its A fragment are padding
// because there is one token.
//
// At M=1 the parallelism cannot come from N: there are only 336 of them and
// they are the *output*. It has to come from **K**, which is 10240. So this
// is the ordinary split-K GEMV, in two dispatches:
//
//   MODE 0  (s, nt) -> partial[s][nt*16 .. nt*16+16)      KSLABS x 21 groups
//   MODE 1  sum over s, then MODE 0 of llm_gemm's epilogue
//
// with `KSLABS` compiled in rather than pushed, for the reason BM and BN are:
// the host has to know it to size the scratch and shape the grid, and a
// mismatch would be a wrong answer rather than a slow one.
//
// **Which KSLABS is §5.1b's 4 KB period and not the workgroup count.** The
// ladder is not monotonic and it is not noise — 8/16/32/40/80/160 slabs give
// 181/154/219/129/138/230 GB/s — and what separates them is the distance
// between two workgroups' slabs, `(gemmK/16/KSLABS) * 512` bytes:
//
//   KSLABS      8     16     32     40     80    160
//   slab, B  40960  20480  10240   8192   4096   2048
//   x 4 KB      10      5    2.5      2      1    0.5
//   GB/s       181    154    219    129    138    230
//
// Every rung whose slab is a whole multiple of 4 KB is slow and both that are
// not are fast, which is the period §5.1b pinned for DRAM channel aliasing on
// this part — measured there across nine strides in one rotation, and here
// across six with the byte set identical in all of them. So the rung to pick
// is not the widest split; it is the one whose stride misses the rotation,
// and at 160 that is **230 GB/s, 95% of the bus**, against the GEMM's 29.
//
// **The weight layout is the one the GEMM already staged** (§2.8 fragment
// tiling, packDownB): tile (nt, kt) is 256 contiguous halves holding element
// (k, n) at (n%16)*16 + k%16, tiles ordered kt-fastest. That is not a layout
// a GEMV would have chosen, and it turns out not to matter — it is exactly
// what makes this kernel's reads perfect. Within an n-tile the tiles of
// consecutive kt are contiguous, so **one workgroup's whole slab is one
// contiguous run** of `(gemmK/16/KSLABS) * 512` bytes, and inside it a wave
// of 64 lanes taking 16 halves each covers 1024 consecutive halves with no
// gaps. The (n%16)*16 + k%16 order then hands each lane a single output
// column and sixteen consecutive k of it, which is one accumulator per lane
// and no LDS at all.
//
// The cross-lane reduction is the shape that falls out of that: lane l holds
// column l%16 of tile l/16, so the four lanes that share a column are
// l, l^16, l^32 — two shuffles, and lanes 0..15 hold the sixteen sums.
//
// No bounds checks, as everywhere in this ladder. gemmN is a multiple of 16
// by construction (lowRank + one tile, padded to the GEMM's BN), gemmK a
// multiple of 16*KSLABS, and the arenas are zeroed once.
//
// **-DQ8B is L8b's arm, and it is bit-exact.** The bank it reads is the one
// llm_gemm.comp's Q8 arm reads — int8 tiles in the same fragment tiling, an
// fp16 scale per 32 elements of a row in a k-major plane behind them — so a
// lane's sixteen consecutive halves become sixteen consecutive *bytes*, four
// `uint` loads, and one scale: a 32-element group is two whole k-tiles, so
// the scale is constant across the tile the lane owns.
//
// It is bit-exact rather than nearly so, and that needs one thing said. This
// kernel has no LDS stage to round a weight through, and `float(float16_t(x))`
// in a register is folded away by RADV (D10) — so the fp16 rounding the GEMM
// gets for free from its LDS store would simply not happen here, and the two
// would disagree by a weight ulp on a 10240-long dot product. The fix is to
// do the multiply **in fp16**: `float16_t(q) * d` where both operands are
// already exact halves is a real f16 instruction the compiler cannot fold,
// and its correctly-rounded result is the same half `float16_t(float(q) * d)`
// produces, because q has at most 8 significant bits and d at most 11, so
// their f32 product is exact and the second rounding is the only one.
// TestHCGPUQ8IsTheHalves is the check, over both dispatches of the pair.

// **-DQ4B is L8c-6's arm**, and it is the same kernel again with a nibble
// where the Q8 arm has a byte. The fused down projection's k is 10240, so a
// super-block is ggml's eight groups and the record is the sixteen bytes
// `llm_q4k.glsl` decodes — the ten-group packing the block's *up* projection
// needs never reaches this kernel, because at one token the up projection is
// still a GEMM (its N is 10240 and the parallelism is already there).
//
// Unlike the Q8 arm it is **not** bit-exact against the GEMM, and cannot be:
// a K-quant group is affine, so `d*sc*l - dmin*m` has a subtraction in it and
// there is no pair of exact halves to multiply. The register path carries one
// fewer rounding than the GEMM's LDS store, which is L8c-4's finding on the
// lm head and the same size here.

#include "llm_common.glsl"

#ifndef MODE
#define MODE 0
#endif
// How many ways K is split. 10240 is 640 tiles; at KSLABS=160 a workgroup
// reads four of them — 2 KB, contiguous, one step — and the grid is 160 x 21
// = 3360 waves for a matrix the GEMM ran in seven. A slab has to be a whole
// number of steps, so gemmK/16 must divide by 4*KSLABS; the host checks it.
#ifndef KSLABS
#define KSLABS 16
#endif
#define TILE 16
#define WAVE 64

// Rows of A this dispatch carries: P5b's specialization constant, the same
// one llm_gemv.comp takes and for the same reason. At two tokens the GEMM the
// host used to fall back to costs this projection **14.3x** — 16.5 us a mixer
// to 234.4, reading its bank at 10.3 GB/s against this kernel's 145 — because
// a [10240, 320] matrix at `BM = 1` is a grid of **five workgroups** on a
// 40-CU device (D11). The weight is read once and multiplied into ROWS
// accumulators, so the R-row arm costs the second row's A traffic and nothing
// else.
layout(constant_id = 0) const uint ROWS = 1;
#define MAXROWS 2

#ifdef Q4B
#include "llm_q4k.glsl"
#endif

layout(local_size_x = WAVE) in;

float sigmoidf(float x) { return 1.0 / (1.0 + exp(-x)); }

void main() {
#if MODE == 0
    uint slab = gl_WorkGroupID.x;                // which stripe of K
    uint nt = gl_WorkGroupID.y;                  // which 16 output columns
    uint ktiles = pc.gemmK / TILE;               // 640
    uint perSlab = ktiles / KSLABS;              // 40
    uint kt0 = slab * perSlab;

    uint lane = gl_LocalInvocationID.x;
    uint col = lane % TILE;                      // the output column this lane owns
    uint sub = lane / TILE;                      // which of the four tiles of a step
    uint xbase = pc.xnOff + kt0 * TILE;

#ifdef Q4B
    uint nsb = pc.gemmK >> 8;
    uint nk = pc.gemmN * pc.gemmK;
    // P3a's plane sits between the tiles and the records; `QK_HIGH_BYTES` is
    // zero without -DQ5B, so this is the same base it always was there.
    uint high0 = (pc.bOff + (nk >> 1)) >> 2;
    uint rec0 = (pc.bOff + (nk >> 1) + QK_HIGH_BYTES(nk)) >> 2;
    // A tile is 32 words and a lane owns two of them — the eight k either
    // side of `col`'s sixteen — with `sub` picking which of the step's four
    // tiles, the way lane*4 does on the Q8 arm. The fused down projection is
    // quantised all the way through — `inject` included, since D13's payoff
    // (P2) — so there is no split and no fp16 tail.
    uint qbase = (pc.bOff >> 2) + (nt * ktiles + kt0) * 32u + sub * 32u + col * 2u;
    // The same index without the buffer base is the plane's byte index: a
    // high byte covers exactly the nibble word it is named by.
    uint hbi = (nt * ktiles + kt0) * 32u + sub * 32u + col * 2u;
#elif defined(Q8B)
    // The tiles as words and the scale plane as halves, exactly as the GEMM
    // derives them: a matrix is gemmN x gemmK bytes and the plane follows it,
    // and every row — `inject` included — is int8 on it.
    uint qbase = (pc.bOff >> 2) + (nt * ktiles + kt0) * 64u + lane * 4u;
    uint sbase = ((pc.bOff + pc.gemmN * pc.gemmK) >> 1) + nt * (pc.gemmK >> 5) * TILE + col;
#else
    // Where this workgroup's contiguous run starts, in halves.
    uint wbase = pc.bOff + (nt * ktiles + kt0) * (TILE * TILE);
#endif

    float sum[MAXROWS];
    [[unroll]] for (uint r = 0u; r < MAXROWS; r++) {
        sum[r] = 0.0;
    }
#ifdef Q4B
    {
        uint curSB = 0xffffffffu;
        uvec4 rec = uvec4(0u);
        for (uint c = 0u; c < perSlab; c += 4u) {
            uint g = (kt0 + c + sub) >> 1;       // a 32-group is two k-tiles
            uint sb = g >> 3;
            if (sb != curSB) {
                curSB = sb;
                uint idx = rec0 + ((nt * nsb + sb) * TILE + col) * 4u;
                rec = uvec4(w8[idx], w8[idx + 1u], w8[idx + 2u], w8[idx + 3u]);
            }
            uint sc, mn;
            q4kScaleMin(g & 7u, rec.yzw, sc, mn);
            vec2 dd = unpackHalf2x16(rec.x);
            float ds = dd.x * float(sc), dm = dd.y * float(mn);
            uint w = qbase + c * 32u;
            uint x = xbase + (c + sub) * TILE;
            [[unroll]] for (uint u = 0u; u < 2u; u++) {
                uint word = w8[w + u];
                uint hb = QK_HIGH_BYTE(high0, hbi + c * 32u + u);
                [[unroll]] for (uint t = 0u; t < 4u; t++) {
                    uint by = bitfieldExtract(word, int(t * 8u), 8);
                    uint e = u * 8u + t * 2u;
                    float wlo = ds * float(QK_LEVEL_LO(by, hb, t)) - dm;
                    float whi = ds * float(QK_LEVEL_HI(by, hb, t)) - dm;
                    [[unroll]] for (uint r = 0u; r < MAXROWS; r++) {
                        if (r < ROWS) {
                            uint xr = x + r * pc.lda;
                            sum[r] += wlo * float(hact[xr + e]);
                            sum[r] += whi * float(hact[xr + e + 1u]);
                        }
                    }
                }
            }
        }
    }
#elif defined(Q8B)
    {
        // One step is four tiles: 1024 bytes of weight, 64 halves of
        // activation, and one scale a lane — group (kt0+c+sub)/2.
        for (uint c = 0u; c < perSlab; c += 4u) {
            uint w = qbase + c * 64u;
            uint x = xbase + (c + sub) * TILE;
            float16_t d = w16[sbase + ((kt0 + c + sub) >> 1) * TILE];
            [[unroll]] for (uint u = 0u; u < 4u; u++) {
                uint word = w8[w + u];
                [[unroll]] for (uint t = 0u; t < 4u; t++) {
                    float wv = float(float16_t(bitfieldExtract(int(word), int(t * 8u), 8)) * d);
                    [[unroll]] for (uint r = 0u; r < MAXROWS; r++) {
                        if (r < ROWS) {
                            sum[r] += wv * float(hact[x + r * pc.lda + u * 4u + t]);
                        }
                    }
                }
            }
        }
    }
#else
    // One step is four tiles: 1024 halves of weight, 64 of activation.
    for (uint c = 0u; c < perSlab; c += 4u) {
        uint w = wbase + c * (TILE * TILE) + lane * TILE;
        uint x = xbase + (c + sub) * TILE;
        [[unroll]] for (uint i = 0u; i < TILE; i++) {
            float wv = float(w16[w + i]);
            [[unroll]] for (uint r = 0u; r < MAXROWS; r++) {
                if (r < ROWS) {
                    sum[r] += wv * float(hact[x + r * pc.lda + i]);
                }
            }
        }
    }
#endif

    // The four lanes holding the same column are lane, lane^16, lane^32.
    // The partials are row-major over the slab — [r][slab][n] — so MODE 1's
    // sum is contiguous for each row.
    [[unroll]] for (uint r = 0u; r < MAXROWS; r++) {
        if (r >= ROWS) {
            continue;
        }
        float v = sum[r];
        v += subgroupShuffleXor(v, 16u);
        v += subgroupShuffleXor(v, 32u);
        if (sub == 0u) {
            act[pc.gammaOff + (r * KSLABS + slab) * pc.gemmN + nt * TILE + col] = v;
        }
    }
#else
    // The reduction, and llm_gemm.comp MODE 0's epilogue over one row: the
    // gate's branch gets silu(x/hc) and is narrowed into the fp16 arena as
    // the up projection's A operand, inject's tile is written fp32 because
    // the combine reads it as a scalar per stream.
    uint n = gl_GlobalInvocationID.x;
    uint r = gl_WorkGroupID.y;                   // which row of A, P5b
    if (n >= pc.gemmN || r >= ROWS) {
        return;
    }
    float sum = 0.0;
    [[unroll]] for (uint s = 0u; s < KSLABS; s++) {
        sum += act[pc.gammaOff + (r * KSLABS + s) * pc.gemmN + n];
    }
    if (n < pc.lowRank) {
        float v = sum / float(pc.hc);
        hact[pc.loOff + r * pc.ldaLo + n] = float16_t(v * sigmoidf(v));
    } else {
        // `inject`'s row stride is the tile it rides, gemmN - lowRank, which
        // is what llm_gemm.comp MODE 0's epilogue writes and what the combine
        // reads (HCGPU.injStride).
        act[pc.injOff + r * (pc.gemmN - pc.lowRank) + (n - pc.lowRank)] = sum;
    }
#endif
}
