#version 450

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_integer_dot_product : enable

// y = W*x with 4-bit weights and int8 activations ("W4A8"), one subgroup
// per output row. This is IDEAS.md §1.1: Q4 reads the fewest weight bytes
// of any format here, but the existing PRECISION_Q4 path (gemv_subgroup.comp)
// unpacks one nibble at a time into a float multiply and only manages 73 of
// the 236 GB/s this chip can supply — 31% of its own bandwidth ceiling,
// i.e. ALU-bound on the unpack rather than bandwidth-bound. This kernel
// keeps the 0.5 bytes/weight and does the arithmetic the way gemv_w8a8.comp
// does: through dotPacked4x8EXT (RDNA's V_DOT4_I32_IU8), 4 int8 MACs per
// instruction.
//
// Three things make that possible:
//
// 1. **Weight layout.** quantizeQ4's interleaved layout (low nibble = even
//    element, high nibble = odd) would need the activations permuted to
//    match. Instead the weights are repacked *offline* (a one-time cost on
//    a real model's weights, see bench.repackQ4ToW4A8) so that one 32-bit
//    word holds 8 consecutive weights with the low nibbles of its 4 bytes
//    carrying elements n..n+3 and the high nibbles n+4..n+7. Masking then
//    yields two ready-made packed-int8 words that line up with two
//    consecutive words of a plainly-packed int8 activation vector — the
//    same x layout gemv_w8a8.comp already consumes.
//
// 2. **Mixed-signedness dot.** The nibbles are stored biased ([-8,7] held
//    as [0,15], matching quantizeQ4), and `x & 0x0F0F0F0F` cannot be
//    de-biased in place: subtracting 0x08080808 borrows across byte lanes.
//    So the unsigned nibbles are fed straight to the signed×unsigned
//    overload `dotPacked4x8EXT(int, uint)` and the bias is removed
//    afterwards, using the identity
//        sum (u_i - 8) x_i = sum u_i x_i - 8 * sum x_i
//    where `sum x_i` over each quantization block is the same for every
//    row. It is therefore precomputed once per GEMV (binding 4), and the
//    correction costs one short loop over blocksPerRow (64 iterations for
//    a 4096-wide row at block=64, spread over 64 lanes) instead of extra
//    instructions in the inner loop. This device reports
//    integerDotProduct4x8BitPackedMixedSignednessAccelerated, so the mixed
//    form is a hardware instruction, not an emulation.
//
// 3. **No integer division** (IDEAS.md §1.2). log2(block) is pushed
//    instead of block, so the block index of a load is a shift; every
//    other divisor (weights per load) is a compile-time power of two.
//
// VEC selects the load width: 1 = one uint (8 weights) per lane per step,
// 4 = one uvec4 (32 weights), 8 = two uvec4 (64), 16 = four uvec4 (128).
// This is IDEAS.md §1.3's "load" half — fewer, larger memory instructions
// for the same bytes — and past VEC=4 it is IDEAS §1.7. The
// quantity that turned out to matter is how much of one weight *row* a wave
// asks for in a single step: `WAVE * VEC * 4` bytes, against a row of
// `pc.N / 2`. When one step covers the whole row the kernel reads at the
// full DRAM bus; when it takes several steps it does not. So the right VEC
// for a given N is the one that makes those equal — VEC=4 at N=2048, 8 at
// N=4096, 16 at N=8192, all at wave64.
//
// Legal values are 1, 4, 8 and 16.

#ifndef VEC
#define VEC 1
#endif

// Weights consumed per lane per loop step. Compile-time, and a power of
// two, so `pc.N / WEIGHTS_PER_LOAD` is a shift.
#define WEIGHTS_PER_LOAD (8u * uint(VEC))
// uvec4s of weights, and of activations, per lane per loop step. Only the
// wide (VEC >= 4) path uses these.
#define WVEC4S (uint(VEC) / 4u)
#define XVEC4S (uint(VEC) / 2u)

// One subgroup = one output row, so WAVE must match the size the host pins
// the pipeline to with VK_EXT_subgroup_size_control (IDEAS §6.2); a mismatch
// would have subgroupAdd reduce half a row.
#ifndef WAVE
#define WAVE 64
#endif

// ROWS is how many subgroups — and therefore how many output rows — share a
// workgroup. The default 1 is the original kernel, where the workgroup *is*
// the subgroup. ROWS=2 was added for IDEAS §1.7: it restores a wave32
// pipeline to the 64 threads per workgroup (and half the workgroup count)
// that wave64 has, so that "half the lanes sweeping each row" can be
// separated from "twice as many workgroups in the grid" — the two things the
// wave size changes at once. It turned out to move nothing anywhere except
// the single cell where VEC is one step short of covering a row, and it is
// kept as the control that showed that. Requires REQUIRE_FULL_SUBGROUPS,
// which the host sets whenever it pins a size, so every subgroup here is full
// and takes the `row >= pc.M` branch together.
#ifndef ROWS
#define ROWS 1
#endif

// GROUPED is the MoE decode arm (IDEAS §3.5's "not done"): instead of one
// dispatch computing y = W*x for one matrix, one dispatch computes it for
// every (token, expert) pair a batch routes, reading each pair's weight-bank
// row, activation row and output row out of a table. The grid is
// two-dimensional — x is the output row inside an expert's matrix, y is the
// pair — so the pair index costs no division, and the row a lane addresses is
// a table lookup plus gl_WorkGroupID.x.
//
// It is the kernel §3.5 said decode needs and did not have. That file measured
// decode with the grouped *GEMM* at M=1, which is the same weights through a
// 16-row cooperative-matrix tile: the weight traffic is identical but 15 of
// every 16 rows of the A fragment — and of the FLOPs — are padding, and A's
// own traffic is multiplied by the same 16. A GEMV has no tile to pad.
//
// Two things the grouped form needs that the plain one does not:
//
//   - **A row stride.** The bank is [E*N, ldw] with ldw >= K nibbles, because
//     the stride is the thing IDEAS §5.1b's rule is about and the expert
//     shapes are where it bites: a 4-bit K=640 row is 320 B, gcd 64 with the
//     4 KB channel rotation, below the [128, 256] plateau. ldw must be a
//     multiple of 32 nibbles (16 B, one uvec4) and of the quantization block.
//   - **Per-row activations.** x is [rows, lda] int8 and the block sums are
//     [rows, N/block], so a pair reads its own token's vector. No gather pass
//     is needed — that pass exists in the GEMM path only because a coopmat A
//     fragment reads 16 *consecutive* rows, and a subgroup can read any row it
//     is told to.
#ifndef GROUPED
#define GROUPED 0
#endif
#if GROUPED && ROWS > 1
#error "GROUPED addresses one row per workgroup; ROWS > 1 is the non-grouped control"
#endif

// MROWS is the grouped arm's **M block**, and it is the thing IDEAS §1.8
// finding 2 measured the need for. That arm runs one workgroup grid per
// routed *pair*, so two tokens routed to the same expert read that expert's
// weights twice, where one cooperative-matrix tile amortizes them over 16-64
// rows. The crossover back to the GEMM measured at about **1.2 rows per
// expert** — far below the M=16 a tile holds, because the question is never
// "one row against sixteen" but "one row against sixteen rows of the *same*
// expert", which routing only supplies at batch.
//
// With MROWS > 1 one workgroup covers one weight row against MROWS activation
// rows: the group's MROWS table slots all name the same expert, the row's
// nibbles are loaded once per step instead of once per step per pair, and
// each slot carries its own int32 accumulator, its own activation-row base,
// its own block-sum base and its own output row. That is the whole change —
// the dot products, the scale application and the bias correction are the
// same instructions, run MROWS times against one load.
//
// A short group — an expert whose routed count is not a multiple of MROWS —
// is padded by the host with slots that repeat the last real pair's
// activation row and write to a scratch output row, so the inner loop needs
// no branch and a pad costs one cache-hot activation row plus one output row
// of writes. bench.buildMoEGroups builds the table; the pad is why its slot
// count and its pair count are reported separately.
//
// Legal values are 1, 2, 4 and 8, and MROWS > 1 requires GROUPED (there is
// nothing to block over without a table of rows).
#ifndef MROWS
#define MROWS 1
#endif
#if MROWS > 1 && !GROUPED
#error "MROWS is the grouped arm's M block and needs GROUPED=1"
#endif
layout(local_size_x = (WAVE * ROWS)) in;

// Which lane of which row this invocation is. Macros rather than locals
// because binding them to a variable reads the builtin a few instructions
// earlier, which changes nothing about the kernel but does change the
// SPIR-V; as macros, adding ROWS left every pre-existing binary
// byte-identical (`cmp`-verified at the time). The later VEC=16 work gave
// that up deliberately — the wide path became the macro below — so the
// VEC=1 and VEC=4 binaries are no longer the committed ones, and
// results/gemv{,_cold}.csv were regenerated against the current source.
#if ROWS > 1
#define LANE gl_SubgroupInvocationID
#define LANES gl_SubgroupSize
#else
#define LANE gl_LocalInvocationID.x
#define LANES gl_WorkGroupSize.x
#endif

#if VEC >= 4
layout(binding = 0) readonly buffer W { uvec4 w[]; };   // M x (N/32) uvec4
layout(binding = 2) readonly buffer X { uvec4 x[]; };   // N/16 uvec4
#else
layout(binding = 0) readonly buffer W { uint w[]; };    // M x (N/8) words
layout(binding = 2) readonly buffer X { uint x[]; };    // N/4 packed int8 words
#endif
layout(binding = 1) readonly buffer WScales { float16_t wScales[]; }; // M * (N/block)
layout(binding = 3) writeonly buffer Y { float y[]; };
layout(binding = 4) readonly buffer XBlockSums { int xBlockSums[]; };  // N/block
#if GROUPED
// One entry per routed (token, expert) pair: (row of the expert's first
// output row in the [E*N, ldw] bank, activation row, output row).
layout(binding = 5) readonly buffer Groups { uvec4 groups[]; };
#endif

layout(push_constant) uniform PC {
    uint M;
    uint N;
    uint logBlock; // log2 of the quantization block size along N; block >= WEIGHTS_PER_LOAD
    float xScale;
#if GROUPED
    uint ldw;       // weight-bank row stride in *elements* (nibbles); >= N
    uint lda;       // activation row stride in int8 elements; >= N
    uint groupBase; // first table entry this dispatch covers
#endif
} pc;

// One uvec4 of weights (32 of them) against the two uvec4 of activations
// that line up with it, accumulated into `acc`. Instantiated once per group
// by the step body rather than written as a `for (g < WVEC4S)` loop, because
// glslc's -O leaves a loop like that rolled and a rolled group loop has to
// index the operands dynamically — which spills them to scratch, the one
// thing a load-width arm must not do. Reads `w`, `x`, `wbase`, `xbase` and
// `acc` from the scope it is used in.
#define W4A8_GROUP(G)                                                          \
    {                                                                          \
        uvec4 pk = w[wbase + (G)];                                             \
        uvec4 xa = x[xbase + 2u * (G)];                                        \
        uvec4 xb = x[xbase + 2u * (G) + 1u];                                   \
        acc = dotPacked4x8AccSatEXT(int(xa.x), pk.x & 0x0F0F0F0Fu, acc);       \
        acc = dotPacked4x8AccSatEXT(int(xa.y), (pk.x >> 4u) & 0x0F0F0F0Fu, acc); \
        acc = dotPacked4x8AccSatEXT(int(xa.z), pk.y & 0x0F0F0F0Fu, acc);       \
        acc = dotPacked4x8AccSatEXT(int(xa.w), (pk.y >> 4u) & 0x0F0F0F0Fu, acc); \
        acc = dotPacked4x8AccSatEXT(int(xb.x), pk.z & 0x0F0F0F0Fu, acc);       \
        acc = dotPacked4x8AccSatEXT(int(xb.y), (pk.z >> 4u) & 0x0F0F0F0Fu, acc); \
        acc = dotPacked4x8AccSatEXT(int(xb.z), pk.w & 0x0F0F0F0Fu, acc);       \
        acc = dotPacked4x8AccSatEXT(int(xb.w), (pk.w >> 4u) & 0x0F0F0F0Fu, acc); \
    }

#if MROWS > 1
// The M-blocked step, split where W4A8_GROUP is not. W4A8_GROUP loads the
// weights *and* the activations it dots them with, which is right when one
// load serves one output; here one load serves MROWS of them, so the load is
// hoisted into M_LOAD_W and M_DOTS does one slot's eight
// dotPacked4x8AccSatEXT per uvec4 against weights that are already in
// registers. Same instructions per (weight, activation) pair as the
// unblocked kernel; what changes is how many times each weight load is used.
//
// M_LOAD_W and M_DOTS are written out per VEC rather than as a loop over
// WVEC4S for the reason in W4A8_GROUP's comment: a rolled group loop has to
// index its operands dynamically and spills them to scratch.
#if VEC >= 4
#define W4A8_ROW(PK, XB, ACC)                                                  \
    {                                                                          \
        uvec4 xa = x[(XB)];                                                    \
        uvec4 xb = x[(XB) + 1u];                                               \
        ACC = dotPacked4x8AccSatEXT(int(xa.x), (PK).x & 0x0F0F0F0Fu, ACC);     \
        ACC = dotPacked4x8AccSatEXT(int(xa.y), ((PK).x >> 4u) & 0x0F0F0F0Fu, ACC); \
        ACC = dotPacked4x8AccSatEXT(int(xa.z), (PK).y & 0x0F0F0F0Fu, ACC);     \
        ACC = dotPacked4x8AccSatEXT(int(xa.w), ((PK).y >> 4u) & 0x0F0F0F0Fu, ACC); \
        ACC = dotPacked4x8AccSatEXT(int(xb.x), (PK).z & 0x0F0F0F0Fu, ACC);     \
        ACC = dotPacked4x8AccSatEXT(int(xb.y), ((PK).z >> 4u) & 0x0F0F0F0Fu, ACC); \
        ACC = dotPacked4x8AccSatEXT(int(xb.z), (PK).w & 0x0F0F0F0Fu, ACC);     \
        ACC = dotPacked4x8AccSatEXT(int(xb.w), ((PK).w >> 4u) & 0x0F0F0F0Fu, ACC); \
    }
// Where a slot's activation row starts, and how far one lane-step advances
// inside it, in the units the buffer is declared with.
#define M_XBASE(AROW) ((AROW) * (pc.lda >> 4u))
#define M_XSTEP XVEC4S
#else
#define W4A8_ROW(PK, XB, ACC)                                                  \
    {                                                                          \
        ACC = dotPacked4x8AccSatEXT(int(x[(XB)]), (PK) & 0x0F0F0F0Fu, ACC);    \
        ACC = dotPacked4x8AccSatEXT(int(x[(XB) + 1u]), ((PK) >> 4u) & 0x0F0F0F0Fu, ACC); \
    }
#define M_XBASE(AROW) ((AROW) * (pc.lda >> 2u))
#define M_XSTEP 2u
#endif

#if VEC == 16
#define M_LOAD_W                                                               \
    uvec4 pk0 = w[wbase];                                                      \
    uvec4 pk1 = w[wbase + 1u];                                                 \
    uvec4 pk2 = w[wbase + 2u];                                                 \
    uvec4 pk3 = w[wbase + 3u];
#define M_DOTS(XB, ACC)                                                        \
    W4A8_ROW(pk0, (XB), ACC)                                                   \
    W4A8_ROW(pk1, (XB) + 2u, ACC)                                              \
    W4A8_ROW(pk2, (XB) + 4u, ACC)                                              \
    W4A8_ROW(pk3, (XB) + 6u, ACC)
#elif VEC == 8
#define M_LOAD_W                                                               \
    uvec4 pk0 = w[wbase];                                                      \
    uvec4 pk1 = w[wbase + 1u];
#define M_DOTS(XB, ACC)                                                        \
    W4A8_ROW(pk0, (XB), ACC)                                                   \
    W4A8_ROW(pk1, (XB) + 2u, ACC)
#elif VEC == 4
#define M_LOAD_W uvec4 pk0 = w[wbase];
#define M_DOTS(XB, ACC) W4A8_ROW(pk0, (XB), ACC)
#else
#define M_LOAD_W uint pk0 = w[wbase];
#define M_DOTS(XB, ACC) W4A8_ROW(pk0, (XB), ACC)
#endif

// The four places a slot appears in the kernel. Each takes the same five
// arguments — its index in the group and the four names its state lives
// under — so that one M_ROWS(SITE) line instantiates a site for every slot,
// and adding an MROWS value means adding one M_ROWn rather than editing four
// unrolled blocks. M_STEP reads `j`, `sc` and the loaded weights from the
// loop it sits in, M_BIAS reads `b` and `ws`, and M_WRITE reads `row`, the
// way W4A8_GROUP already reads `wbase`.
#define M_SLOT(I, XR, OROW, SUMB, PART)                                        \
    uint XR = M_XBASE(groups[slot + (I)].y);                                   \
    uint SUMB = groups[slot + (I)].y * blocksPerRow;                           \
    uint OROW = groups[slot + (I)].z;                                          \
    float PART = 0.0;
#define M_STEP(I, XR, OROW, SUMB, PART)                                        \
    {                                                                          \
        int acc = 0;                                                           \
        M_DOTS((XR) + M_XSTEP * j, acc)                                        \
        PART += float(acc) * sc;                                               \
    }
#define M_BIAS(I, XR, OROW, SUMB, PART)                                        \
    PART -= ws * float(xBlockSums[(SUMB) + b]);
#define M_WRITE(I, XR, OROW, SUMB, PART)                                       \
    {                                                                          \
        float total = subgroupAdd(PART);                                       \
        if (subgroupElect()) {                                                 \
            y[(OROW) * pc.M + row] = total * pc.xScale;                        \
        }                                                                      \
    }

#define M_ROW0(SITE) SITE(0u, xrow0, orow0, sum0, part0)
#if MROWS >= 2
#define M_ROW1(SITE) SITE(1u, xrow1, orow1, sum1, part1)
#else
#define M_ROW1(SITE)
#endif
#if MROWS >= 3
#define M_ROW2(SITE) SITE(2u, xrow2, orow2, sum2, part2)
#else
#define M_ROW2(SITE)
#endif
#if MROWS >= 4
#define M_ROW3(SITE) SITE(3u, xrow3, orow3, sum3, part3)
#else
#define M_ROW3(SITE)
#endif
#if MROWS >= 5
#define M_ROW4(SITE) SITE(4u, xrow4, orow4, sum4, part4)
#else
#define M_ROW4(SITE)
#endif
#if MROWS >= 6
#define M_ROW5(SITE) SITE(5u, xrow5, orow5, sum5, part5)
#else
#define M_ROW5(SITE)
#endif
#if MROWS >= 7
#define M_ROW6(SITE) SITE(6u, xrow6, orow6, sum6, part6)
#else
#define M_ROW6(SITE)
#endif
#if MROWS >= 8
#define M_ROW7(SITE) SITE(7u, xrow7, orow7, sum7, part7)
#else
#define M_ROW7(SITE)
#endif
#define M_ROWS(SITE)                                                           \
    M_ROW0(SITE) M_ROW1(SITE) M_ROW2(SITE) M_ROW3(SITE)                        \
    M_ROW4(SITE) M_ROW5(SITE) M_ROW6(SITE) M_ROW7(SITE)

void main() {
    // One workgroup is one weight row of one expert against MROWS activation
    // rows. Every slot of a group names the same expert — the host guarantees
    // it — so the bank row comes from the first slot and the others contribute
    // only their token and output rows.
    uint slot = pc.groupBase + gl_WorkGroupID.y * uint(MROWS);
    uint row = gl_WorkGroupID.x;
    uint wrow = groups[slot].x + row;
    if (row >= pc.M) {
        return;
    }
    uint loadsPerRow = pc.N / WEIGHTS_PER_LOAD;
    uint blocksPerRow = pc.N >> pc.logBlock;
    uint scaleBase = wrow * (pc.ldw >> pc.logBlock);
    M_ROWS(M_SLOT)

    for (uint j = LANE; j < loadsPerRow; j += LANES) {
#if VEC >= 4
        uint wbase = wrow * (pc.ldw >> 5u) + WVEC4S * j;
#else
        uint wbase = wrow * (pc.ldw >> 3u) + j;
#endif
        M_LOAD_W
        // One scale for the whole step, as in the unblocked kernel, and one
        // for every slot: the weights are shared, so the scale is too.
        float sc = float(wScales[scaleBase + ((j * WEIGHTS_PER_LOAD) >> pc.logBlock)]);
        M_ROWS(M_STEP)
    }

    // The +8 bias, per slot: the weight scale is shared and the block sum is
    // the slot's own, so the shared half is hoisted out of the instantiation.
    for (uint b = LANE; b < blocksPerRow; b += LANES) {
        float ws = 8.0 * float(wScales[scaleBase + b]);
        M_ROWS(M_BIAS)
    }

    M_ROWS(M_WRITE)
}
#else

void main() {
#if GROUPED
    uvec4 grp = groups[pc.groupBase + gl_WorkGroupID.y];
    uint row = gl_WorkGroupID.x;   // output row inside this expert's matrix
    uint wrow = grp.x + row;       // its row in the [E*N, ldw] bank
    uint arow = grp.y;             // the token row this pair reads
    uint orow = grp.z;             // the pair's row in y
#elif ROWS > 1
    uint row = gl_WorkGroupID.x * uint(ROWS) + gl_SubgroupID;
#else
    uint row = gl_WorkGroupID.x;
#endif
    if (row >= pc.M) {
        return;
    }
    uint loadsPerRow = pc.N / WEIGHTS_PER_LOAD;
    uint blocksPerRow = pc.N >> pc.logBlock;
#if GROUPED
    // The scale plane follows the bank's stride, so a padded row carries the
    // scales its own nibbles would have had.
    uint scaleBase = wrow * (pc.ldw >> pc.logBlock);
    uint sumBase = arow * blocksPerRow;
#else
    uint scaleBase = row * blocksPerRow;
#endif

    float partial = 0.0;
    for (uint j = LANE; j < loadsPerRow; j += LANES) {
        // A whole step's worth of weights sits inside one quantization block
        // (block >= WEIGHTS_PER_LOAD is required), so a single int32
        // accumulator holds the step and the fp16 scale is applied once per
        // step rather than once per weight.
        int acc = 0;
#if VEC == 1
#if GROUPED
        uint packed = w[wrow * (pc.ldw >> 3u) + j];
        acc = dotPacked4x8AccSatEXT(int(x[arow * (pc.lda >> 2u) + 2u * j]), packed & 0x0F0F0F0Fu, acc);
        acc = dotPacked4x8AccSatEXT(int(x[arow * (pc.lda >> 2u) + 2u * j + 1u]), (packed >> 4u) & 0x0F0F0F0Fu, acc);
#else
        uint packed = w[row * loadsPerRow + j];
        // Low nibbles hold elements n..n+3, high nibbles n+4..n+7 — exactly
        // the two consecutive activation words.
        acc = dotPacked4x8AccSatEXT(int(x[2u * j]), packed & 0x0F0F0F0Fu, acc);
        acc = dotPacked4x8AccSatEXT(int(x[2u * j + 1u]), (packed >> 4u) & 0x0F0F0F0Fu, acc);
#endif
#else
#if GROUPED
        // ldw is a multiple of 32 nibbles, so a row is a whole number of
        // uvec4s and the row base needs no rounding.
        uint wbase = wrow * (pc.ldw >> 5u) + WVEC4S * j;
        uint xbase = arow * (pc.lda >> 4u) + XVEC4S * j;
#else
        uint wbase = WVEC4S * (row * loadsPerRow + j);
        uint xbase = XVEC4S * j;
#endif
        W4A8_GROUP(0u)
#if VEC >= 8
        W4A8_GROUP(1u)
#endif
#if VEC >= 16
        W4A8_GROUP(2u)
        W4A8_GROUP(3u)
#endif
#endif
        uint blockIdx = (j * WEIGHTS_PER_LOAD) >> pc.logBlock;
        partial += float(acc) * float(wScales[scaleBase + blockIdx]);
    }

    // Remove the +8 bias the packed nibbles carry: one term per block, and
    // blocksPerRow is far smaller than loadsPerRow, so this loop is noise
    // next to the one above.
    for (uint b = LANE; b < blocksPerRow; b += LANES) {
#if GROUPED
        partial -= 8.0 * float(wScales[scaleBase + b]) * float(xBlockSums[sumBase + b]);
#else
        partial -= 8.0 * float(wScales[scaleBase + b]) * float(xBlockSums[b]);
#endif
    }

    float total = subgroupAdd(partial);
    if (subgroupElect()) {
#if GROUPED
        y[orow * pc.M + row] = total * pc.xScale;
#else
        y[row] = total * pc.xScale;
#endif
    }
}
#endif
