#version 450

// RMSNorm over one row of N elements per workgroup: y = x / rms(x) * weight.
// Reduction (sum of squares) via a shared-memory tree.
layout(local_size_x = 256) in;

layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) readonly buffer Weight { float weight[]; };
layout(binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform PC {
    uint rows;
    uint n;
    float eps;
} pc;

shared float partials[256];

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.rows) {
        return;
    }
    uint base = row * pc.n;
    uint tid = gl_LocalInvocationID.x;

    float sumSq = 0.0;
    for (uint i = tid; i < pc.n; i += gl_WorkGroupSize.x) {
        float v = x[base + i];
        sumSq += v * v;
    }
    partials[tid] = sumSq;
    barrier();

    for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            partials[tid] += partials[tid + stride];
        }
        barrier();
    }

    float rms = sqrt(partials[0] / float(pc.n) + pc.eps);
    for (uint i = tid; i < pc.n; i += gl_WorkGroupSize.x) {
        y[base + i] = (x[base + i] / rms) * weight[i];
    }
}
