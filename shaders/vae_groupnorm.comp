#version 450
// GroupNorm over (C/groups, H, W), then a per-channel scale and shift.
//
// One workgroup per group, doing the whole thing in one dispatch: reduce for
// the mean, reduce again for the variance *about that mean*, then normalise.
// Three passes over the data instead of one, and deliberately so -- the
// single-pass E[x^2]-E[x]^2 form cancels catastrophically here, where a group
// can hold 262144 values whose mean is far from zero. There is no fp64 in
// this shader, so the algorithm has to supply the conditioning instead.
//
// Each thread also accumulates its own partial before the tree reduction, so
// a group's sum is a tree over 256 partials rather than a serial chain.

#include "vae_common.glsl"

layout(local_size_x = 256) in;

shared float partial[256];

float reduceSum(float v) {
    uint t = gl_LocalInvocationID.x;
    partial[t] = v;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (t < s) {
            partial[t] += partial[t + s];
        }
        barrier();
    }
    float total = partial[0];
    barrier();     // keep partial[0] alive until every thread has read it
    return total;
}

void main() {
    uint g = gl_WorkGroupID.x;
    uint t = gl_LocalInvocationID.x;
    uint perGroup = pc.C / pc.groups;
    uint hw = pc.H * pc.W;
    uint count = perGroup * hw;
    uint base = pc.inOff + g * perGroup * hw;

    float s = 0.0;
    for (uint i = t; i < count; i += 256u) {
        s += act[base + i];
    }
    float mean = reduceSum(s) / float(count);

    float v = 0.0;
    for (uint i = t; i < count; i += 256u) {
        float d = act[base + i] - mean;
        v += d * d;
    }
    float variance = reduceSum(v) / float(count);
    float inv = inversesqrt(variance + uintBitsToFloat(pc.aux0));

    uint outBase = pc.outOff + g * perGroup * hw;
    for (uint i = t; i < count; i += 256u) {
        uint c = g * perGroup + i / hw;
        float scale = wbuf[pc.wOff + c] * inv;
        float shift = wbuf[pc.bOff + c] - mean * scale;
        act[outBase + i] = act[base + i] * scale + shift;
    }
}
