#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

// MiniMax-H3's attention, transposed: dit_attention_wmma.comp's flash
// structure with every product turned around, so that P never goes through
// LDS (VIDEO.md M11c).
//
// Why. Gutting the plain kernel a phase at a time on H3's own planes (480p,
// 15,936 keys, QT1 KTIL4) prices it: the row max costs nothing (288 ms with
// and without it), the exp2 costs nothing, and the round trip that turns P
// from an accumulator back into an A operand -- a coopMatStore into LDS, a
// barrier, KTIL coopMatLoads -- is 177 of the 288 ms. The extension offers no
// other way from an accumulator to an operand. But the element order this
// device gives is fixed and simple (h3/dit's TestCoopMatLayout pins it, at
// wave32):
//
//   A:            lane l holds row l%16, element e column e
//   B:            lane l holds column l%16, element e row e
//   accumulator:  lane l holds column l%16, element e row 2e + l/16
//
// So an accumulator's column and a B operand's column are the same lane,
// and the only thing between them is that the accumulator splits a column's
// sixteen rows between lanes l and l^16, even rows in the first half-wave,
// odd in the second, where B wants all sixteen in both: one
// subgroupShuffleXor(16) an element pair. Turning the whole computation
// around puts the queries on the columns:
//
//     S^T = K . Q^T      [keys, headDim] x [headDim, queries]
//     O^T += V^T . P^T   [headDim, keys] x [keys, queries]
//
// and then a lane owns one query of a tile outright. The row max is a max
// over its own eight scores a key tile and one shuffle; the online
// correction and the final 1/sum are scalars a lane multiplies its own
// elements by; the row sum is a scalar a lane accumulates. No LDS at all,
// and no barrier.
//
// The memory reads are the plain kernel's, byte for byte: a packed q/k tile
// is 16 tokens by 16 components row-major, which is K as a row-major A and
// Q^T as a column-major B; the packed v tile is already components by
// tokens, which is V^T as a row-major A. The context goes out as O^T stored
// column-major, which is O row-major at the output projection's stride.
//
// Numerics are the plain kernel's in kind -- fp16 operands, fp32
// accumulators, scores in log2 units (the pack folds the scale into q), P
// narrowed to fp16 -- but not bit for bit: the denominator here sums the
// fp16-narrowed weights in fp32 registers rather than through a ones column
// on the matrix cores, and the key tail is masked out of the max as well as
// out of P (the plain build lets a pad key's 0 into the max, which is right
// but costs precision on a row whose real scores are all negative).
//
// Plain bidirectional attention only, fp16 context out (OUT_F16's contract).

#include "dit_common.glsl"

layout(binding = 2) buffer HAct { float16_t hact[]; };

#ifndef QT
#define QT 1        // query tiles a wave
#endif
#ifndef KTIL
#define KTIL 4      // key tiles a block
#endif
#define WAVE 32     // the element order above is wave32's; host pins it
#ifndef HEAD_DIM
#define HEAD_DIM 128
#endif
// QREG=1 holds Q^T in registers across the key loop, as the plain kernel
// does; 0 reads its fragments again every key block (from cache: a
// workgroup's Q is QT*4 KB), which frees QT*HDT*8 VGPRs for the rest.
#ifndef QREG
#define QREG 1
#endif

// STORE_TAIL=0 skips a query tile that starts past the sequence, and stores
// the tile the sequence ends inside one query at a time, bounded: for
// callers whose rows past the count belong to someone else -- the video
// VAE's tile-clips side by side at a 16-row stride (at QT > 1 the last
// workgroup's later tiles are the next sequence's first rows, and writing
// them would race its own dispatch), and the image DiT's prefix repair,
// which runs this kernel with the key count cut to a segment's end over
// rows the next segment's pass has already finished (KERNELS.md G4). A
// lane owns one query of a tile, so the bounded store is its own eight
// elements a tile or nothing; the whole-tile path is untouched.
#ifndef STORE_TAIL
#define STORE_TAIL 1
#endif

// KERNELS.md G4 (research/3.8): the key loop's knobs. TAIL_SPLIT=1 peels the
// last (short) key block out of the loop, so the whole blocks carry no tail
// arithmetic; QLDS=1 keeps Q^T in LDS at a pitch of Q_LPITCH halves instead
// of in registers (which the compiler spills at QT2 KTIL4). Both are
// bit-identical to the plain loop. GUT_* are screening arms that are wrong
// by construction, each with its result kept live: GUT_CORR skips the online
// rescale of O^T, GUT_EXP the exp2, GUT_MAX the row max, GUT_SOFTMAX all of
// the softmax (P^T = S^T narrowed), GUT_XCHG the half-wave exchange too.
#ifndef TAIL_SPLIT
#define TAIL_SPLIT 0
#endif
#ifndef QLDS
#define QLDS 0
#endif
#ifndef Q_LPITCH
#define Q_LPITCH 16     // halves; a tile is 16 columns of this pitch
#endif
#define Q_LTILE (TILE * Q_LPITCH / 2)   // uints a tile
// MAX_TREE=1 takes the row max as a balanced tree (exact); LAZY=1 skips the
// online rescale when no lane's max moved (exact: corr is 1); PV_ORDER=1
// builds P^T a key tile at a time with its MMAs right behind it (the same
// MMAs per accumulator in the same order).
#ifndef MAX_TREE
#define MAX_TREE 0
#endif
#ifndef LAZY
#define LAZY 0
#endif
#ifndef PV_ORDER
#define PV_ORDER 0
#endif
#ifndef L0_LOADS
#define L0_LOADS 0
#endif
#ifndef GUT_CORR
#define GUT_CORR 0
#endif
#ifndef GUT_EXP
#define GUT_EXP 0
#endif
#ifndef GUT_MAX
#define GUT_MAX 0
#endif
#ifndef GUT_SOFTMAX
#define GUT_SOFTMAX 0
#endif
#ifndef GUT_XCHG
#define GUT_XCHG 0
#endif

#define TILE 16
#define HDT (HEAD_DIM / TILE)
#define BM (QT * TILE)
#define BN (KTIL * TILE)

layout(local_size_x = WAVE) in;

#if QLDS
shared uint qs[QT * HDT * Q_LTILE];
#endif

#define ACC  coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define ACCH coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define FRAG_A coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA>
#define FRAG_B coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB>

void main() {
    uint head = gl_WorkGroupID.y;
    uint q0 = gl_WorkGroupID.x * BM;
    uint n = pc.tokens;
    uint lane = gl_SubgroupInvocationID;
    if (q0 >= n || head >= pc.heads) {
        return;
    }
    // This lane's rows of an accumulator are 2e + hw.
    uint hw = lane / 16u;

    uint plane = head * (pc.aux1 / TILE) * (HDT * TILE * TILE);
    uint qBase = pc.inOff + plane + (q0 / TILE) * (HDT * TILE * TILE);
    uint kBase = pc.kOff + plane;
    uint vBase = pc.vOff + plane;

#if QLDS
    // Q^T stays in this wave's LDS for the whole sequence.
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        [[unroll]] for (uint kt = 0u; kt < HDT; ++kt) {
            FRAG_B f;
            coopMatLoad(f, hact, qBase + (qq * HDT + kt) * (TILE * TILE),
                TILE, gl_CooperativeMatrixLayoutColumnMajor);
            coopMatStore(f, qs, (qq * HDT + kt) * Q_LTILE, Q_LPITCH / 2u,
                gl_CooperativeMatrixLayoutColumnMajor);
        }
    }
    subgroupMemoryBarrierShared();
#elif QREG
    // Q^T stays in registers for the whole sequence.
    FRAG_B fragQ[QT][HDT];
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        [[unroll]] for (uint kt = 0u; kt < HDT; ++kt) {
            coopMatLoad(fragQ[qq][kt], hact, qBase + (qq * HDT + kt) * (TILE * TILE),
                TILE, gl_CooperativeMatrixLayoutColumnMajor);
        }
    }
#endif

    ACC o[QT][HDT];         // O^T: rows are head components, columns queries
    float runMax[QT];       // this lane's query's running max, a tile each
    float runSum[QT];       // and its share of the denominator (its half-wave's keys)
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        [[unroll]] for (uint j = 0u; j < HDT; ++j) {
            o[qq][j] = ACC(0.0);
        }
        runMax[qq] = -1.0 / 0.0;
        runSum[qq] = 0.0;
    }

#if TAIL_SPLIT
    uint base = 0u;
    for (; base + BN <= n; base += BN) {
        const uint cnt = BN;
#define MASKED 0
#include "h3_attn_t_block.glsl"
#undef MASKED
    }
    if (base < n) {
        uint cnt = n - base;
#define MASKED 1
#include "h3_attn_t_block.glsl"
#undef MASKED
    }
#else
    for (uint base = 0u; base < n; base += BN) {
        uint cnt = min(BN, n - base);
#define MASKED 1
#include "h3_attn_t_block.glsl"
#undef MASKED
    }
#endif

    // ---- Epilogue: the two halves' sums make the denominator; O^T goes out
    // column-major, which is O row-major at the output projection's stride.
    // The rows past the sequence are written too, as the plain build does:
    // they are the A operand's pad rows, which nothing reads.
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
#if !STORE_TAIL
        if (q0 + qq * TILE >= n) {
            break;
        }
#endif
        float inv = 1.0 / (runSum[qq] + subgroupShuffleXor(runSum[qq], 16u));
#if !STORE_TAIL
        if (q0 + qq * TILE + TILE > n) {
            // The tile the sequence ends inside: this lane's query is
            // column lane%16, its elements rows 2e + hw of O^T.
            uint q = q0 + qq * TILE + (lane % 16u);
            if (q < n) {
                uint dst = pc.outOff + q * pc.lda + head * HEAD_DIM;
                [[unroll]] for (uint j = 0u; j < HDT; ++j) {
                    [[unroll]] for (uint e = 0u; e < 8u; ++e) {
                        hact[dst + j * TILE + 2u * e + hw] = float16_t(o[qq][j][e] * inv);
                    }
                }
            }
            continue;
        }
#endif
        [[unroll]] for (uint j = 0u; j < HDT; ++j) {
            ACC r = o[qq][j];
            [[unroll]] for (uint e = 0u; e < 8u; ++e) {
                r[e] *= inv;
            }
            coopMatStore(ACCH(r), hact,
                pc.outOff + (q0 + qq * TILE) * pc.lda + head * HEAD_DIM + j * TILE,
                pc.lda, gl_CooperativeMatrixLayoutColumnMajor);
        }
    }
}
