#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

// Flash attention on the matrix cores for the VAE mid block: one head, 512
// wide, over every pixel of the image. At a 1024x1024 image that is 16384
// rows of 512, and the scalar kernel it replaces (vae_attention.comp) is
// **1.42 s in one dispatch, 26% of the whole decode**.
//
// Why it is not shaders/dit_attention_wmma.comp with -DHEAD_DIM=512. That
// kernel is one wave per workgroup and keeps the whole output tile in
// accumulators: HEAD_DIM/16 of them per query tile, which at 128 is 8 and at
// 512 is 32. Built at 512 it asks for 424 VGPRs against a 256-register file
// and spills 170 of them into 30 KB of scratch. The head dimension here is
// four times the DiT's and the same shape will not stretch to it.
//
// So the *workgroup* owns the head instead of the wave: WAVES waves, wave w
// owning component tiles [w*DW, (w+1)*DW) of the 512. That splits both
// matmuls along the axis that keeps each wave's register file small, and it
// splits them in opposite directions:
//
//   S = Q.K^T reduces over the component axis, so each wave computes a
//     *partial* S over its own tiles and the workgroup sums the WAVES
//     partials in LDS. No wave repeats another's work.
//   O += P.V reduces over the key axis and is indexed by the component, so
//     each wave owns DW output tiles outright and never sees the others.
//
// The cross-wave sum is what this kernel buys the LDS for, and having paid
// for it the softmax is done scalar in LDS as well -- the row max, the
// exponential and the row sum -- rather than through the DiT kernel's
// row-constant-matrix trick. S is already in LDS and the reductions are
// 16-lane clustered subgroup ops over it, which is both simpler and one
// barrier cheaper than staging score tiles back out of accumulators. The one
// piece of that trick still here is the rescale of O between key blocks:
// O lives in accumulators, a per-row scale is not a scalar, and a matrix
// whose every row is constant multiplies it componentwise.
//
// Numerics. fp16 operands, fp32 accumulators -- the only combination this
// device's matrix cores implement, and the one the VAE needs: stage 2
// measured this model's scores at **1.16e7**, 177x past fp16's range, with a
// softmax that is a hard one-hot. The running max is folded in before every
// exponential, exactly as the scalar kernel does, and P is bounded by 1 by
// construction so narrowing it costs 5e-4 and cannot overflow. The activation
// operands themselves peak at 497 and are comfortably inside fp16.
//
// pc.inOff / pc.resOff / pc.aux2 are the packed q, k and v (see
// vae_pack_f16.comp; q carries 1/sqrt(dim) * log2(e) so the exponential is
// exp2), pc.outOff the fp32 context, pc.aux0 the row count. The packed planes
// are padded to a multiple of BN and zeroed, so the key loop reads whole
// blocks.

#include "vae_common.glsl"

layout(binding = 2) readonly buffer HAct { float16_t hact[]; };

#ifndef DIM
#define DIM 512     // the head dimension, which here is the channel count
#endif
#ifndef QT
#define QT 1        // query tiles per workgroup
#endif
#ifndef KTIL
#define KTIL 4      // key tiles per block
#endif
#ifndef WAVES
#define WAVES 4     // waves per workgroup; they split the component axis
#endif
#ifndef WAVE
#define WAVE 64     // threads per wave; the host pins this
#endif
// The negative controls (zimage/vae/gpu_test.go). NO_CROSS_WAVE drops every
// wave's partial score but its own, which is this kernel's one structurally
// new step; NO_RESCALE drops the online-softmax correction, which is what
// makes a running max legal.
#ifndef NO_CROSS_WAVE
#define NO_CROSS_WAVE 0
#endif
#ifndef NO_RESCALE
#define NO_RESCALE 0
#endif

#define TILE 16
#define DT (DIM / TILE)             // component tiles in the head
#define DW (DT / WAVES)             // component tiles per wave
#define BM (QT * TILE)              // query rows per workgroup
#define BN (KTIL * TILE)            // keys per block
#define NTHREADS (WAVES * WAVE)
#define CPR 16                      // threads per row in the scalar softmax
#define RPT ((BM * CPR + NTHREADS - 1) / NTHREADS)   // rows each thread owns

layout(local_size_x = NTHREADS) in;

#define ACC    coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define FRAG_A coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA>
#define FRAG_B coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB>

// The per-wave partial scores, summed in place into region 0.
shared float spart[WAVES * BM * BN];
// P, fp16, as the A operand of P.V -- row-major, leading dimension BN.
shared float16_t pbuf[BM * BN];
// The row-constant matrix that rescales O across key blocks.
shared float bcorr[QT * TILE * TILE];
// One 16x16 staging tile per wave, for the epilogue's stores.
shared float stage[WAVES * QT * TILE * TILE];
// The softmax denominators, written once at the end and read by every wave.
shared float rowSum[BM];

void main() {
    uint w = gl_SubgroupID;
    uint tid = gl_LocalInvocationID.x;
    uint lane = tid % WAVE;
    uint q0 = gl_WorkGroupID.x * BM;
    uint n = pc.aux0;
    if (q0 >= n) {
        return;                 // uniform over the workgroup
    }

    // Q stays in registers for the whole sequence: DW fragments per query
    // tile, 2 VGPRs each, against the DW accumulators they feed.
    FRAG_A fragQ[QT][DW];
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        [[unroll]] for (uint c = 0u; c < DW; ++c) {
            coopMatLoad(fragQ[qq][c], hact,
                pc.inOff + ((q0 / TILE + qq) * DT + w * DW + c) * (TILE * TILE),
                TILE, gl_CooperativeMatrixLayoutRowMajor);
        }
    }

    ACC o[QT][DW];
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        [[unroll]] for (uint j = 0u; j < DW; ++j) {
            o[qq][j] = ACC(0.0);
        }
    }
    // The running max and denominator per row. Which rows a thread owns does
    // not change between key blocks, so both live in registers and only the
    // denominator is written out, once, at the end.
    float rowMax[RPT], rowDen[RPT];
    [[unroll]] for (uint e = 0u; e < RPT; ++e) {
        rowMax[e] = -1.0 / 0.0;
        rowDen[e] = 0.0;
    }
    uint tc = tid % CPR;
    uint r0 = tid / CPR;

    for (uint base = 0u; base < n; base += BN) {
        uint cnt = min(BN, n - base);

        // ---- The partial S over this wave's component tiles. K is the B
        // operand and already component-contiguous inside a tile, so it is
        // read straight out of the packed layout.
        ACC s[QT][KTIL];
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                s[qq][kk] = ACC(0.0);
            }
        }
        [[unroll]] for (uint c = 0u; c < DW; ++c) {
            FRAG_B fragK[KTIL];
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatLoad(fragK[kk], hact,
                    pc.resOff + ((base / TILE + kk) * DT + w * DW + c) * (TILE * TILE),
                    TILE, gl_CooperativeMatrixLayoutColumnMajor);
            }
            [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
                [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                    s[qq][kk] = coopMatMulAdd(fragQ[qq][c], fragK[kk], s[qq][kk]);
                }
            }
        }
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatStore(s[qq][kk], spart, w * (BM * BN) + qq * (TILE * BN) + kk * TILE,
                    BN, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        barrier();

        // ---- The softmax, scalar, 16 lanes to a row. One pass sums the
        // partials and takes the block's row max; the clustered reduction
        // that follows is why the lanes of a row are consecutive. The second
        // pass exponentiates out of registers, so S is read from LDS once.
        [[unroll]] for (uint e = 0u; e < RPT; ++e) {
            uint r = r0 + e * (NTHREADS / CPR);
            if (r >= BM) {
                break;
            }
            float v[BN / CPR];
            float mx = -1.0 / 0.0;
            [[unroll]] for (uint i = 0u; i < BN / CPR; ++i) {
                uint c = i * CPR + tc;
                float acc = spart[r * BN + c];
#if !NO_CROSS_WAVE
                [[unroll]] for (uint ww = 1u; ww < WAVES; ++ww) {
                    acc += spart[ww * (BM * BN) + r * BN + c];
                }
#endif
                v[i] = acc;
                if (c < cnt) {
                    mx = max(mx, acc);
                }
            }
            mx = subgroupClusteredMax(mx, CPR);

            float mo = rowMax[e];
            float mn = max(mo, mx);
            // exp2(-inf - m) is 0, which is the right correction for the
            // first block, so there is no special case.
            float corr = exp2(mo - mn);
            rowMax[e] = mn;

            float sum = 0.0;
            [[unroll]] for (uint i = 0u; i < BN / CPR; ++i) {
                uint c = i * CPR + tc;
                float p = (c < cnt) ? exp2(v[i] - mn) : 0.0;
                pbuf[r * BN + c] = float16_t(p);
                sum += p;
            }
            sum = subgroupClusteredAdd(sum, CPR);
            if (tc == 0u) {
                rowDen[e] = rowDen[e] * corr + sum;
                uint qi = r / TILE, rr = r % TILE;
                [[unroll]] for (uint c = 0u; c < TILE; ++c) {
                    bcorr[qi * (TILE * TILE) + rr * TILE + c] = corr;
                }
            }
        }
        barrier();

        // ---- Rescale O onto the new maximum, then O += P.V over this
        // wave's own component tiles.
        FRAG_A fragP[QT][KTIL];
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
#if !NO_RESCALE
            ACC ccorr;
            coopMatLoad(ccorr, bcorr, qq * (TILE * TILE), TILE, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint j = 0u; j < DW; ++j) {
                o[qq][j] = o[qq][j] * ccorr;
            }
#endif
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatLoad(fragP[qq][kk], pbuf, qq * (TILE * BN) + kk * TILE, BN,
                    gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        [[unroll]] for (uint j = 0u; j < DW; ++j) {
            FRAG_B fragV[KTIL];
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatLoad(fragV[kk], hact,
                    pc.aux2 + ((base / TILE + kk) * DT + w * DW + j) * (TILE * TILE),
                    TILE, gl_CooperativeMatrixLayoutColumnMajor);
            }
            [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
                [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                    o[qq][j] = coopMatMulAdd(fragP[qq][kk], fragV[kk], o[qq][j]);
                }
            }
        }
        barrier();
    }

    // ---- Epilogue. The denominators go to LDS once, since every wave scales
    // its own output tiles by them.
    [[unroll]] for (uint e = 0u; e < RPT; ++e) {
        uint r = r0 + e * (NTHREADS / CPR);
        if (r < BM && tc == 0u) {
            rowSum[r] = rowDen[e];
        }
    }
    barrier();

    [[unroll]] for (uint j = 0u; j < DW; ++j) {
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            coopMatStore(o[qq][j], stage, (w * QT + qq) * (TILE * TILE), TILE,
                gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();
        // Four lanes per row, four contiguous floats each: 16 B per lane and
        // 64 contiguous B per quad, with the neighbouring j tiles completing
        // the cache lines (§5.1b).
        for (uint i = lane; i < BM * 4u; i += WAVE) {
            uint row = i / 4u, part = i % 4u;
            if (q0 + row >= n) {
                continue;
            }
            uint qi = row / TILE, rr = row % TILE;
            float inv = 1.0 / rowSum[row];
            uint src = (w * QT + qi) * (TILE * TILE) + rr * TILE + part * 4u;
            uint dst = pc.outOff + (q0 + row) * DIM + (w * DW + j) * TILE + part * 4u;
            [[unroll]] for (uint c = 0u; c < 4u; ++c) {
                act[dst + c] = stage[src + c] * inv;
            }
        }
        barrier();
    }
}
