#version 450

#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

// build_hc_combine: scatter one block's output back into every stream of the
// wide residual, each with its own learned weight.
//
//   res[t][c] += out[t] * 2*sigmoid(inject[t][c] / hc)
//
// The 2*sigmoid centres the weights on 1, so an inject of zero is a plain
// residual add — which is how the block initialises to a no-op.
//
// llama.cpp spends a SCALE, a SIGMOID, a REPEAT, a MUL and an ADD on this,
// four of which move the 10240-wide fp32 residual; here the scatter weight is
// one scalar read per workgroup and the residual is read and written once.
// One workgroup is one (token, stream), which is what makes the weight
// workgroup-uniform.

#include "llm_common.glsl"

#extension GL_EXT_control_flow_attributes : enable

// **The grid is a stream across and a token down** (KERNELS.md G6, research
// §5.4), so the workgroups in flight at one moment walk the streams of a few
// tokens rather than one stream of many -- and a token's four workgroups,
// which all read the same block output row, run back to back and read it
// from DRAM once, not four times (a third of this kernel's traffic). The residual is [T][hc][2560] fp32:
// a stream's row is 10,240 B, two and a half turns of the 4 KB channel
// rotation (§5.1b), so it asks the first half of the rotation for three bytes
// where it asks the second for two; and a token is 40,960 B, ten turns
// exactly, so a grid walked token-fastest has every workgroup in flight at
// the same phase and the busier channels saturate at 5/6 of the bus. Streams
// are 2,048 B of phase apart, so a token's four ask for the two halves evenly.
// TOKEN_FAST=1 is the control: the same grid, walked the old way.
#ifndef TOKEN_FAST
#define TOKEN_FAST 0
#endif
// HOIST: every load of the row issued before anything waits on one, and kept
// in registers. A `for (i = tid; i < n; i += 256)` loop is not unrolled (n is
// a push constant), so it is one 256-byte request in flight a wave, and a
// read-modify-write through one binding is load, `s_waitcnt vmcnt(0)`, store
// even when it is. That is nothing at DRAM sizes and 1.1-1.6x where the
// arena fits the MALL, which is every decode step. HOIST=0 is the control.
#ifndef HOIST
#define HOIST 1
#endif
// GUT (pricing only, wrong by construction): 1 drops the block output's
// read, 2 keeps a tenth of the stores, 3 drops the residual's read.
#ifndef GUT
#define GUT 0
#endif
// Registers per thread: nEmbd / 256, rounded up. 2560 is ten.
#define HC_MAX 10

layout(local_size_x = 256) in;

void main() {
#if TOKEN_FAST
    uint id = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint t = id % gl_NumWorkGroups.y;
    uint c = id / gl_NumWorkGroups.y;
#else
    uint c = gl_WorkGroupID.x;
    uint t = gl_WorkGroupID.y;
#endif
    if (t >= pc.tokens) {
        return;
    }
    uint n = pc.nEmbd;
    // The inject row stride is the down projection's tile, not hc: the fused
    // [lowRank + hc, wide] weight puts the scatter weights in one 16-wide
    // tile and the kernel stores it whole.
    uint inj = pc.injOff + t * (pc.gemmN - pc.lowRank) + c;
    float w = 2.0 * (1.0 / (1.0 + exp(-act[inj] / float(pc.hc))));

    uint dst = pc.resOff + (t * pc.hc + c) * n;
    uint src = pc.outOff + t * n;
#if HOIST
    // `precise`: the scatter is a multiply and an add, rounded twice, and
    // stays that (llm_hc_cn.comp, which must produce the same bits).
    precise float r[HC_MAX];
    float blk[HC_MAX];
    [[unroll]] for (uint j = 0u; j < HC_MAX; j++) {
        uint i = gl_LocalInvocationID.x + j * gl_WorkGroupSize.x;
        if (i < n) {
#if GUT == 3
            r[j] = w;
#else
            r[j] = act[dst + i];
#endif
#if GUT == 1
            blk[j] = w;
#else
            blk[j] = act[src + i];
#endif
        }
    }
    [[unroll]] for (uint j = 0u; j < HC_MAX; j++) {
        uint i = gl_LocalInvocationID.x + j * gl_WorkGroupSize.x;
        if (i < n) {
            r[j] = r[j] + blk[j] * w;
#if GUT == 2
            if (j == 0u || r[j] == 12345.678)
#endif
            act[dst + i] = r[j];
        }
    }
#else
    for (uint i = gl_LocalInvocationID.x; i < n; i += gl_WorkGroupSize.x) {
        act[dst + i] += act[src + i] * w;
    }
#endif
}
