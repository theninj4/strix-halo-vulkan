#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// ACE-Step's 5 Hz LM (ace/lm, MUSIC.md A7): the step between a layer's q/k/v
// projections and its attention, for prefill and decode alike.
//
// Every row of a pass is a token of some sequence: its slot (which KV cache)
// and its position, from the row metadata. One workgroup a (row, head) over
// 32 q heads, then 8 k heads, then 8 v heads, one thread a dim:
//
//   q: RMSNorm over the head (q_norm), NeoX rope at the row's position,
//      times pc.scale (1/sqrt(128)), into the fp16 q the attention reads;
//   k: RMSNorm (k_norm, the 128 after q_norm), rope, into the key cache at
//      (slot, position);
//   v: straight into the value cache at (slot, position).
//
// The cache holds every position ever written, so attention needs nothing
// from the pass but the query: a prefill is the same code as a decode, and
// a prompt can be prefilled in any number of passes.
//
// Fields:
//
//	inOff  q fp32 [rows][32][128]        kOff  k fp32 [rows][8][128]     vOff  v fp32 [rows][8][128]
//	outOff q fp16 [rows][32][128]        wOff  q_norm [128], k_norm [128] (weights arena)
//	aux0   row metadata: (slot, pos) as uint bits, 2 a row
//	aux1   the layer's key cache, aux2 its value cache: fp16 [slot][pos][8][128] (fp16 arena)
//	span   positions a slot holds        bOff  rope cos [pos][64], then sin (weights arena)
//	kStride  the rope table's positions  eps, scale, tokens (rows)
//
// PaddleOCR-VL's ERNIE-4.5-0.3B (ocr/lm.go) is the same step with three
// build switches: NQ=16 NKV=2, QK_NORM=0 (it has none), and MROPE=1, its
// 3-D rope. Under MROPE a row's rope positions are three numbers, (t, h, w)
// as uint bits at pc.dim + row*3, apart from its cache position (text after
// an image resumes at p + max(mh, mw), not at its cache index), and each of
// the 64 frequency pairs reads one of them in *chunked* sections: pairs
// 0-15 t, 16-39 h, 40-63 w (HF's recomposition_frequencies, [16, 24, 24]).
// The table is still one [pos][64] over one inv_freq: only the position a
// pair reads changes.
//
// PAGED (OCR's build, OCR.md O11): the caches are a pool of 64-position
// pages, not a plane a slot. pc.heads is the page table in the activation
// arena (uint bits, [slot][pc.span] pages), so position p of a slot lives in
// cell (table[slot][p / 64] * 64 + p % 64).

#include "dit_common.glsl"

layout(binding = 2) buffer HAct { float16_t hact[]; };

#define HD 128u
#ifndef NQ
#define NQ 32u
#endif
#ifndef NKV
#define NKV 8u
#endif
#ifndef QK_NORM
#define QK_NORM 1
#endif
#ifndef MROPE
#define MROPE 0
#endif
#ifndef PAGED
#define PAGED 0
#endif

layout(local_size_x = 128) in;

shared float red[128];

void main() {
    uint r = gl_WorkGroupID.x;
    uint y = gl_WorkGroupID.y;
    uint t = gl_LocalInvocationID.x;
    if (r >= pc.tokens) {
        return;
    }
    uint slot = floatBitsToUint(act[pc.aux0 + r * 2u]);
    uint pos = floatBitsToUint(act[pc.aux0 + r * 2u + 1u]);
#if PAGED
    uint page = floatBitsToUint(act[pc.heads + slot * pc.span + pos / 64u]);
    uint cell = ((page * 64u + pos % 64u) * NKV) * HD;
#else
    uint cell = ((slot * pc.span + pos) * NKV) * HD;
#endif

    if (y >= NQ + NKV) {
        uint h = y - NQ - NKV;
        hact[pc.aux2 + cell + h * HD + t] = float16_t(act[pc.vOff + (r * NKV + h) * HD + t]);
        return;
    }
    bool isQ = y < NQ;
    uint h = isQ ? y : y - NQ;
    uint src = isQ ? pc.inOff + (r * NQ + h) * HD : pc.kOff + (r * NKV + h) * HD;
    float x = act[src + t];

#if QK_NORM
    red[t] = x * x;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1) {
        if (t < s) {
            red[t] += red[t + s];
        }
        barrier();
    }
    float inv = inversesqrt(red[0] / float(HD) + uintBitsToFloat(pc.eps));
    float xn = x * inv * wbuf[pc.wOff + (isQ ? 0u : HD) + t];
    barrier(); // every thread has read red[0] before red is reused
#else
    float xn = x;
#endif

    // NeoX: dim i pairs with i ± 64 at the frequency of i mod 64.
    red[t] = xn;
    barrier();
    uint i = t % 64u;
#if MROPE
    uint axis = i < 16u ? 0u : (i < 40u ? 1u : 2u);
    uint rp = floatBitsToUint(act[pc.dim + r * 3u + axis]);
#else
    uint rp = pos;
#endif
    float c = wbuf[pc.bOff + rp * 64u + i];
    float s = wbuf[pc.bOff + pc.kStride * 64u + rp * 64u + i];
    float y2 = t < 64u ? xn * c - red[t + 64u] * s : xn * c + red[t - 64u] * s;

    if (isQ) {
        hact[pc.outOff + (r * NQ + h) * HD + t] = float16_t(y2 * uintBitsToFloat(pc.scale));
    } else {
        hact[pc.aux1 + cell + h * HD + t] = float16_t(y2);
    }
}
