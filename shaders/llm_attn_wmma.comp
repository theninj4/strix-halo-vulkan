#version 450

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

// Causal grouped-query flash attention on the matrix cores, with the output
// gate fused into its epilogue: the fourth of the full-attention layer's five
// dispatches (LLM.md L2f).
//
// The flash structure is dit_attention_wmma.comp's and this file does not
// re-litigate it — two cooperative-matrix GEMMs with an online softmax between
// them, Q held in registers across the whole key loop, the row max taken from
// a 16x16 fp32 staging tile because a cooperative matrix's element order is
// not defined, the rescale applied as a row-constant matrix, and the softmax
// denominator accumulated by appending a column of ones to V. It is a separate
// shader rather than another arm of that one because it lives in this
// vertical's binding contract (llm_common.glsl, which has a KV cache, an
// indexer and a gate where the DiT's has none of them), and because of the two
// things below.
//
// **The head dim is 256, not 128.** HDT doubles to 16, which doubles the query
// fragments held in registers and the output accumulators with them: at QT=1
// that is 16 A-fragments and 16 accumulators live across the key loop, and it
// is why the ladder here starts at QT=1 rather than at the DiT's QT=2. The
// arithmetic intensity argument is unchanged and was inert there anyway — what
// decides this ladder is the register file.
//
// **The gate is fused into the store.** `attn_q` is [2560, 12288]: each head's
// 256 query dims are immediately followed by 256 *gate* dims, and the gate is
// a sigmoid applied to the attention **output**, not to the query. llama.cpp
// spends a SIGMOID, a MUL and a CONT on it; here the epilogue already has the
// output tile in LDS for the 1/rowSum divide, so the gate costs one extra read
// of the fused projection's own fp32 row and the context leaves as fp16
// straight into the output projection's A layout. Three of llama.cpp's lines
// and a [T, 6144] round trip through DRAM, deleted.
//
// **The selection is a second mask, and a skip** (P7). `llm_attn_select.comp`
// writes one bit per cache cell per token, and this kernel reads it exactly
// where it reads the causal one: out of the block row max, so an unselected
// cell cannot set the scale, and out of P, which is what removes it from both
// O and the row sum. That much is what the reference does — `build_attn_qsa`
// turns `top_k` back into an f16 mask and runs **dense** flash attention over
// every cell — and on its own it is semantics and not a saving.
//
// So the mask is also read *before* the key block is, and a block with no
// selected cell in any row is skipped whole. The two are the same answer: an
// unselected cell contributes nothing to O and nothing to the row sum, so a
// block of them contributes nothing, and the skip is bit-identical rather
// than an approximation. What it changes is the **cost**, which is the reason
// QSA exists: a decode step names 2051 cells however deep the cache is, they
// fall in ~513 blocks of `ratio`, and at 64k of context four key blocks in
// five hold none of them. At prefill it is close to inert — at ~50% density a
// 32-cell block is eight indexer blocks and the chance all eight miss is
// ~0.4% (L4b-3) — which is why this is a decode optimisation and only that.
//
// `selOff == NO_W` is the dense path, and it is the honest one below 2051
// cells: at any prompt shorter than `top_k + ratio - 1` the selection names
// every cell (research/l2e-attention.md), so running it would be the identity
// and the branch is not an approximation.
//
// **The key range is split across workgroups at decode** (P8, `-DSPLITK`).
//
// The grid is (query blocks, heads), so a decode step — one token — dispatches
// one workgroup a head: 24 of them, each a *single wave*, and each walking
// every key block of the cache in turn. They all fit on the device at once,
// so the dispatch's wall clock is **one wave's serial walk** and nothing
// else: cutting the grid from 24 workgroups to 2 was measured at 1.00x, which
// is what says the cost is neither the traffic nor the occupancy across heads
// but the length of that walk. Adding heads cannot shorten it; only cutting
// the walk can.
//
// So this build slices the key axis `pc.injOff` ways (ATTN_SPLITS) and gives
// each slice its own workgroup — the grid's x becomes (query block, slice) —
// and each writes its slice's **unnormalised** context beside the two numbers
// an online softmax needs to be resumed: the slice's row max and its row sum.
// `llm_attn_combine.comp` puts them back together. That is flash-decoding's
// split, and it is exact in the same sense the block loop already is: the
// same partial-softmax identity that lets the loop rescale by exp2(mo - mn)
// when it meets a bigger max is what lets the combine rescale by
// exp2(m_s - m*) when it meets the largest of the slices'.
//
// It is **not bit-identical** to the unsplit kernel and cannot be: the
// rescales happen in a different order and fp32 addition is not associative.
// What it is is the same arithmetic, gated on agreement with the reference
// rather than with the other kernel — see TestAttnGPUSplitMatchesDense.
//
// **The query is a batch, the key and the value are a cache** (L7a). Row i of
// query block q0 is cell `SEQ_PAST + q0 + i` and the keys run over every cell
// the cache holds, `SEQ_PAST + tokens` of them, so the two operands no longer
// share a plane geometry: the query's is `plane` padded token rows, the key's
// and the value's are nKV cells. Every causal comparison is between a cell and
// a *position*, and on a fresh sequence SEQ_PAST is zero and all of it is
// what L2f measured.

#include "llm_common.glsl"

#ifndef QT
#define QT 1        // query tiles per wave
#endif
#ifndef KTIL
#define KTIL 4      // key tiles per block
#endif
#ifndef WAVE
#define WAVE 64
#endif
#ifndef HEAD_DIM
#define HEAD_DIM 256
#endif

#define TILE 16
#define HDT (HEAD_DIM / TILE)
#define BM (QT * TILE)
#define BN (KTIL * TILE)

// The row max's lane split (P12). The scan below is one row per lane at
// BM=16 on a 64-wide wave, which is sixteen lanes of sixty-four; RCL lanes
// share a row instead, each taking RCPL of the block's BN columns, and a
// clustered subgroup max folds them. Every shipped rung has BM <= 32 < WAVE,
// so RCL is 4 or 2; the `RCL <= 1` arm below is what a QT=4 build would take
// and keeps the file honest rather than being reachable today.
#define RCL (WAVE / BM)
#define RCPL (BN / RCL)

// Mask words a row a key block. **It is not BN/32**, because BN may be
// narrower than a word: a 16-cell key block (KTIL=1) is half of one, so the
// staged slice is still one word a row and the block's cells start at bit
// `base & 31` inside it. Every wider rung has `base` a multiple of 32 and
// `SELBIT` is zero, which is exactly the addressing this had before.
#define BW ((BN + 31) / 32)
#define SELBIT(base) ((BN < 32) ? ((base) & 31u) : 0u)

// **Query heads a workgroup** (P14-2, fourth pass), and it is the gathered
// kernel's only structural knob.
//
// The probe that motivates it: doubling the QK matrix work costs **2.7%**, so
// the gathered kernel is not arithmetic-bound at all — it is bound by the gather
// itself. A key chunk moves 32 KB of global reads, 32 KB of LDS writes and 32 KB
// of LDS reads per wave, and the first two are **the same bytes for every query
// head that shares a kv head**: the grid is (query tile, head), the selection is
// per token, and this model has twelve query heads to a kv head. Putting HPW
// heads in one workgroup stages once for all of them.
//
// Each wave still owns one head and its own registers, so nothing about the
// fragments or the online softmax changes; what becomes per wave is the LDS the
// softmax uses, and what becomes shared is the staged key, the cell list and the
// mask. `HPW = 1` is the arrangement this kernel had, and every offset below
// folds to zero there — which is what keeps the block and split builds, which
// have no business with this, byte for byte what they were.
#ifndef HPW
#define HPW 1
#endif
#if HPW > 1 && !defined(GATHER)
#error "HPW is the gathered kernel's knob; the block and split builds are one wave"
#endif

layout(local_size_x = WAVE * HPW) in;

#define ACC  coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define ACCH coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define FRAG_A coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA>
#define FRAG_B coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB>

// The score staging tile, and it holds the **whole key block** rather than one
// key tile of it (P12): all QT*KTIL of the block's score fragments at once, so
// the row max below is one pass over BM x BN with one barrier in front of it
// instead of KTIL passes with two each. Everything after the row max uses only
// the first QT tiles of it, exactly as it did when that was all there was.
// Per **wave**, not per workgroup: at HPW > 1 each wave is a different head with
// its own softmax, so these are sharded and `sBase`/`pBase`/`bBase`/`rBase` in
// main() are the wave's slice. At HPW = 1 every base is zero and folds away.
#define SSTAGE (QT * KTIL * TILE * TILE)
#define SPBUF  (BM * BN)
#define SBCORR (QT * TILE * TILE)
shared float stage[HPW * SSTAGE];
shared float16_t pbuf[HPW * SPBUF];
shared float bcorr[HPW * SBCORR];
shared float rowMax[HPW * BM];
shared float blkMax[HPW * BM];
shared float rowSum[HPW * BM];
// This key block's slice of the QSA bitmask, one word per (row, 32 cells).
// It is staged once a block rather than bit-tested out of the arena per
// element: the mask loop below touches BM*BN elements and the row max another
// BM*TILE, which is 512 global reads a block where the block's whole mask is
// BM*BN/32 words. Reading it per element cost the kernel 1.90x.
shared uint selw[BM * BW];
// Whether any row of this key block has any cell selected at all.
shared uint blkAny;

#ifdef GATHER
// The staging barrier, and it is **a workgroup barrier and not a subgroup one**
// — which is a measurement and then a correctness requirement.
//
// The measurement: at HPW = 1 this kernel's workgroup is exactly one subgroup, so
// `subgroupMemoryBarrierShared()` gives the double-buffered loop the LDS ordering
// it needs without the `s_barrier` that `barrier()` also emits. A key chunk
// carries 32 of these against 66 matrix ops, so it looked worth having — and it
// is **1.00x**, as is staging two head-dim groups per barrier (GRP=2) and as is
// P13-3's compaction and P11-4's hoist before it. *Latency that matters at decode
// does not matter at prefill, because prefill has occupancy.* Fourth time.
//
// The requirement: at HPW > 1 the staging loop spans every wave of the
// workgroup, and a subgroup barrier orders none of it. So it is `barrier()`,
// which is what the measurement says it may as well be.
#define GSTAGE_BARRIER() barrier()

// P14-2's gathered key chunk, one head-dim group at a time.
//
// **It is 512 halves and that is the whole design.** A gathered cell's sixteen
// dims for group `kt` are 32 contiguous bytes in the plane and the plane is not
// contiguous in the *cells*, so a fragment over scattered cells cannot be a
// `coopMatLoad` from the arena — it has to be staged. Staging the chunk's whole
// 256 dims at once would be 16 KB at BN=32 and 32 KB at BN=64, and a
// single-wave workgroup that takes 32 KB of LDS is two workgroups resident per
// 64 KB where this kernel today gets twenty — which is the one thing a prefill
// cannot give up (P13-3: *latency and redundant reads that matter at decode do
// not matter at prefill, because prefill has occupancy*). Staged a group at a
// time it is `KTIL * 256` halves, 1 KB at the shipped rung, and the QK loop was
// already iterating the groups.
//
// Both planes read it: the key as a ColumnMajor B operand — element (dim, cell)
// at `cell*TILE + dim` — and the value as a RowMajor one, element (cell, dim)
// at the same address, because P14-2 made the value plane cell-major too. One
// layout, one staging loop.
// **Two of them** (P14-2's second pass): group `g` is staged while the matrix
// cores are still working on group `g-1`, so the QK and PV loops carry one
// barrier each per group instead of two — one to say the buffer being read is
// complete, where a single buffer also needed one to say it had been read before
// it was overwritten. A key chunk is 32 groups of staging and two barriers a
// group was comparable with the mma it was feeding.
// **GRP head-dim groups a staging call** (P14-2, third pass). Double buffering
// took the barriers from two a group to one; staging GRP groups at a time takes
// them to one per GRP. It costs LDS — `2 * GRP * KTIL * 256` halves, 2 KB at
// GRP=1 and 4 KB at GRP=2 on the shipped rung — and LDS is occupancy, so it is a
// build knob and the ladder decides.
#ifndef GRP
#define GRP 1
#endif
#if (HDT % GRP) != 0
#error "GRP must divide the head-dim groups"
#endif
#define GSTAGE (KTIL * TILE * TILE)
shared float16_t kvs[2][GRP * GSTAGE];
// The mask pass rounds its write up to GATH_BW words a row, so a rung that
// staged more than that per chunk would read words nothing wrote.
#if BW > 2
#error "a gathered rung stages more mask words a chunk than llm_attn_gather.comp writes (GATH_BW)"
#endif
// This chunk's cell indices, staged once for both planes and all HDT groups.
shared uint glist[BN];
#endif

#if !defined(SPLITK) && !defined(GATHER)
// P13's live-block list, a chunk at a time. `pc.resOff` names an ascending
// list of the key blocks this query tile has anything selected in, with the
// count in front of it, and this kernel then iterates the list instead of the
// axis — which is what makes a prefill flat in depth, because the live count
// is (515, 518, 696) at (32k, 64k, 128k) where the axis is (1000, 2000,
// 4000).
//
// It is staged rather than read per iteration for the reason the mask was
// (L4b-3): the loop below is one wave, so a scalar load at the top of every
// block is a dependent global read on the critical path. A chunk of LCHUNK
// is one coalesced read per LCHUNK blocks.
//
// **Bit-identical, and not merely close.** The list holds exactly the blocks
// the `blkAny` skip would not have skipped, in the order the loop would have
// met them, so the same partial softmaxes are folded in the same order. What
// is deleted is the visit to the blocks that contributed nothing — which P7
// already established contribute nothing.
#define LCHUNK 256
shared uint blist[LCHUNK];
#endif

#ifdef GATHER
// stagePlane loads one head-dim group of this chunk's gathered cells into LDS:
// cell `c` of the chunk takes its sixteen halves from
// `plane + (cell/16 * HDT + grp) * 256 + (cell%16) * 16`, and lands at
// `c * TILE` — the layout both `coopMatLoad`s above want.
//
// Eight halves a lane, unrolled over constant offsets so the load is one
// 16-byte transfer and the store one LDS write. A selected run is `ratio`
// consecutive cells, so consecutive `c` are consecutive 32-byte pieces of the
// same tile and a run of four is one 128-byte line — which is the reason the
// value plane moved to cell-major.
//
// Positions past the chunk's own count stage as **zero**: their mask bits are
// zero so nothing reads the score they produce, and a zero is cheaper to be
// sure about than a bounds test inside the fragment.
void stagePlane(uint tid, uint buf, uint planeBase, uint grp0, uint cnt) {
    for (uint i = tid; i < GRP * BN * 2u; i += WAVE * HPW) {
        uint g = i / (BN * 2u), rem = i % (BN * 2u);
        uint c = rem >> 1u, half8 = (rem & 1u) * 8u;
        uint dst = g * GSTAGE + c * TILE + half8;
        if (c >= cnt) {
            [[unroll]] for (uint d = 0u; d < 8u; ++d) {
                kvs[buf][dst + d] = float16_t(0.0);
            }
            continue;
        }
        uint cell = glist[c];
        uint src = planeBase + ((cell / TILE) * HDT + grp0 + g) * (TILE * TILE)
            + (cell % TILE) * TILE + half8;
        [[unroll]] for (uint d = 0u; d < 8u; ++d) {
            kvs[buf][dst + d] = hact[src + d];
        }
    }
}
#endif

// stageSel loads this key block's slice of the QSA bitmask into LDS: one word
// per (row, 32 cells), read by both the row max and the mask loop below, and
// returns the OR of the words this lane staged — which is how the skip below
// learns whether the block has anything in it at all.
//
// `base` is a multiple of BN; where BN is a multiple of 32 a word of the
// staged slice is a word of the arena, and where it is not (KTIL=1, a 16-cell
// block) the row's word is the one containing `base` and the block is the
// half of it at `SELBIT`. Either way nothing is shifted: the bit index does
// the work, so a rung change costs no extra instruction on the rungs that
// were already word-aligned. A pad row has no
// selection — llm_attn_select.comp does not run past the prompt — so it stages
// as **zero**: nothing of it is visible, its softmax denominator is zero, and
// the epilogue turns that into a zero row rather than a NaN. (It used to stage
// all-ones and take the dense path for exactly that denominator; the skip
// below would then have been defeated by fifteen pad rows on every decode
// step, which is the one shape where the skip is worth anything.)
uint stageSel(uint lane, uint q0, uint base) {
    uint words = (pc.nKV + 31u) / 32u;
    // The bits of the staged word this key block actually covers: all of them
    // on a word-aligned rung, the 16 at SELBIT on a 16-cell one. The skip
    // below must not be defeated by a neighbouring block's bits.
    uint keep = (BN < 32) ? (((1u << BN) - 1u) << SELBIT(base)) : 0xFFFFFFFFu;
    uint acc = 0u;
    for (uint i = lane; i < BM * BW; i += WAVE) {
        uint row = i / BW, wd = i % BW;
        uint token = q0 + row;
        uint w = (token >= pc.tokens) ? 0u
                                      : actu[pc.selOff + token * words + ((base + wd * 32u) >> 5u)];
        selw[i] = w;
        acc |= w & keep;
    }
    return acc;
}

// selected reads one bit out of the staged slice. `bit0` is the block's first
// bit inside its row's first staged word, which is zero on every rung whose
// key block is a whole number of words.
bool selected(uint row, uint col, uint bit0) {
    uint b = bit0 + col;
    return (selw[row * BW + (b >> 5u)] & (1u << (b & 31u))) != 0u;
}

void main() {
    uint head = gl_WorkGroupID.y;
#ifdef SPLITK
    // The grid's x carries both: `splits` slices of every query block, so
    // that a build which is not split keeps exactly the grid it had.
    uint splits = max(pc.injOff, 1u);
    uint sp = gl_WorkGroupID.x % splits;
    uint q0 = (gl_WorkGroupID.x / splits) * BM;
#else
    uint q0 = gl_WorkGroupID.x * BM;
#endif
    uint past = SEQ_PAST;
    uint n = past + pc.tokens;       // cells in the cache, keys to attend over
    uint tid = gl_LocalInvocationID.x;
#if HPW > 1
    // Each wave is a head; the workgroup shares the gather. `heads % HPW == 0`
    // is the host's promise (gathHeadsPerWG), so no wave falls off the end and
    // every barrier below is reached by all of them.
    uint wv = tid / WAVE;
    uint lane = tid % WAVE;
    head = gl_WorkGroupID.y * HPW + wv;
#else
    const uint wv = 0u;
    uint lane = tid;
#endif
    // The wave's slice of the LDS the softmax uses. Zero at HPW = 1.
    uint sBase = wv * SSTAGE, pBase = wv * SPBUF, bBase = wv * SBCORR, rBase = wv * BM;
    if (q0 >= pc.tokens || head >= pc.heads) {
        return;
    }
    bool sparse = pc.selOff != NO_W;
#if defined(SPLITK) || defined(GATHER)
    // The split build strides *absolute* key blocks on purpose (see the loop
    // below), so it never takes P13's list and `useList` is a constant here;
    // the gather build has no key axis to walk at all.
    const bool useList = false;
#else
    bool useList;
#endif

    uint qTiles = pc.plane / TILE;
    uint kvTiles = pc.nKV / TILE;
    uint plane = head * qTiles * (HDT * TILE * TILE);
    uint rep = max(pc.heads / max(pc.kvHeads, 1u), 1u);
    uint kvPlane = (head / rep) * kvTiles * (HDT * TILE * TILE);
    uint qBase = pc.qOff + plane + (q0 / TILE) * (HDT * TILE * TILE);
    uint kBase = pc.kOff + kvPlane;
    uint vBase = pc.vOff + kvPlane;

    FRAG_A fragQ[QT][HDT];
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        [[unroll]] for (uint kt = 0u; kt < HDT; ++kt) {
            coopMatLoad(fragQ[qq][kt], hact, qBase + (qq * HDT + kt) * (TILE * TILE),
                TILE, gl_CooperativeMatrixLayoutRowMajor);
        }
    }

    ACC o[QT][HDT];
    ACC lsum[QT];
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        [[unroll]] for (uint j = 0u; j < HDT; ++j) {
            o[qq][j] = ACC(0.0);
        }
        lsum[qq] = ACC(0.0);
    }
    for (uint i = lane; i < BM; i += WAVE) {
        rowMax[rBase + i] = -1.0 / 0.0;
    }
    barrier();

    const FRAG_B ones = FRAG_B(float16_t(1.0));

    // Nothing past this query block's last row can be attended to, so the key
    // blocks beyond it are never read. Its last row is cell `past + q0 + BM - 1`.
    uint last = min(n, past + q0 + BM);
#ifdef SPLITK
    // **Every `splits`-th block, not a contiguous run of them**, and that is
    // a correctness requirement rather than a preference.
    //
    // A slice has to be a set of *absolute* key blocks that does not depend
    // on how the prompt was chunked, because L7a's gate is that it does not:
    // token at cell `pos` must come back bit for bit whether it arrived alone
    // or seventh of seven. Cutting `[0, last)` into `splits` contiguous runs
    // fails that — `last` is `min(n, past + q0 + BM)` and both `n` and `q0`
    // are the batch's, so a seven-token chunk and a one-token chunk put the
    // boundaries in different places and fold the partial softmaxes in a
    // different order. A stride is immune: block b belongs to slice
    // `b % splits` however the run was cut.
    //
    // The blocks past a row's causal extent that the stride then walks cost
    // nothing and change nothing, for the same reason the unsplit loop can
    // walk them: blkMax stays -inf, the correction is exactly 1.0, and P is
    // zeroed, so the accumulators come out untouched. And the stride balances
    // the slices where a contiguous cut would not — the QSA selection is
    // clustered (P7), so contiguous runs would hand one slice most of the
    // live blocks and its neighbours none.
    //
    // A slice with no block at all — `sp >= ceil(last/BN)` — falls straight
    // through to the epilogue, which writes the combine's identity: a row max
    // of -inf and a row sum of zero.
    for (uint base = sp * BN; base < last; base += splits * BN) {
      {
#elif defined(GATHER)
    // ---- P14-2: there is no key axis here. `pc.resOff` names this query
    // tile's gathered cell list and the per-row mask behind it
    // (`gathMax`/`gathStride`, llm_common.glsl), and the loop is a **dense**
    // attention over `nGath` cells — no block skip, no `blkAny` vote, and no
    // causal comparison anywhere, because the mask the gather wrote already has
    // the causal test folded in.
    //
    // At 128 000 cells a sixteen-row tile's live blocks hold 24 580 cells and
    // its union holds 10 058, so this loop is 2.44x shorter than the one it
    // replaces — which is the last large term in a prefill at depth.
    uint gmx = gathMax(pc.nKV, pc.selWidth, BM);
    uint gmwords = gmx >> 5u;
    uint gbase = pc.resOff + (q0 / BM) * gathStride(gmx, BM);
    uint nGath = actu[gbase];
    uint gidx = gbase + 1u;
    uint gmask = gidx + gmx;
    for (uint g0 = 0u; g0 < nGath; g0 += BN) {
      {
#else
    // The list, when there is one: `pc.resOff` is NO_W on every pass that did
    // not build one (the dense arm, and every rung the block dispatch was not
    // compiled for), and then this is exactly the axis walk it was.
    useList = sparse && pc.resOff != NO_W;
    uint listBase = pc.resOff + (q0 / BM) * (1u + (pc.nKV + BN - 1u) / BN);
    uint nblk = useList ? actu[listBase] : (last + BN - 1u) / BN;
    for (uint c0 = 0u; c0 < nblk; c0 += LCHUNK) {
      uint cn = min(uint(LCHUNK), nblk - c0);
      if (useList) {
          for (uint i = lane; i < cn; i += WAVE) {
              blist[i] = actu[listBase + 1u + c0 + i];
          }
          barrier();
      }
      for (uint bi = 0u; bi < cn; ++bi) {
        uint base = useList ? blist[bi] * BN : (c0 + bi) * BN;
#endif
#ifdef GATHER
        uint cnt = min(uint(BN), nGath - g0);
        // The compacted mask is a bitmask over *positions*, so a chunk narrower
        // than a word is the half of one at `g0 & 31` — exactly SELBIT's job on
        // the block kernel's 16-cell rung, one axis over.
        uint selBit = SELBIT(g0);
#else
        uint cnt = min(BN, n - base);
        uint selBit = SELBIT(base);
#endif

        // **The selection, before the block is read rather than after** (P7).
        // QSA names `top_k + ratio - 1` cells however deep the context is —
        // 2051 of them — and every other cell is masked out of both the row
        // max and P below, so a key block with nothing selected in it
        // contributes exactly nothing: blkMax stays -inf, the correction is
        // 1, and every element of P is zeroed. Skipping it is therefore
        // bit-identical, and it is the whole point of a sparse attention:
        // without this the kernel walked all `n` cells at every depth and the
        // selection bought semantics and no time at all (L4b-3). At a decode
        // step the 2051 cells fall in ~513 blocks of `ratio`, so at 64k of
        // context roughly four key blocks in five hold none of them.
        //
        // The staging has to move up here for it — it is the test — and it is
        // work this block was going to do anyway.
#ifdef GATHER
        // This chunk's cell indices and its slice of the compacted mask, both
        // coalesced: the mask's row stride is the gathered capacity, so a
        // chunk's words sit `g0/32` into each row. There is nothing to vote on
        // — every cell in the list is selected by *some* row of the tile — so
        // the two barriers the block skip needed are gone with it.
        for (uint i = tid; i < BN; i += WAVE * HPW) {
            glist[i] = (i < cnt) ? actu[gidx + g0 + i] : 0u;
        }
        for (uint i = tid; i < BM * BW; i += WAVE * HPW) {
            uint row = i / BW, wd = i % BW;
            selw[i] = actu[gmask + row * gmwords + (g0 >> 5u) + wd];
        }
        barrier();
#else
        if (sparse && useList) {
            // Every block in the list is live — that is what the list is —
            // so the test and the two barriers around it are gone and what
            // is left is the staging the block needed anyway.
            stageSel(lane, q0, base);
            barrier();
        } else if (sparse) {
            if (lane == 0u) {
                blkAny = 0u;
            }
            barrier();
            if (stageSel(lane, q0, base) != 0u) {
                atomicOr(blkAny, 1u);
            }
            barrier();
            if (blkAny == 0u) {
                continue;
            }
        }
#endif

        ACC s[QT][KTIL];
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                s[qq][kk] = ACC(0.0);
            }
        }
#ifdef GATHER
        // The first batch of groups, so the loop below can always be staging the
        // *next* one while the matrix cores work on this one.
        stagePlane(tid, 0u, kBase, 0u, cnt);
#endif
        [[unroll]] for (uint kt = 0u; kt < HDT; ++kt) {
            FRAG_B fragK[KTIL];
#ifdef GATHER
            // The gathered cells' sixteen dims for these groups, through LDS —
            // the loop was already over the groups, so the staging rides it. Both
            // divisions fold: HDT and GRP are compile-time and the loop unrolls.
            if (kt % GRP == 0u) {
                GSTAGE_BARRIER();
                if (kt + GRP < HDT) {
                    stagePlane(tid, ((kt / GRP) + 1u) & 1u, kBase, kt + GRP, cnt);
                }
            }
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatLoad(fragK[kk], kvs[(kt / GRP) & 1u],
                    (kt % GRP) * GSTAGE + kk * (TILE * TILE),
                    TILE, gl_CooperativeMatrixLayoutColumnMajor);
            }
#else
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatLoad(fragK[kk], hact, kBase + ((base / TILE + kk) * HDT + kt) * (TILE * TILE),
                    TILE, gl_CooperativeMatrixLayoutColumnMajor);
            }
#endif
            [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
                [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                    s[qq][kk] = coopMatMulAdd(fragQ[qq][kt], fragK[kk], s[qq][kk]);
                }
            }
        }
#ifdef GATHER
        GSTAGE_BARRIER();              // the last group's staging is read
#endif

        // The whole block's scores into LDS, one barrier for all of them. A
        // cooperative matrix's element order is not defined, so the row max
        // has to read them out of a staging tile whatever its shape; staging
        // all KTIL at once costs LDS (QT*KTIL*256 floats, 2 KB at the shipped
        // rung) and buys the single pass below.
        [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
            [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
                coopMatStore(s[qq][kk], stage, sBase + (kk * QT + qq) * (TILE * TILE), TILE,
                    gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        barrier();

        // The row max of this block, with the causal mask applied to the *max*
        // and not only to P: a future key that set the scale would leave every
        // real key's exp2 underflowing once the gap passed ~24 in log2 units.
        //
        // **Across the whole wave, not BM lanes of it** (P12). This was one
        // row per lane — `for (i = lane; i < BM; i += WAVE)` with BM 16 and
        // WAVE 64 — so sixteen lanes walked TILE cells apiece while
        // forty-eight sat out, KTIL times a block, with a store and two
        // barriers around each pass. And it only costs anything when the
        // selection is on, because that is what makes the walk a cell-by-cell
        // scan with a bit test rather than a run the causal break cuts short:
        // which is exactly at depth, where this kernel is 47% of a prefill
        // token.
        //
        // So the whole block is staged once (see `stage`) and RCL lanes share
        // a row, each scanning RCPL of the BN columns, folded by a clustered
        // subgroup max. **This is bit-identical and not merely close**: a max
        // is associative, commutative and idempotent, and exact under any
        // reassociation — there is no rounding in it — and the set of cells
        // each row maxes over is unchanged, because the causal test and the
        // selection bit are the same predicates read in the same order. The
        // wave is converged here (`q0`/`head` return and the `blkAny` skip are
        // both workgroup-uniform), which is what makes the clustered op legal.
        //
        // The `-inf` init is gone with the KTIL passes: every row is now
        // written exactly once, by its cluster's first lane, and a row that
        // passes no cell at all still writes the `-1.0/0.0` the rescale below
        // depends on.
#if RCL > 1
        {
            uint row = lane / RCL;
            uint qi = row / TILE, r = row % TILE;
            uint c0 = (lane % RCL) * RCPL;
            float mx = -1.0 / 0.0;
            for (uint c = c0; c < c0 + RCPL; ++c) {
#ifndef GATHER
                if (base + c > past + q0 + row) {
                    break;      // and every c after it, the row is done
                }
#endif
                if (sparse && !selected(row, c, selBit)) {
                    continue;   // unselected: it must not set the scale
                }
                mx = max(mx, stage[sBase + ((c / TILE) * QT + qi) * (TILE * TILE) +
                    r * TILE + (c % TILE)]);
            }
            mx = subgroupClusteredMax(mx, RCL);
            if (lane % RCL == 0u) {
                blkMax[rBase + row] = mx;
            }
        }
#else
        for (uint i = lane; i < BM; i += WAVE) {
            uint qi = i / TILE, r = i % TILE;
            float mx = -1.0 / 0.0;
            for (uint c = 0u; c < BN; ++c) {
#ifndef GATHER
                if (base + c > past + q0 + i) {
                    break;
                }
#endif
                if (sparse && !selected(i, c, selBit)) {
                    continue;
                }
                mx = max(mx, stage[sBase + ((c / TILE) * QT + qi) * (TILE * TILE) +
                    r * TILE + (c % TILE)]);
            }
            blkMax[rBase + i] = mx;
        }
#endif
        barrier();

        for (uint i = lane; i < BM; i += WAVE) {
            uint qi = i / TILE, r = i % TILE;
            float mo = rowMax[rBase + i];
            float mn = max(mo, blkMax[rBase + i]);
            rowMax[rBase + i] = mn;
            // exp2(-inf - m) is 0, so there is no first-block case. The equal
            // test is for the selection: a key block with nothing selected in
            // it leaves both maxima at -inf, and exp2(-inf - -inf) is a NaN
            // that would poison the accumulators for the rest of the row.
            float corr = (mo == mn) ? 1.0 : exp2(mo - mn);
            for (uint c = 0u; c < TILE; ++c) {
                stage[sBase + qi * (TILE * TILE) + r * TILE + c] = mn;
                bcorr[bBase + qi * (TILE * TILE) + r * TILE + c] = corr;
            }
        }
        barrier();

        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            ACC mrow, ccorr;
            coopMatLoad(mrow, stage, sBase + qq * (TILE * TILE), TILE, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(ccorr, bcorr, bBase + qq * (TILE * TILE), TILE, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                ACC p = s[qq][kk] - mrow;
                [[unroll]] for (uint e = 0u; e < p.length(); ++e) {
                    p[e] = exp2(p[e]);
                }
                coopMatStore(ACCH(p), pbuf, pBase + (qq * TILE) * BN + kk * TILE, BN,
                    gl_CooperativeMatrixLayoutRowMajor);
            }
            [[unroll]] for (uint j = 0u; j < HDT; ++j) {
                o[qq][j] = o[qq][j] * ccorr;
            }
            lsum[qq] = lsum[qq] * ccorr;
        }
        barrier();

        // Mask the pad keys and the future ones out of P, which is what
        // removes them from both O and the row sums. Without a selection only
        // the diagonal block needs it — every earlier block is entirely in the
        // past of every row — but the selection drops cells anywhere, so with
        // it on every block passes through here.
#ifdef GATHER
        // **One predicate, and it is the mask** (P14-2). The causal test is
        // already in it — the gather ANDed each row's own extent into the bits
        // it wrote — and the positions past this chunk's count carry a zero bit
        // for every row, so the `col >= cnt` test goes with it.
        for (uint i = lane; i < BM * BN; i += WAVE) {
            if (!selected(i / BN, i & (BN - 1u), selBit)) {
                pbuf[pBase + i] = float16_t(0.0);
            }
        }
        barrier();
#else
        if (sparse || cnt < BN || base + BN > past + q0) {
            for (uint i = lane; i < BM * BN; i += WAVE) {
                uint col = i & (BN - 1u);
                uint row = i / BN;
                if (col >= cnt || base + col > past + q0 + row ||
                    (sparse && !selected(row, col, selBit))) {
                    pbuf[pBase + i] = float16_t(0.0);
                }
            }
            barrier();
        }
#endif

        FRAG_A fragP[QT][KTIL];
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatLoad(fragP[qq][kk], pbuf, pBase + (qq * TILE) * BN + kk * TILE, BN,
                    gl_CooperativeMatrixLayoutRowMajor);
            }
        }
#ifdef GATHER
        stagePlane(tid, 0u, vBase, 0u, cnt);
#endif
        [[unroll]] for (uint j = 0u; j < HDT; ++j) {
            FRAG_B fragV[KTIL];
#ifdef GATHER
            if (j % GRP == 0u) {
                GSTAGE_BARRIER();
                if (j + GRP < HDT) {
                    stagePlane(tid, ((j / GRP) + 1u) & 1u, vBase, j + GRP, cnt);
                }
            }
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatLoad(fragV[kk], kvs[(j / GRP) & 1u],
                    (j % GRP) * GSTAGE + kk * (TILE * TILE),
                    TILE, gl_CooperativeMatrixLayoutRowMajor);
            }
#else
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                // **RowMajor, because the value plane is cell-major** (P14-2):
                // element (k=cell, n=dim) at `k*TILE + n`. It was ColumnMajor
                // over a transposed tile and is the same matrix either way —
                // see the note in llm_attn_pack.comp for why the layout moved.
                coopMatLoad(fragV[kk], hact, vBase + ((base / TILE + kk) * HDT + j) * (TILE * TILE),
                    TILE, gl_CooperativeMatrixLayoutRowMajor);
            }
#endif
            [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
                [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                    o[qq][j] = coopMatMulAdd(fragP[qq][kk], fragV[kk], o[qq][j]);
                }
            }
        }
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                lsum[qq] = coopMatMulAdd(fragP[qq][kk], ones, lsum[qq]);
            }
        }
        barrier();
      }
    }

#ifdef SPLITK
    // ---- The split epilogue: this slice's partial, and how to resume it.
    //
    // Nothing is normalised and nothing is gated here — `o` is still relative
    // to this slice's own row max and `lsum` is still this slice's own
    // denominator, because neither is the row's until every slice has been
    // seen. The combine does the divide and the gate, once, off the assembled
    // row. A slice that got no block writes -inf and zero, which is the
    // identity there.
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        coopMatStore(lsum[qq], stage, sBase + qq * (TILE * TILE), TILE,
            gl_CooperativeMatrixLayoutRowMajor);
    }
    barrier();
    for (uint i = lane; i < BM; i += WAVE) {
        uint qi = i / TILE, r = i % TILE;
        rowSum[rBase + i] = stage[sBase + qi * (TILE * TILE) + r * TILE];
    }
    barrier();

    // The partial arena, ATTN_SPLIT (llm_common.glsl): the contexts first,
    // [heads][splits][tokens][headDim], then the pair per row behind them.
    uint slice = (head * splits + sp) * pc.tokens;
    uint mlBase = pc.resOff + pc.heads * splits * pc.tokens * pc.headDim;
    for (uint i = lane; i < BM; i += WAVE) {
        uint token = q0 + i;
        if (token < pc.tokens) {
            uint at = mlBase + (slice + token) * 2u;
            act[at] = rowMax[rBase + i];
            act[at + 1u] = rowSum[rBase + i];
        }
    }
    barrier();

    [[unroll]] for (uint j = 0u; j < HDT; ++j) {
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            coopMatStore(o[qq][j], stage, sBase + qq * (TILE * TILE), TILE,
                gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();
        // Four lanes a row, four floats each, as the gated store below. The
        // pad rows are skipped rather than written: unlike the context arena
        // this one is read back by a kernel that knows how many rows are
        // real, so there is nothing for a pad row to keep clean.
        for (uint i = lane; i < BM * 4u; i += WAVE) {
            uint row = i / 4u, part = i % 4u;
            uint token = q0 + row;
            if (token >= pc.tokens) {
                continue;
            }
            uint qi = row / TILE, r = row % TILE;
            uint src = qi * (TILE * TILE) + r * TILE + part * 4u;
            uint dst = pc.resOff + (slice + token) * pc.headDim + j * TILE + part * 4u;
            [[unroll]] for (uint c = 0u; c < 4u; ++c) {
                act[dst + c] = stage[sBase + src + c];
            }
        }
        barrier();
    }
}
#else
    // ---- Epilogue: the softmax divide and the output gate, together.
    //
    // Every column of lsum holds the row sum, so column 0 is read out of a
    // staging tile. The output goes through the same tile rather than being
    // stored as a matrix, because the gate is indexed by (row, column) and a
    // cooperative matrix's element order is not defined — which is the same
    // reason the row max needed a staging tile.
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        coopMatStore(lsum[qq], stage, sBase + qq * (TILE * TILE), TILE,
            gl_CooperativeMatrixLayoutRowMajor);
    }
    barrier();
    for (uint i = lane; i < BM; i += WAVE) {
        uint qi = i / TILE, r = i % TILE;
        rowSum[rBase + i] = stage[sBase + qi * (TILE * TILE) + r * TILE];
    }
    barrier();

    uint gateCol = pc.qkvOff + head * 2u * pc.headDim + pc.headDim;
    [[unroll]] for (uint j = 0u; j < HDT; ++j) {
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            coopMatStore(o[qq][j], stage, sBase + qq * (TILE * TILE), TILE,
                gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();
        // Four lanes per row, four contiguous halves each. The rows past the
        // prompt are written too rather than branched around: they are the
        // output projection's pad rows, whose products nothing reads.
        for (uint i = lane; i < BM * 4u; i += WAVE) {
            uint row = i / 4u, part = i % 4u;
            uint token = q0 + row;
            uint qi = row / TILE, r = row % TILE;
            // A pad row sees nothing once the selection is on, and a row
            // that sees nothing has a zero denominator. Its products are
            // never read — it is the output projection's padding — but a NaN
            // there would be a NaN in an arena the next pass reuses, so it is
            // written as a zero row instead.
            float inv = (rowSum[rBase + row] > 0.0) ? 1.0 / rowSum[rBase + row] : 0.0;
            uint src = qi * (TILE * TILE) + r * TILE + part * 4u;
            uint d0 = j * TILE + part * 4u;
            uint dst = pc.ctxOff + token * pc.ldCtx + head * pc.headDim + d0;
            [[unroll]] for (uint c = 0u; c < 4u; ++c) {
                float g = act[gateCol + token * pc.gemmN + d0 + c];
                hact[dst + c] = float16_t(stage[sBase + src + c] * inv / (1.0 + exp(-g)));
            }
        }
        barrier();
    }
}
#endif
