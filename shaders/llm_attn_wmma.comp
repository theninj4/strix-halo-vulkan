#version 450

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

// Causal grouped-query flash attention on the matrix cores, with the output
// gate fused into its epilogue: the fourth of the full-attention layer's five
// dispatches (LLM.md L2f).
//
// The flash structure is dit_attention_wmma.comp's and this file does not
// re-litigate it — two cooperative-matrix GEMMs with an online softmax between
// them, Q held in registers across the whole key loop, the row max taken from
// a 16x16 fp32 staging tile because a cooperative matrix's element order is
// not defined, the rescale applied as a row-constant matrix, and the softmax
// denominator accumulated by appending a column of ones to V. It is a separate
// shader rather than another arm of that one because it lives in this
// vertical's binding contract (llm_common.glsl, which has a KV cache, an
// indexer and a gate where the DiT's has none of them), and because of the two
// things below.
//
// **The head dim is 256, not 128.** HDT doubles to 16, which doubles the query
// fragments held in registers and the output accumulators with them: at QT=1
// that is 16 A-fragments and 16 accumulators live across the key loop, and it
// is why the ladder here starts at QT=1 rather than at the DiT's QT=2. The
// arithmetic intensity argument is unchanged and was inert there anyway — what
// decides this ladder is the register file.
//
// **The gate is fused into the store.** `attn_q` is [2560, 12288]: each head's
// 256 query dims are immediately followed by 256 *gate* dims, and the gate is
// a sigmoid applied to the attention **output**, not to the query. llama.cpp
// spends a SIGMOID, a MUL and a CONT on it; here the epilogue already has the
// output tile in LDS for the 1/rowSum divide, so the gate costs one extra read
// of the fused projection's own fp32 row and the context leaves as fp16
// straight into the output projection's A layout. Three of llama.cpp's lines
// and a [T, 6144] round trip through DRAM, deleted.
//
// **The selection is a second mask, and a skip** (P7). `llm_attn_select.comp`
// writes one bit per cache cell per token, and this kernel reads it exactly
// where it reads the causal one: out of the block row max, so an unselected
// cell cannot set the scale, and out of P, which is what removes it from both
// O and the row sum. That much is what the reference does — `build_attn_qsa`
// turns `top_k` back into an f16 mask and runs **dense** flash attention over
// every cell — and on its own it is semantics and not a saving.
//
// So the mask is also read *before* the key block is, and a block with no
// selected cell in any row is skipped whole. The two are the same answer: an
// unselected cell contributes nothing to O and nothing to the row sum, so a
// block of them contributes nothing, and the skip is bit-identical rather
// than an approximation. What it changes is the **cost**, which is the reason
// QSA exists: a decode step names 2051 cells however deep the cache is, they
// fall in ~513 blocks of `ratio`, and at 64k of context four key blocks in
// five hold none of them. At prefill it is close to inert — at ~50% density a
// 32-cell block is eight indexer blocks and the chance all eight miss is
// ~0.4% (L4b-3) — which is why this is a decode optimisation and only that.
//
// `selOff == NO_W` is the dense path, and it is the honest one below 2051
// cells: at any prompt shorter than `top_k + ratio - 1` the selection names
// every cell (research/l2e-attention.md), so running it would be the identity
// and the branch is not an approximation.
//
// **The key range is split across workgroups at decode** (P8, `-DSPLITK`).
//
// The grid is (query blocks, heads), so a decode step — one token — dispatches
// one workgroup a head: 24 of them, each a *single wave*, and each walking
// every key block of the cache in turn. They all fit on the device at once,
// so the dispatch's wall clock is **one wave's serial walk** and nothing
// else: cutting the grid from 24 workgroups to 2 was measured at 1.00x, which
// is what says the cost is neither the traffic nor the occupancy across heads
// but the length of that walk. Adding heads cannot shorten it; only cutting
// the walk can.
//
// So this build slices the key axis `pc.injOff` ways (ATTN_SPLITS) and gives
// each slice its own workgroup — the grid's x becomes (query block, slice) —
// and each writes its slice's **unnormalised** context beside the two numbers
// an online softmax needs to be resumed: the slice's row max and its row sum.
// `llm_attn_combine.comp` puts them back together. That is flash-decoding's
// split, and it is exact in the same sense the block loop already is: the
// same partial-softmax identity that lets the loop rescale by exp2(mo - mn)
// when it meets a bigger max is what lets the combine rescale by
// exp2(m_s - m*) when it meets the largest of the slices'.
//
// It is **not bit-identical** to the unsplit kernel and cannot be: the
// rescales happen in a different order and fp32 addition is not associative.
// What it is is the same arithmetic, gated on agreement with the reference
// rather than with the other kernel — see TestAttnGPUSplitMatchesDense.
//
// **The query is a batch, the key and the value are a cache** (L7a). Row i of
// query block q0 is cell `SEQ_PAST + q0 + i` and the keys run over every cell
// the cache holds, `SEQ_PAST + tokens` of them, so the two operands no longer
// share a plane geometry: the query's is `plane` padded token rows, the key's
// and the value's are nKV cells. Every causal comparison is between a cell and
// a *position*, and on a fresh sequence SEQ_PAST is zero and all of it is
// what L2f measured.

#include "llm_common.glsl"

#ifndef QT
#define QT 1        // query tiles per wave
#endif
#ifndef KTIL
#define KTIL 4      // key tiles per block
#endif
#ifndef WAVE
#define WAVE 64
#endif
#ifndef HEAD_DIM
#define HEAD_DIM 256
#endif

#define TILE 16
#define HDT (HEAD_DIM / TILE)
#define BM (QT * TILE)
#define BN (KTIL * TILE)

layout(local_size_x = WAVE) in;

#define ACC  coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define ACCH coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define FRAG_A coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA>
#define FRAG_B coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB>

shared float stage[QT * TILE * TILE];
shared float16_t pbuf[BM * BN];
shared float bcorr[QT * TILE * TILE];
shared float rowMax[BM];
shared float blkMax[BM];
shared float rowSum[BM];
// This key block's slice of the QSA bitmask, one word per (row, 32 cells).
// It is staged once a block rather than bit-tested out of the arena per
// element: the mask loop below touches BM*BN elements and the row max another
// BM*TILE, which is 512 global reads a block where the block's whole mask is
// BM*BN/32 words. Reading it per element cost the kernel 1.90x.
shared uint selw[BM * (BN / 32)];
// Whether any row of this key block has any cell selected at all.
shared uint blkAny;

// stageSel loads this key block's slice of the QSA bitmask into LDS: one word
// per (row, 32 cells), read by both the row max and the mask loop below, and
// returns the OR of the words this lane staged — which is how the skip below
// learns whether the block has anything in it at all.
//
// `base` is a multiple of BN and BN a multiple of 32, so a word of the staged
// slice is a word of the arena and not a shift of one. A pad row has no
// selection — llm_attn_select.comp does not run past the prompt — so it stages
// as **zero**: nothing of it is visible, its softmax denominator is zero, and
// the epilogue turns that into a zero row rather than a NaN. (It used to stage
// all-ones and take the dense path for exactly that denominator; the skip
// below would then have been defeated by fifteen pad rows on every decode
// step, which is the one shape where the skip is worth anything.)
uint stageSel(uint lane, uint q0, uint base) {
    uint words = (pc.nKV + 31u) / 32u;
    uint acc = 0u;
    for (uint i = lane; i < BM * (BN / 32u); i += WAVE) {
        uint row = i / (BN / 32u), wd = i % (BN / 32u);
        uint token = q0 + row;
        uint w = (token >= pc.tokens) ? 0u
                                      : actu[pc.selOff + token * words + ((base + wd * 32u) >> 5u)];
        selw[i] = w;
        acc |= w;
    }
    return acc;
}

// selected reads one bit out of the staged slice.
bool selected(uint row, uint col) {
    return (selw[row * (BN / 32u) + (col >> 5u)] & (1u << (col & 31u))) != 0u;
}

void main() {
    uint head = gl_WorkGroupID.y;
#ifdef SPLITK
    // The grid's x carries both: `splits` slices of every query block, so
    // that a build which is not split keeps exactly the grid it had.
    uint splits = max(pc.injOff, 1u);
    uint sp = gl_WorkGroupID.x % splits;
    uint q0 = (gl_WorkGroupID.x / splits) * BM;
#else
    uint q0 = gl_WorkGroupID.x * BM;
#endif
    uint past = SEQ_PAST;
    uint n = past + pc.tokens;       // cells in the cache, keys to attend over
    uint lane = gl_LocalInvocationID.x;
    if (q0 >= pc.tokens || head >= pc.heads) {
        return;
    }
    bool sparse = pc.selOff != NO_W;

    uint qTiles = pc.plane / TILE;
    uint kvTiles = pc.nKV / TILE;
    uint plane = head * qTiles * (HDT * TILE * TILE);
    uint rep = max(pc.heads / max(pc.kvHeads, 1u), 1u);
    uint kvPlane = (head / rep) * kvTiles * (HDT * TILE * TILE);
    uint qBase = pc.qOff + plane + (q0 / TILE) * (HDT * TILE * TILE);
    uint kBase = pc.kOff + kvPlane;
    uint vBase = pc.vOff + kvPlane;

    FRAG_A fragQ[QT][HDT];
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        [[unroll]] for (uint kt = 0u; kt < HDT; ++kt) {
            coopMatLoad(fragQ[qq][kt], hact, qBase + (qq * HDT + kt) * (TILE * TILE),
                TILE, gl_CooperativeMatrixLayoutRowMajor);
        }
    }

    ACC o[QT][HDT];
    ACC lsum[QT];
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        [[unroll]] for (uint j = 0u; j < HDT; ++j) {
            o[qq][j] = ACC(0.0);
        }
        lsum[qq] = ACC(0.0);
    }
    for (uint i = lane; i < BM; i += WAVE) {
        rowMax[i] = -1.0 / 0.0;
    }
    barrier();

    const FRAG_B ones = FRAG_B(float16_t(1.0));

    // Nothing past this query block's last row can be attended to, so the key
    // blocks beyond it are never read. Its last row is cell `past + q0 + BM - 1`.
    uint last = min(n, past + q0 + BM);
#ifdef SPLITK
    // **Every `splits`-th block, not a contiguous run of them**, and that is
    // a correctness requirement rather than a preference.
    //
    // A slice has to be a set of *absolute* key blocks that does not depend
    // on how the prompt was chunked, because L7a's gate is that it does not:
    // token at cell `pos` must come back bit for bit whether it arrived alone
    // or seventh of seven. Cutting `[0, last)` into `splits` contiguous runs
    // fails that — `last` is `min(n, past + q0 + BM)` and both `n` and `q0`
    // are the batch's, so a seven-token chunk and a one-token chunk put the
    // boundaries in different places and fold the partial softmaxes in a
    // different order. A stride is immune: block b belongs to slice
    // `b % splits` however the run was cut.
    //
    // The blocks past a row's causal extent that the stride then walks cost
    // nothing and change nothing, for the same reason the unsplit loop can
    // walk them: blkMax stays -inf, the correction is exactly 1.0, and P is
    // zeroed, so the accumulators come out untouched. And the stride balances
    // the slices where a contiguous cut would not — the QSA selection is
    // clustered (P7), so contiguous runs would hand one slice most of the
    // live blocks and its neighbours none.
    //
    // A slice with no block at all — `sp >= ceil(last/BN)` — falls straight
    // through to the epilogue, which writes the combine's identity: a row max
    // of -inf and a row sum of zero.
    for (uint base = sp * BN; base < last; base += splits * BN) {
#else
    for (uint base = 0u; base < last; base += BN) {
#endif
        uint cnt = min(BN, n - base);

        // **The selection, before the block is read rather than after** (P7).
        // QSA names `top_k + ratio - 1` cells however deep the context is —
        // 2051 of them — and every other cell is masked out of both the row
        // max and P below, so a key block with nothing selected in it
        // contributes exactly nothing: blkMax stays -inf, the correction is
        // 1, and every element of P is zeroed. Skipping it is therefore
        // bit-identical, and it is the whole point of a sparse attention:
        // without this the kernel walked all `n` cells at every depth and the
        // selection bought semantics and no time at all (L4b-3). At a decode
        // step the 2051 cells fall in ~513 blocks of `ratio`, so at 64k of
        // context roughly four key blocks in five hold none of them.
        //
        // The staging has to move up here for it — it is the test — and it is
        // work this block was going to do anyway.
        if (sparse) {
            if (lane == 0u) {
                blkAny = 0u;
            }
            barrier();
            if (stageSel(lane, q0, base) != 0u) {
                atomicOr(blkAny, 1u);
            }
            barrier();
            if (blkAny == 0u) {
                continue;
            }
        }

        ACC s[QT][KTIL];
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                s[qq][kk] = ACC(0.0);
            }
        }
        [[unroll]] for (uint kt = 0u; kt < HDT; ++kt) {
            FRAG_B fragK[KTIL];
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatLoad(fragK[kk], hact, kBase + ((base / TILE + kk) * HDT + kt) * (TILE * TILE),
                    TILE, gl_CooperativeMatrixLayoutColumnMajor);
            }
            [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
                [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                    s[qq][kk] = coopMatMulAdd(fragQ[qq][kt], fragK[kk], s[qq][kk]);
                }
            }
        }

        // The row max of this block, with the causal mask applied to the *max*
        // and not only to P: a future key that set the scale would leave every
        // real key's exp2 underflowing once the gap passed ~24 in log2 units.
        for (uint i = lane; i < BM; i += WAVE) {
            blkMax[i] = -1.0 / 0.0;
        }
        barrier();
        [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
            [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
                coopMatStore(s[qq][kk], stage, qq * (TILE * TILE), TILE,
                    gl_CooperativeMatrixLayoutRowMajor);
            }
            barrier();
            for (uint i = lane; i < BM; i += WAVE) {
                uint qi = i / TILE, r = i % TILE;
                float mx = blkMax[i];
                for (uint c = 0u; c < TILE; ++c) {
                    uint cell = base + kk * TILE + c;
                    if (cell > past + q0 + i) {
                        break;      // and every c after it, the row is done
                    }
                    if (sparse && !selected(i, kk * TILE + c)) {
                        continue;   // unselected: it must not set the scale
                    }
                    mx = max(mx, stage[qi * (TILE * TILE) + r * TILE + c]);
                }
                blkMax[i] = mx;
            }
            barrier();
        }

        for (uint i = lane; i < BM; i += WAVE) {
            uint qi = i / TILE, r = i % TILE;
            float mo = rowMax[i];
            float mn = max(mo, blkMax[i]);
            rowMax[i] = mn;
            // exp2(-inf - m) is 0, so there is no first-block case. The equal
            // test is for the selection: a key block with nothing selected in
            // it leaves both maxima at -inf, and exp2(-inf - -inf) is a NaN
            // that would poison the accumulators for the rest of the row.
            float corr = (mo == mn) ? 1.0 : exp2(mo - mn);
            for (uint c = 0u; c < TILE; ++c) {
                stage[qi * (TILE * TILE) + r * TILE + c] = mn;
                bcorr[qi * (TILE * TILE) + r * TILE + c] = corr;
            }
        }
        barrier();

        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            ACC mrow, ccorr;
            coopMatLoad(mrow, stage, qq * (TILE * TILE), TILE, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(ccorr, bcorr, qq * (TILE * TILE), TILE, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                ACC p = s[qq][kk] - mrow;
                [[unroll]] for (uint e = 0u; e < p.length(); ++e) {
                    p[e] = exp2(p[e]);
                }
                coopMatStore(ACCH(p), pbuf, (qq * TILE) * BN + kk * TILE, BN,
                    gl_CooperativeMatrixLayoutRowMajor);
            }
            [[unroll]] for (uint j = 0u; j < HDT; ++j) {
                o[qq][j] = o[qq][j] * ccorr;
            }
            lsum[qq] = lsum[qq] * ccorr;
        }
        barrier();

        // Mask the pad keys and the future ones out of P, which is what
        // removes them from both O and the row sums. Without a selection only
        // the diagonal block needs it — every earlier block is entirely in the
        // past of every row — but the selection drops cells anywhere, so with
        // it on every block passes through here.
        if (sparse || cnt < BN || base + BN > past + q0) {
            for (uint i = lane; i < BM * BN; i += WAVE) {
                uint col = i & (BN - 1u);
                uint row = i / BN;
                if (col >= cnt || base + col > past + q0 + row ||
                    (sparse && !selected(row, col))) {
                    pbuf[i] = float16_t(0.0);
                }
            }
            barrier();
        }

        FRAG_A fragP[QT][KTIL];
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatLoad(fragP[qq][kk], pbuf, (qq * TILE) * BN + kk * TILE, BN,
                    gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        [[unroll]] for (uint j = 0u; j < HDT; ++j) {
            FRAG_B fragV[KTIL];
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                coopMatLoad(fragV[kk], hact, vBase + ((base / TILE + kk) * HDT + j) * (TILE * TILE),
                    TILE, gl_CooperativeMatrixLayoutColumnMajor);
            }
            [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
                [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                    o[qq][j] = coopMatMulAdd(fragP[qq][kk], fragV[kk], o[qq][j]);
                }
            }
        }
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            [[unroll]] for (uint kk = 0u; kk < KTIL; ++kk) {
                lsum[qq] = coopMatMulAdd(fragP[qq][kk], ones, lsum[qq]);
            }
        }
        barrier();
    }

#ifdef SPLITK
    // ---- The split epilogue: this slice's partial, and how to resume it.
    //
    // Nothing is normalised and nothing is gated here — `o` is still relative
    // to this slice's own row max and `lsum` is still this slice's own
    // denominator, because neither is the row's until every slice has been
    // seen. The combine does the divide and the gate, once, off the assembled
    // row. A slice that got no block writes -inf and zero, which is the
    // identity there.
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        coopMatStore(lsum[qq], stage, qq * (TILE * TILE), TILE,
            gl_CooperativeMatrixLayoutRowMajor);
    }
    barrier();
    for (uint i = lane; i < BM; i += WAVE) {
        uint qi = i / TILE, r = i % TILE;
        rowSum[i] = stage[qi * (TILE * TILE) + r * TILE];
    }
    barrier();

    // The partial arena, ATTN_SPLIT (llm_common.glsl): the contexts first,
    // [heads][splits][tokens][headDim], then the pair per row behind them.
    uint slice = (head * splits + sp) * pc.tokens;
    uint mlBase = pc.resOff + pc.heads * splits * pc.tokens * pc.headDim;
    for (uint i = lane; i < BM; i += WAVE) {
        uint token = q0 + i;
        if (token < pc.tokens) {
            uint at = mlBase + (slice + token) * 2u;
            act[at] = rowMax[i];
            act[at + 1u] = rowSum[i];
        }
    }
    barrier();

    [[unroll]] for (uint j = 0u; j < HDT; ++j) {
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            coopMatStore(o[qq][j], stage, qq * (TILE * TILE), TILE,
                gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();
        // Four lanes a row, four floats each, as the gated store below. The
        // pad rows are skipped rather than written: unlike the context arena
        // this one is read back by a kernel that knows how many rows are
        // real, so there is nothing for a pad row to keep clean.
        for (uint i = lane; i < BM * 4u; i += WAVE) {
            uint row = i / 4u, part = i % 4u;
            uint token = q0 + row;
            if (token >= pc.tokens) {
                continue;
            }
            uint qi = row / TILE, r = row % TILE;
            uint src = qi * (TILE * TILE) + r * TILE + part * 4u;
            uint dst = pc.resOff + (slice + token) * pc.headDim + j * TILE + part * 4u;
            [[unroll]] for (uint c = 0u; c < 4u; ++c) {
                act[dst + c] = stage[src + c];
            }
        }
        barrier();
    }
}
#else
    // ---- Epilogue: the softmax divide and the output gate, together.
    //
    // Every column of lsum holds the row sum, so column 0 is read out of a
    // staging tile. The output goes through the same tile rather than being
    // stored as a matrix, because the gate is indexed by (row, column) and a
    // cooperative matrix's element order is not defined — which is the same
    // reason the row max needed a staging tile.
    [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
        coopMatStore(lsum[qq], stage, qq * (TILE * TILE), TILE,
            gl_CooperativeMatrixLayoutRowMajor);
    }
    barrier();
    for (uint i = lane; i < BM; i += WAVE) {
        uint qi = i / TILE, r = i % TILE;
        rowSum[i] = stage[qi * (TILE * TILE) + r * TILE];
    }
    barrier();

    uint gateCol = pc.qkvOff + head * 2u * pc.headDim + pc.headDim;
    [[unroll]] for (uint j = 0u; j < HDT; ++j) {
        [[unroll]] for (uint qq = 0u; qq < QT; ++qq) {
            coopMatStore(o[qq][j], stage, qq * (TILE * TILE), TILE,
                gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();
        // Four lanes per row, four contiguous halves each. The rows past the
        // prompt are written too rather than branched around: they are the
        // output projection's pad rows, whose products nothing reads.
        for (uint i = lane; i < BM * 4u; i += WAVE) {
            uint row = i / 4u, part = i % 4u;
            uint token = q0 + row;
            uint qi = row / TILE, r = row % TILE;
            // A pad row sees nothing once the selection is on, and a row
            // that sees nothing has a zero denominator. Its products are
            // never read — it is the output projection's padding — but a NaN
            // there would be a NaN in an arena the next pass reuses, so it is
            // written as a zero row instead.
            float inv = (rowSum[row] > 0.0) ? 1.0 / rowSum[row] : 0.0;
            uint src = qi * (TILE * TILE) + r * TILE + part * 4u;
            uint d0 = j * TILE + part * 4u;
            uint dst = pc.ctxOff + token * pc.ldCtx + head * pc.headDim + d0;
            [[unroll]] for (uint c = 0u; c < 4u; ++c) {
                float g = act[gateCol + token * pc.gemmN + d0 + c];
                hact[dst + c] = float16_t(stage[src + c] * inv / (1.0 + exp(-g)));
            }
        }
        barrier();
    }
}
#endif
