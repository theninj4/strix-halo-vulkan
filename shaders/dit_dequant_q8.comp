#version 450

#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

// One int8 weight matrix expanded into the fp16 fragment tiles dit_gemm.comp
// reads (VIDEO.md M11a): how a model too big to hold in fp16 keeps its
// validated GEMMs. The bank is qwen.PackQ8's layout -- the LLM's L8 and
// Kev's K7.1 -- int8 in the fragment tiling (tile (nt, kt) is 256 bytes
// holding (k, n) at (n%16)*16 + k%16, tiles kt-fastest), then one fp16 scale
// per 32 k of a row, scale (nt, group, n%16) at (nt*kgroups + group)*16 + n%16.
// The output is the same tiling in halves, so a byte and its half sit at the
// same index and the kernel is a copy with a multiply in it.
//
// A value is float(q) * float(scale), which is exact in fp32 (8 bits by 11),
// rounded once to fp16: the halves are what the host's reference dequant
// gets, bit for bit (qwen.TestGPUDequantQ8).
//
//   pc.inOff   the matrix's first byte in the int8 bank, in uints
//   pc.wOff    its first scale, in halves (the scales follow the bytes)
//   pc.outOff  the destination, in halves (even)
//   pc.gemmN   n, a multiple of 16
//   pc.gemmK   k, a multiple of 64
//
// Grid (k/64, n/16): a workgroup is four consecutive tiles of one tile row,
// a thread one word of four k of one n.

#include "dit_common.glsl"

layout(binding = 2) readonly buffer Q8 { uint q8[]; };
layout(binding = 3) buffer Out { uint outw[]; };

layout(local_size_x = 256) in;

void main() {
    uint t = gl_LocalInvocationID.x;
    uint kts = pc.gemmK / 16u;
    uint nt = gl_WorkGroupID.y;
    uint kt = gl_WorkGroupID.x * 4u + t / 64u;
    uint lane = t % 64u;           // word within the tile
    uint nl = lane / 4u;           // the tile's column, i.e. n % 16
    uint tileIdx = nt * kts + kt;

    uint word = q8[pc.inOff + tileIdx * 64u + lane];
    uint s = pc.wOff + (nt * (pc.gemmK / 32u) + kt / 2u) * 16u + nl;
    uint sw = q8[s / 2u];
    float scale = unpackHalf2x16((s & 1u) != 0u ? (sw >> 16) : sw).x;

    vec4 v = vec4(
        float(bitfieldExtract(int(word), 0, 8)),
        float(bitfieldExtract(int(word), 8, 8)),
        float(bitfieldExtract(int(word), 16, 8)),
        float(bitfieldExtract(int(word), 24, 8))) * scale;
    uint o = pc.outOff / 2u + tileIdx * 128u + lane * 2u;
    outw[o] = packFloat2x16(f16vec2(v.xy));
    outw[o + 1u] = packFloat2x16(f16vec2(v.zw));
}
