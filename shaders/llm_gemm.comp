#version 450

#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_control_flow_attributes : enable

// The vertical's GEMM: one cooperative-matrix kernel, one epilogue per mode,
// because in this architecture the epilogue is where the time goes. LLM.md L2a
// put the hyper-connection block at over half of llama.cpp's prefill graph —
// 30.6% elementwise glue + 12.2% tiny-N F32 matmul + ~7% for its low-rank
// pair — and almost none of that is arithmetic.
//
//   MODE 0   [lowRank + hc, wide] * xn  ->  silu(lo/hc) fp16, and inject fp32
//   MODE 1   [wide, lowRank] * lo       ->  sigmoid, collapsed into mixed
//   MODE 2   [n, k] * a                 ->  C fp32, no epilogue at all
//
// MODE 2 is the plain one, and it exists for the PLE block's key and value
// projections — which read the same gathered n-gram embedding, so the host
// packs them as one [hc*nEmbd + nEmbd, nEmbd] weight for the same reason
// MODE 0 carries inject.
//
// MODE 0 is the fusion L2a costed. `w_inject` is a [10240, 4] F32 matrix
// applied to the *same* xn that `w_down` reads, and llama.cpp runs it as its
// own MUL_MAT: 95 dispatches a graph at 31.8 GFLOP/s, 0.06% of peak and
// **10.3% of prefill** for 15.6 MB of weights. Here it is four more output
// columns on a matrix that already has 320 — the host packs them as one
// [336, 10240] weight — so the tile whose columns start at lowRank is inject
// and every other tile is the gate's low-rank input. 320 is 20 tiles, so that
// split is on a tile boundary and costs a compare per tile, not a branch per
// element.
//
// MODE 1 is the one that keeps a tensor off DRAM. The gate is [10240, T] —
// 20.97 MB at 512 tokens, i.e. the whole MALL (L2a finding 5) — and nothing
// downstream ever wants it: it is consumed immediately by
// mixed[t][i] = mean_c(xn[t][c][i] * gate[t][c][i]). So the sigmoid and the
// 4-branch collapse run on the accumulators, and the kernel writes the 2560
// wide `mixed` instead of the 10240-wide gate. That needs the four streams of
// one feature to be in the same workgroup, which is a *layout*: the host
// permutes the up projection's output rows to (feature block, stream,
// feature) so a 64-column block is 16 features x 4 streams. See packUpB in
// llm/gpu.go.
//
// Everything else is the shape zimage/dit's GEMM ended on and this file does
// not re-litigate: 16x16x16 cooperative-matrix tiles, a WM x WN register
// accumulator grid, fp16 operands with fp32 accumulators, §2.3's padded
// leading dimension on the A operand, and B in the §2.8 fragment tiling
// (tile (nt, kt) is 256 contiguous halves holding element (k, n) at
// (n%16)*16 + k%16, kt fastest). It is a separate shader rather than another
// -D arm of dit_gemm.comp because both epilogues read a *second* activation
// tensor and one of them writes a narrower C than the GEMM computes — which
// is not an epilogue that file has a slot for, and it is the whole point of
// this one.
//
// No bounds checks, as everywhere else in this ladder: the host pads M up to
// BM and the arenas are zeroed once, so the pad rows carry the products of
// zeros and their outputs are ignored.
//
// **-DQ8B is L8's arm, and it is the same arithmetic.** The dense bank it
// reads is not halves: a weight is staged as the int8 the checkpoint already
// ships it as, with one fp16 scale per 32 elements of a row, so a token reads
// 8.5 bits a weight instead of 16 (LLM.md L8). A cooperative-matrix
// fragment's lane layout is not exposed, so the bytes cannot be unpacked into
// registers and declared a fragment — the slab goes through LDS exactly as
// llm_moe_gemm.comp's does, and for the same reason §2.2 gave. What is
// different here is that the scale of a 32-element group is constant across a
// sixteen-wide k-tile, so a whole `uvec4`'s worth of bytes takes one scale
// and the unpack is a byte extract, a convert and a multiply.
//
// The values it puts in LDS are **bit-identical** to the halves the fp16 arm
// reads, for every tensor the checkpoint stores as Q8_0 — which is every
// dense weight but the routers, the two indexer projections and three small
// gate matrices. ggml's Q8_0 picks d = amax/127, so the largest |q| in a
// block is 127 and re-deriving (d, q) from the dequantised floats returns the
// same pair; float(q) * float(d) is exact in f32 and rounding it to fp16 is
// what the host's tileB stored. TestBankQ8IsTheHalves pins it.

#include "llm_common.glsl"

#ifndef MODE
#define MODE 0
#endif
#ifndef WM
#define WM 4        // accumulator tiles, M direction
#endif
#ifndef WN
#define WN 4        // accumulator tiles, N direction; MODE 1 needs a multiple of 4
#endif
#ifndef BK_TILES
#define BK_TILES 2  // K-slab depth, in 16-wide cooperative-matrix steps
#endif
// The stream count is compiled in rather than read from pc.hc: MODE 1's
// collapse is a reduction over it *and* the weight permutation that puts the
// streams of one feature in one workgroup is cut on it, so a mismatch would
// be a wrong answer and not a slow one. The host checks the checkpoint says 4.
#ifndef HC_STREAMS
#define HC_STREAMS 4
#endif

#define TILE 16
#define BM (WM * TILE)
#define BN (WN * TILE)
#define BK (BK_TILES * TILE)
#define WAVE 64

layout(local_size_x = WAVE) in;

#ifdef Q8B
// §2.2's pad, and L5b's reason for its size: a slab row of BK + 8 halves
// keeps every row sixteen-byte aligned, which is what the cooperative-matrix
// load off LDS needs to take its wide path, and eight of the 32 banks is as
// good as a four-dword-aligned stride gets.
#define LDS_PAD 8
#define LDS_ROW (BK + LDS_PAD)
shared float16_t sQB[BN * LDS_ROW];
#endif

#define FRAG_A_T coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA>
#define FRAG_B_T coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB>
#define ACC_T coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define ACC16_T coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>

#if MODE == 1
#define A_BUF_OFF pc.loOff
#define A_LDA pc.ldaLo
// The gate tiles go through LDS on the way to the collapse. Storing the
// accumulator and reading it back with ordinary indexing is what lets the
// collapse pair a gate element with its xn element without depending on how
// the implementation maps matrix elements to lanes -- which the cooperative
// matrix extension does not define. It is 16 KB and one barrier.
shared float gateLDS[BM * BN];
#else
// MODE 0 and MODE 2 both read the fp16 A operand at xnOff: the hyper-
// connection block's normalised residual, and the PLE block's gathered
// embedding.
#define A_BUF_OFF pc.xnOff
#define A_LDA pc.lda
#endif

float sigmoidf(float x) { return 1.0 / (1.0 + exp(-x)); }

void main() {
    uint wn0 = gl_WorkGroupID.x * BN;
    uint wm0 = gl_WorkGroupID.y * BM;

    ACC_T acc[WM][WN];
    [[unroll]] for (uint i = 0u; i < WM; i++) {
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            acc[i][j] = ACC_T(0.0);
        }
    }

    uint ktiles = pc.gemmK / TILE;
#ifdef Q8B
    // The tiles are bytes at pc.bOff and the scale plane is the halves that
    // follow them, so its base is derivable and needs no field of its own —
    // which matters, because 64 uints is this device's whole push range and
    // the block has been full since L5b. A matrix is staged as exactly
    // gemmN x gemmK bytes.
    uint qw0 = pc.bOff >> 2;                       // the tiles, in words
    uint sc0 = (pc.bOff + pc.gemmN * pc.gemmK) >> 1;  // the plane, in halves
    uint kgroups = pc.gemmK >> 5;
    uint lane = gl_LocalInvocationID.x;
    uint nt0 = wn0 / TILE;
    // **Not every row of a fused matrix is Q8_0 in the checkpoint**, and the
    // ones that are not stay halves rather than being re-quantised: the
    // gated DeltaNet's F32 alpha and beta, the attention layer's BF16 indexer
    // projections, the hyper-connection block's F32 inject. They are the
    // *last* rows of their matrix in every case, so the split is one number —
    // `pc.lowRank`, which in MODE 0 already means exactly this — and the tail
    // is a fp16 fragment-tiled matrix of its own at `pc.gateOff`, numbered
    // from the split. A whole column block falls on one side or the other, so
    // the branch below is per workgroup and not per tile.
    bool tail = pc.gateOff != NO_W && wn0 >= pc.lowRank;
    uint tailNT = nt0 - pc.lowRank / TILE;
#endif
    // The reduction. On the Q8 arm it is written twice rather than branched
    // inside: the tail's B comes straight out of the fp16 bank as it always
    // did, the rest through LDS, and a compare in the k-loop cost 1.27x on
    // the DeltaNet's output projection — a matrix with no tail at all —
    // because the two `coopMatLoad`s in one loop body are register pressure
    // the ladder is already bound by (L2f-5, L3b-4).
#ifdef Q8B
    if (tail) {
        for (uint k0 = 0u; k0 < pc.gemmK; k0 += BK) {
            [[unroll]] for (uint kt = 0u; kt < BK_TILES; kt++) {
                FRAG_A_T fragA[WM];
                FRAG_B_T fragB[WN];
                [[unroll]] for (uint i = 0u; i < WM; i++) {
                    coopMatLoad(fragA[i], hact, A_BUF_OFF + (wm0 + i * TILE) * A_LDA + k0 + kt * TILE,
                        A_LDA, gl_CooperativeMatrixLayoutRowMajor);
                }
                [[unroll]] for (uint j = 0u; j < WN; j++) {
                    coopMatLoad(fragB[j], w16, pc.gateOff +
                        ((tailNT + j) * ktiles + (k0 + kt * TILE) / TILE) * (TILE * TILE),
                        TILE, gl_CooperativeMatrixLayoutColumnMajor);
                }
                [[unroll]] for (uint i = 0u; i < WM; i++) {
                    [[unroll]] for (uint j = 0u; j < WN; j++) {
                        acc[i][j] = coopMatMulAdd(fragA[i], fragB[j], acc[i][j]);
                    }
                }
            }
        }
    } else
#endif
    for (uint k0 = 0u; k0 < pc.gemmK; k0 += BK) {
#ifdef Q8B
        // Unpack this workgroup's BN x BK slab. A tile is 256 contiguous
        // bytes and the tiles of one n-tile are contiguous across kt, so the
        // WN runs below are each BK_TILES * 64 words long; within a tile a
        // word is four consecutive k of one output column, which is why one
        // scale serves it — a 32-element group is two whole k-tiles.
        uint kt0 = k0 / TILE;
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            uint wbase = qw0 + ((nt0 + j) * ktiles + kt0) * 64u;
            uint sbase = sc0 + (nt0 + j) * kgroups * TILE;
            for (uint u = lane; u < BK_TILES * 64u; u += WAVE) {
                uint kt = u >> 6;
                uint b = (u & 63u) << 2;           // byte within the tile
                uint n = b >> 4;                   // 0..15, the output column
                uint kk = b & 15u;                 // 0..15, four consecutive k
                uint word = w8[wbase + u];
                float d = float(w16[sbase + ((kt0 + kt) >> 1) * TILE + n]);
                uint dst = (j * TILE + n) * LDS_ROW + kt * TILE + kk;
                [[unroll]] for (uint t = 0u; t < 4u; t++) {
                    sQB[dst + t] = float16_t(float(bitfieldExtract(int(word), int(t * 8u), 8)) * d);
                }
            }
        }
        barrier();
#endif
        [[unroll]] for (uint kt = 0u; kt < BK_TILES; kt++) {
            FRAG_A_T fragA[WM];
            FRAG_B_T fragB[WN];
            [[unroll]] for (uint i = 0u; i < WM; i++) {
                coopMatLoad(fragA[i], hact, A_BUF_OFF + (wm0 + i * TILE) * A_LDA + k0 + kt * TILE,
                    A_LDA, gl_CooperativeMatrixLayoutRowMajor);
            }
            [[unroll]] for (uint j = 0u; j < WN; j++) {
#ifdef Q8B
                coopMatLoad(fragB[j], sQB, (j * TILE) * LDS_ROW + kt * TILE, LDS_ROW,
                    gl_CooperativeMatrixLayoutColumnMajor);
#else
                coopMatLoad(fragB[j], w16, pc.bOff +
                    (((wn0 + j * TILE) / TILE) * ktiles + (k0 + kt * TILE) / TILE) * (TILE * TILE),
                    TILE, gl_CooperativeMatrixLayoutColumnMajor);
#endif
            }
            [[unroll]] for (uint i = 0u; i < WM; i++) {
                [[unroll]] for (uint j = 0u; j < WN; j++) {
                    acc[i][j] = coopMatMulAdd(fragA[i], fragB[j], acc[i][j]);
                }
            }
        }
#ifdef Q8B
        barrier();
#endif
    }

#if MODE == 0
    // Down and inject in one store pass. The gate's branch gets silu(x/hc)
    // applied on the accumulator and is narrowed into the fp16 arena as the
    // next matmul's A operand; inject's single tile is written fp32, because
    // it is read by the combine as a scalar per stream and never by a
    // fragment load.
    float invHC = 1.0 / float(pc.hc);
    uint injStride = pc.gemmN - pc.lowRank;
    [[unroll]] for (uint i = 0u; i < WM; i++) {
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            uint n0 = wn0 + j * TILE;
            uint m0 = wm0 + i * TILE;
            if (n0 < pc.lowRank) {
                ACC16_T lo;
                [[unroll]] for (uint e = 0u; e < acc[i][j].length(); e++) {
                    float v = float(acc[i][j][e]) * invHC;
                    lo[e] = float16_t(v * sigmoidf(v));
                }
                coopMatStore(lo, hact, pc.loOff + m0 * pc.ldaLo + n0, pc.ldaLo,
                    gl_CooperativeMatrixLayoutRowMajor);
            } else {
                coopMatStore(acc[i][j], act, pc.injOff + m0 * injStride + (n0 - pc.lowRank),
                    injStride, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
    }
#elif MODE == 2
    // No epilogue: C straight out, fp32, row stride gemmN.
    [[unroll]] for (uint i = 0u; i < WM; i++) {
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            coopMatStore(acc[i][j], act,
                pc.outOff + (wm0 + i * TILE) * pc.gemmN + wn0 + j * TILE, pc.gemmN,
                gl_CooperativeMatrixLayoutRowMajor);
        }
    }
#else
    // The gate, then the collapse, with the 10240-wide tensor never leaving
    // the workgroup.
    [[unroll]] for (uint i = 0u; i < WM; i++) {
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            ACC_T g;
            [[unroll]] for (uint e = 0u; e < acc[i][j].length(); e++) {
                g[e] = sigmoidf(float(acc[i][j][e]));
            }
            coopMatStore(g, gateLDS, (i * TILE) * BN + j * TILE, BN,
                gl_CooperativeMatrixLayoutRowMajor);
        }
    }
    barrier();

    // Column n of this block is (feature block, stream, feature) by the host's
    // permutation, so the four streams of one feature are 16 columns apart
    // inside the same 64-column group. One output is a dot product of length
    // hc over a gate row in LDS and an xn row in the fp16 arena.
    uint blocks = BN / (TILE * HC_STREAMS);  // feature blocks this workgroup covers
    uint outs = BM * blocks * TILE;
    float invHC = 1.0 / float(pc.hc);
    uint wide = pc.hc * pc.nEmbd;
    for (uint p = gl_LocalInvocationID.x; p < outs; p += WAVE) {
        uint r = p % TILE;                   // feature inside its block; fastest, so
        uint fb = (p / TILE) % blocks;       // consecutive lanes read consecutive halves
        uint m = p / (TILE * blocks);
        uint t = wm0 + m;
        uint feat = (wn0 / (TILE * HC_STREAMS) + fb) * TILE + r;
        uint gbase = m * BN + fb * (TILE * HC_STREAMS) + r;
        uint xbase = pc.xnOff + t * pc.lda + feat;
        float sum = 0.0;
        [[unroll]] for (uint c = 0u; c < HC_STREAMS; c++) {
            float gv = gateLDS[gbase + c * TILE];
            sum += gv * float(hact[xbase + c * pc.nEmbd]);
            if (pc.gateOff != NO_W) {
                act[pc.gateOff + t * wide + c * pc.nEmbd + feat] = gv;
            }
        }
        act[pc.outOff + t * pc.nEmbd + feat] = sum * invHC;
    }
#endif
}
