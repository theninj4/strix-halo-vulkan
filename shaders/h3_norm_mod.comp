#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// MiniMax-H3's modulated pre-norm (VIDEO.md M7): an RMS norm, then the
// block's AdaLN modulation, narrowed into the fp16 arena as a GEMM A operand.
//
//   out = x * rsqrt(mean(x^2) + eps) * a + b
//
// with a = norm.weight * (1 + scale) and b = shift folded on the host, one
// pair of vectors per *run* of rows that share a modulation row (a
// (timestep, modality) pair): the packed sequence is [text | keyframes |
// audio | video], so a forward has at most four runs and each is one
// dispatch of this shader with its own pc.aux0 (a) and pc.aux1 (b), both in
// the fp32 activation arena where the per-step tables are uploaded.
//
// The same shader with a = weight, b = 0 is the token refiner's plain norm.
//
// One workgroup per row; one reduction, since an RMS norm has no mean.
#include "dit_common.glsl"

layout(binding = 2) writeonly buffer HAct { float16_t hact[]; };

#extension GL_EXT_control_flow_attributes : enable
#define WG 256
// HOIST (KERNELS.md G6, research §5.4): the row's loads -- x and the two
// modulation vectors -- all issued before anything waits on one, and kept in
// registers for the store loop. A `for (c = t; c < pc.dim; c += WG)` loop is
// not unrolled (the width is a push constant), so it is one 256-byte request
// in flight a wave and a second trip through the row. Worth little where the
// rows come off DRAM and up to 1.6x where they fit the MALL (a short clip, a
// refiner, a decode row). STEPS bounds the width at STEPS * 256 (6144; H3's
// 5376 is the widest host). HOIST=0 is the control.
#ifndef HOIST
#define HOIST 1
#endif
#define STEPS 24
layout(local_size_x = WG) in;
shared float partial[WG];

void main() {
    uint r = gl_WorkGroupID.x;
    if (r >= pc.tokens) {
        return;
    }
    uint t = gl_LocalInvocationID.x;
    uint src = pc.inOff + r * pc.dim;
    uint dst = pc.outOff + r * pc.lda;
    float s = 0.0;
#if HOIST
    float x[STEPS], ga[STEPS], gb[STEPS];
    [[unroll]] for (uint j = 0u; j < STEPS; j++) {
        uint c = t + j * WG;
        if (c < pc.dim) {
            x[j] = act[src + c];
            ga[j] = act[pc.aux0 + c];
            gb[j] = act[pc.aux1 + c];
        }
    }
    [[unroll]] for (uint j = 0u; j < STEPS; j++) {
        if (t + j * WG < pc.dim) {
            s += x[j] * x[j];
        }
    }
#else
    for (uint c = t; c < pc.dim; c += WG) {
        float v = act[src + c];
        s += v * v;
    }
#endif
    partial[t] = s;
    barrier();
    for (uint step = WG / 2u; step > 0u; step >>= 1) {
        if (t < step) {
            partial[t] += partial[t + step];
        }
        barrier();
    }
    float inv = inversesqrt(partial[0] / float(pc.dim) + uintBitsToFloat(pc.eps));
#if HOIST
    [[unroll]] for (uint j = 0u; j < STEPS; j++) {
        uint c = t + j * WG;
        if (c < pc.dim) {
            hact[dst + c] = float16_t(x[j] * inv * ga[j] + gb[j]);
        }
    }
#else
    for (uint c = t; c < pc.dim; c += WG) {
        hact[dst + c] = float16_t(act[src + c] * inv * act[pc.aux0 + c] + act[pc.aux1 + c]);
    }
#endif
}
