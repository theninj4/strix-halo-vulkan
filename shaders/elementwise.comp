#version 450

#ifdef PRECISION_F16
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#endif

layout(local_size_x = 256) in;

#ifdef PRECISION_F16
layout(binding = 0) buffer Data { float16_t values[]; };
#else
layout(binding = 0) buffer Data { float values[]; };
#endif

// op: 0=add const, 1=mul const, 2=relu, 3=silu
layout(push_constant) uniform PC {
    uint count;
    uint op;
    float c;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.count) {
        return;
    }

#ifdef PRECISION_F16
    float v = float(values[idx]);
#else
    float v = values[idx];
#endif

    float r;
    if (pc.op == 0u) {
        r = v + pc.c;
    } else if (pc.op == 1u) {
        r = v * pc.c;
    } else if (pc.op == 2u) {
        r = max(v, 0.0);
    } else {
        float sg = 1.0 / (1.0 + exp(-v));
        r = v * sg;
    }

#ifdef PRECISION_F16
    values[idx] = float16_t(r);
#else
    values[idx] = r;
#endif
}
