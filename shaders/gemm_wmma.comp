#version 450

#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_control_flow_attributes : enable

// C = A * B, fp16 in / fp32 accumulate, via VK_KHR_cooperative_matrix —
// but register-blocked, which is the whole point of this file versus
// gemm_coopmat_fp16.comp. That kernel gives each wave a *single* 16x16
// accumulator and reloads A and B from global memory every K-step, so it
// does 2*16*16*16 flops per (16+16)*16*2 bytes = 8 FLOP/byte. Saturating
// this chip's measured 55.5 TFLOP/s of WMMA against its 236 GB/s of DRAM
// needs ~235 FLOP/byte, and it duly measures 4.2-4.9 TFLOP/s — 9% of the
// matrix cores, starved on memory rather than limited by MMA issue
// (IDEAS.md §2.1).
//
// Five independently switchable changes, so the ablation is measurable
// rather than assumed. Which of them actually won on this part is not what
// the conventional wisdom predicts — see the notes after the list.
//
//   1. Register blocking (always on). Each wave holds a WM x WN grid of
//      16x16 fp32 accumulators and, per K-step, loads WM A-fragments and
//      WN B-fragments, then issues WM*WN MMAs against them. Intensity goes
//      from 8 to 16*WM*WN/(WM+WN) FLOP/byte — 32 at WM=WN=4.
//   2. LDS staging (USE_LDS=1). WAVES_M x WAVES_N waves cooperate on one
//      BM x BN workgroup tile, staging each slab of A and B into shared
//      memory once per K-step, so the global traffic is amortised over
//      every wave in the workgroup as well as every accumulator in the
//      wave. Intensity becomes 16*BM*BN/(BM+BN) — 64 at BM=BN=128.
//   3. Double-buffered LDS (DOUBLE_BUFFER=1, requires USE_LDS). The next
//      K-slab's global loads are issued into registers *before* the current
//      slab's MMAs and written to the other LDS buffer after them, so there
//      is one barrier per K-step instead of two and the global load latency
//      sits underneath the matrix work instead of in front of it.
//   4. B stored [N,K] and loaded column-major (B_COLMAJOR=1). Not a tiling
//      change but a codegen one. RADV's coopMatLoad emits two
//      `buffer_load_b128` for a *row-major A* operand and a *column-major B*
//      operand, but **sixteen scalar `buffer_load_d16_b16`** for the other
//      two combinations — the hardware WMMA operand layout is K-contiguous
//      for both operands, so the conventional [K,N] row-major B has to be
//      gathered element by element. This halves the loop's instruction count
//      (577 -> 389 at WM=WN=4, of which address arithmetic 232 -> 144) and is
//      also how a real `Linear` weight already sits in memory.
//   5. Hoisted K-tile loads (HOIST_A / HOIST_B). One operand's fragment loads
//      for the *whole* K-slab are issued before the slab's first MMA, instead
//      of one K-tile's worth at a time. Not a tiling change and not a codegen
//      one: the byte set, the instruction counts, the tile and the
//      accumulator grid are all identical to BK_TILES on its own. What moves
//      is how much of each row the wave has outstanding at one moment — 32 B
//      per K-tile in flight — which IDEAS §5.1b's mechanism 3 measured as the
//      quantity the memory system actually prices.
//
// What the measurements said (N=4096, against a measured 55.5 TFLOP/s WMMA
// ceiling; see IDEAS.md §2.1 for the full table):
//
//   - Register blocking is the entire win: 4.19 -> 12.2 -> 24.3 TFLOP/s as
//     intensity goes 8 -> 16 -> 32, because at AI 16 and 32 the kernel sits
//     pinned at ~760 of the 805 GB/s this chip's 32 MiB MALL delivers, so
//     every doubling of reuse doubles throughput out of a fixed budget. The
//     plateau is ~25.2 TFLOP/s, 45% of the ceiling.
//   - LDS staging *loses* here. Whether the waves are grouped into a
//     workgroup barely matters — WM=4,WN=8 at one wave and WAVES=2x2 at four
//     tie within noise — but every USE_LDS=1 variant is behind, the best by
//     1.2x. They are nowhere near bandwidth-bound (149-332 GB/s of 805);
//     they are bound by their own shared-memory reads and barriers, and the
//     MALL was already supplying the cross-wave reuse that staging exists to
//     provide. Expect this to invert on a discrete part with a small L2.
//   - Double buffering does work: 17.2 -> 21.2 TFLOP/s on the LDS path. Just
//     not enough to make that path competitive.
//   - B_COLMAJOR is **2.8x slower** at N=4096 (8.5 vs 24.3 TFLOP/s) despite
//     the better instruction stream, and *faster* at N=512 — it degrades
//     exactly as B stops being cache-resident, so it is a memory-system
//     effect on a strided gather. Deepening the K-slab so each 128-byte
//     cache line is fully consumed within one MMA block does not help, which
//     rules out partial-line consumption.
//
// Both operands' leading dimensions are therefore push constants of their
// own (`pc.lda`, `pc.ldb`) rather than K and N: that makes each row stride
// paddable at run time while the extents stay powers of two, which is how
// IDEAS §2.3's one remaining hypothesis — channel/bank aliasing between the
// 16 addresses one fragment load issues inside a single instruction, all
// `ld*2` bytes apart — gets tested without recompiling the shader. Pads must
// be a multiple of 8 halves to keep every row 16-byte aligned; otherwise
// coopMatLoad loses the `buffer_load_b128` this layout exists to get.
//
// **That hypothesis is now confirmed, and it is the dominant term.** Padding
// B's stride by 256 B takes `wmma_reg64_bt` from 8618 to 14028 GFLOP/s at
// N=4096 (1.63x), and the effect is periodic in the stride with a 2 KB
// period: strides at 0 mod 2 KB (8192, 10240, 12288 B) all measure
// 8.6-9.9 TFLOP/s, everything off-multiple measures 11.7-14.0, peaking 256 B
// past a multiple. 2 KB is exactly one interleave rotation of
// eight 256 B channel chunks, so a K-strided fragment load at a
// power-of-two stride puts all 16 of its addresses in one channel. The same
// pad on a row-major B (`wmma_reg64_pad64`, whose B fragments are gathered
// element by element instead) changes nothing — 23538 GFLOP/s against the
// unpadded kernel's 24530, which itself spans 23.5-24.9 across runs — so it is
// the strided gather that is being fixed, not the addresses in general.
//
// And because A is K-strided in every variant here, the same pad on A alone
// speeds up the kernels that already won: `wmma_reg64` 20216 -> 27260 at
// N=2048 (1.35x — the N=2048 dip in every unpadded row was this), and
// `wmma_wg128x256` 25331 -> 26008 at N=4096, where the gain is only 0-5% and
// kernel-dependent. With both strides padded, the transposed-B kernel is the
// fastest in the suite at N=1024 (28377, 51% of the ceiling)
// and still loses at N=4096, so the footprint-dependent part of the effect
// is something else; IDEAS §2.3 and §5.1b carry that residue.
//
// **That residue was the fifth axis, and closing it reversed the comparison.**
// A 16x16 fp16 fragment load holds 32 B of each row it touches, and a tiled
// kernel's waves retire after one — so the contiguous run these kernels have
// in flight is an eighth of the `gcd` even a padded stride leaves, which is
// the regime IDEAS §5.1b's mechanism 3 measured a 4-8x in. HOIST_A/HOIST_B
// raise it: `wmma_reg64_bt_hka4_padab128` reaches **38990 GFLOP/s at N=2048,
// 70% of the ceiling**, and at N=4096 the transposed-B kernel goes from 15697
// to 30609, *past* row-major's 24466. The [N,K] layout is now the fast one at
// every size.
//
// What makes that attributable rather than merely true is the control that
// was already here: `_bt_k64` is BK_TILES=4 with no hoisting — the same 64
// `buffer_load_b128` and 64 `v_wmma` per loop body, the same bytes — and
// RADV_DEBUG=asm shows the scheduler leaving **16** loads outstanding before
// the first s_waitcnt against the hoisted kernel's **45**. 8734 vs 18363
// GFLOP/s unpadded. Slab depth on its own does nothing and never did; what
// the register array buys is concurrency. Note also what stops it: an
// accumulator costs ~8 VGPRs on wave64 and a fragment ~4, so hoisting both
// operands at BK_TILES=4 spills (140 VGPRs, 3 KB scratch) and at BK_TILES=8
// ruinously (380-488, 70 KB). The ceiling on this lever is the 256-VGPR
// wave64 budget, which is why IDEAS §6.2 (wave32) is now the next item.
//
// Tile geometry is compile-time (glslc -D), not specialization constants:
// the accumulator grid sizes a register array and the LDS slabs size
// `shared` arrays, both of which must be known to the front end. The 16x16x16
// cooperative-matrix shape is likewise hard-coded, because it is the *only*
// shape this device reports (every entry of
// VkPhysicalDeviceCooperativeMatrixPropertiesKHR is 16x16x16); the Go side
// checks that and skips these variants if it ever stops being true.
//
// Wave size is a -D like the tile geometry, because it sizes `local_size_x`
// and the front end needs that as a literal. 64 is this device's default for a
// coopmat compute shader (RADV_DEBUG=asm confirmed it, IDEAS §6.1); building
// with -DWAVE=32 only changes how many threads a workgroup declares, so the
// *host* must also pin the pipeline to that size with
// VK_EXT_subgroup_size_control's requiredSubgroupSize, or the driver will pack
// two 32-wide waves' worth of tiles into one 32-thread workgroup and the
// wave -> tile mapping below overlaps. The bench passes them together
// (IDEAS §6.2), and the correctness pass fails loudly if they ever disagree.
//
// Why it is worth an axis at all: the register file is per lane, so the same
// accumulator grid and the same hoisted K-slab cost a *different* number of
// VGPRs at each wave size, and §2.7 ended on exactly that cliff — the best
// lever in the file stops at rung 4 because hoisting both operands spills.

#ifndef WM
#define WM 4        // accumulator tiles per wave, M direction
#endif
#ifndef WN
#define WN 4        // accumulator tiles per wave, N direction
#endif
#ifndef WAVES_M
#define WAVES_M 1   // waves per workgroup, M direction
#endif
#ifndef WAVES_N
#define WAVES_N 1   // waves per workgroup, N direction
#endif
#ifndef BK_TILES
#define BK_TILES 1  // K-slab depth, in 16-wide cooperative-matrix steps
#endif
#ifndef USE_LDS
#define USE_LDS 0
#endif
#ifndef DOUBLE_BUFFER
#define DOUBLE_BUFFER 0
#endif
#ifndef B_COLMAJOR
#define B_COLMAJOR 0
#endif
// Hoisting: issue a whole K-slab's fragment loads for this operand before the
// slab's first MMA, so a wave has BK_TILES*32 bytes of each row it touches
// outstanding at once instead of 32 (IDEAS §5.1b mechanism 3). Per operand,
// because the register file is the binding constraint: at WM=WN=4 a hoisted
// operand costs BK_TILES*W*4 VGPRs on top of the 128 the accumulators already
// hold, and hoisting both at BK_TILES>=4 spills.
#ifndef HOIST_A
#define HOIST_A 0
#endif
#ifndef HOIST_B
#define HOIST_B 0
#endif
#define HOIST (HOIST_A || HOIST_B)
#ifndef LDS_PAD
#define LDS_PAD 0   // extra halves per LDS row, to skew the bank mapping
#endif
// Grouped / MoE mode (IDEAS §3.5). The kernel is unchanged below the tile
// origin: what moves is where the origin comes from. Instead of deriving it
// from gl_WorkGroupID, each workgroup reads one uvec4 out of a tile table —
// (row in the gathered activations, row in the expert-major weight bank,
// column in the output) — so a *single* dispatch can cover every expert's
// tiles at once, with each expert's B living at a different offset in one
// buffer. Every group is padded up to BM rows by the host, so no masking is
// needed and the padding is charged to the measurement rather than hidden.
//
// Only the B_COLMAJOR layout is built grouped: an expert bank is [E*N, K],
// which is how the weights already sit, and the row-major arm would need a
// different offset per K-step.
#ifndef GROUPED
#define GROUPED 0
#endif

#define TILE 16
#ifndef WAVE
#define WAVE 64     // threads per wave; see the note above — the host must agree
#endif

#define BM (WAVES_M * WM * TILE)
#define BN (WAVES_N * WN * TILE)
#define BK (BK_TILES * TILE)
#define NWAVES (WAVES_M * WAVES_N)
#define NTHREADS (NWAVES * WAVE)

layout(local_size_x = NTHREADS) in;

// With LDS staging the slabs are filled with 128-bit loads (IDEAS §1.3 found
// wide loads worth 1.17x on the W4A8 GEMV), so those two bindings are
// declared as uvec4 and reinterpreted on the way into shared memory. Without
// staging, coopMatLoad reads the buffers directly and needs them typed as
// their component type.
#if USE_LDS
layout(binding = 0) readonly buffer A { uvec4 a4[]; };
layout(binding = 1) readonly buffer B { uvec4 b4[]; };
#else
layout(binding = 0) readonly buffer A { float16_t a[]; };
layout(binding = 1) readonly buffer B { float16_t b[]; };
#endif
layout(binding = 2) readonly buffer Scales { float dummy[]; }; // unused, kept for a uniform 4-binding layout
layout(binding = 3) writeonly buffer C { float c[]; };
#if GROUPED
// One entry per workgroup: .x the tile's first row in A and C, .y its first
// row in the [E*N, K] weight bank, .z its first column in C. .w is unused
// padding, which is also what keeps the entry 16-byte aligned so the whole
// table is one vector load per workgroup.
layout(binding = 4) readonly buffer Tiles { uvec4 tiles[]; };
#endif

layout(push_constant) uniform PC {
    uint M;
    uint N;
    uint K;
    uint block;
    // Leading dimension of B in elements, i.e. the distance between
    // consecutive rows of however B is stored: K + pad for the [N,K]
    // column-major layout, N + pad for the [K,N] row-major one. Separate
    // from K and N so the *stride* can be padded while the *extents* stay
    // powers of two, which is what IDEAS §2.3's channel/bank-aliasing
    // hypothesis needs: a column-major fragment load issues 16 addresses
    // ldb*2 bytes apart inside one instruction, and every K swept here is a
    // power of two, so without a separate stride every one of those 16
    // addresses lands in the same DRAM channel and bank.
    uint ldb;
    // Leading dimension of A, same idea: A is [M, K + pad], K-contiguous.
    // A's fragment loads are the *same* shape of strided gather as the
    // column-major B ones — 16 rows, K*2 bytes apart, inside one
    // instruction — so every variant here is exposed to the aliasing, not
    // just the _bt ones.
    uint lda;
#if GROUPED
    // First tile-table entry this dispatch covers. Zero for the grouped
    // launch, which takes the whole table in one go; the per-expert baseline
    // (IDEAS §3.5) walks it one expert's slice at a time, so that the two
    // arms differ in their dispatch count and in nothing else.
    uint tileBase;
#endif
} pc;

#if USE_LDS
// The A slab is always [BM rows][BK], K-contiguous. The B slab is [BN][BK]
// when B is stored [N,K], and [BK][BN] otherwise — in both cases laid out so
// the staging loads are contiguous in memory, which is what makes them 128-bit.
#define LDS_A_ROWS BM
#define LDS_A_STRIDE (BK + LDS_PAD)
#if B_COLMAJOR
#define LDS_B_ROWS BN
#define LDS_B_STRIDE (BK + LDS_PAD)
#else
#define LDS_B_ROWS BK
#define LDS_B_STRIDE (BN + LDS_PAD)
#endif

#define LDS_A_PLANE (LDS_A_ROWS * LDS_A_STRIDE)
#define LDS_B_PLANE (LDS_B_ROWS * LDS_B_STRIDE)
#if DOUBLE_BUFFER
#define LDS_PLANES 2
#else
#define LDS_PLANES 1
#endif

shared float16_t ldsA[LDS_PLANES * LDS_A_PLANE];
shared float16_t ldsB[LDS_PLANES * LDS_B_PLANE];

// One uvec4 is 8 halves. These expand to eight scalar stores in source, but
// the compiler coalesces them back into one ds_store_b128 (verified in the
// disassembly), so the shared arrays can stay typed as float16_t — which is
// what coopMatLoad requires.
#define SPREAD8(arr, base, v) {                       \
    f16vec2 h0 = unpackFloat2x16((v).x);              \
    f16vec2 h1 = unpackFloat2x16((v).y);              \
    f16vec2 h2 = unpackFloat2x16((v).z);              \
    f16vec2 h3 = unpackFloat2x16((v).w);              \
    arr[(base) + 0u] = h0.x; arr[(base) + 1u] = h0.y; \
    arr[(base) + 2u] = h1.x; arr[(base) + 3u] = h1.y; \
    arr[(base) + 4u] = h2.x; arr[(base) + 5u] = h2.y; \
    arr[(base) + 6u] = h3.x; arr[(base) + 7u] = h3.y; \
}

// Element index in B of the staging load for slab row r, K-slab kk, column
// col. A #if rather than a ternary because both arms are real loads: GLSL's
// ?: is not short-circuit, so the unused arm would be an out-of-range global
// read if the compiler ever declined to fold the constant condition.
#if B_COLMAJOR
// slab row r is output column n0+r, contiguous along K
#define B_SLAB_ELEM(r, kk, col) ((n0 + (r)) * pc.ldb + (kk) + (col))
#else
// slab row r is reduction index kk+r, contiguous along N
#define B_SLAB_ELEM(r, kk, col) (((kk) + (r)) * pc.ldb + n0 + (col))
#endif

// One slab row is BK halves wide for A, and for B too once B is stored [N,K].
#define A_VECS_PER_ROW (BK / 8u)
#define A_VECS (LDS_A_ROWS * A_VECS_PER_ROW)
#if B_COLMAJOR
#define B_VECS_PER_ROW (BK / 8u)
#else
#define B_VECS_PER_ROW (BN / 8u)
#endif
#define B_VECS (LDS_B_ROWS * B_VECS_PER_ROW)

// 128-bit loads per thread needed to cover one slab. Held in registers between
// LOAD_STAGE and STORE_STAGE, which is what lets the two straddle the MMAs.
#define A_STAGE ((A_VECS + NTHREADS - 1u) / NTHREADS)
#define B_STAGE ((B_VECS + NTHREADS - 1u) / NTHREADS)

// Global -> registers for the slab starting at reduction index kk. Deliberately
// separate from STORE_STAGE: the compiler sinks the s_waitcnt to the first use
// of stageA/stageB, so with DOUBLE_BUFFER the memory latency is spent on the
// MMAs issued in between rather than stalling at a barrier.
#define LOAD_STAGE(kk) {                                                       \
    [[unroll]] for (uint s = 0u; s < A_STAGE; s++) {                           \
        uint i = tid + s * NTHREADS;                                           \
        if (i < A_VECS) {                                                      \
            uint r = i / A_VECS_PER_ROW;                                       \
            uint col = (i % A_VECS_PER_ROW) * 8u;                              \
            stageA[s] = a4[((m0 + r) * pc.lda + (kk) + col) >> 3u];            \
        }                                                                      \
    }                                                                          \
    [[unroll]] for (uint s = 0u; s < B_STAGE; s++) {                           \
        uint i = tid + s * NTHREADS;                                           \
        if (i < B_VECS) {                                                      \
            uint r = i / B_VECS_PER_ROW;                                       \
            uint col = (i % B_VECS_PER_ROW) * 8u;                              \
            stageB[s] = b4[(B_SLAB_ELEM(r, kk, col)) >> 3u];                   \
        }                                                                      \
    }                                                                          \
}

#define STORE_STAGE(buf) {                                                     \
    [[unroll]] for (uint s = 0u; s < A_STAGE; s++) {                           \
        uint i = tid + s * NTHREADS;                                           \
        if (i < A_VECS) {                                                      \
            uint r = i / A_VECS_PER_ROW;                                       \
            uint col = (i % A_VECS_PER_ROW) * 8u;                              \
            SPREAD8(ldsA, (buf) * LDS_A_PLANE + r * LDS_A_STRIDE + col, stageA[s]) \
        }                                                                      \
    }                                                                          \
    [[unroll]] for (uint s = 0u; s < B_STAGE; s++) {                           \
        uint i = tid + s * NTHREADS;                                           \
        if (i < B_VECS) {                                                      \
            uint r = i / B_VECS_PER_ROW;                                       \
            uint col = (i % B_VECS_PER_ROW) * 8u;                              \
            SPREAD8(ldsB, (buf) * LDS_B_PLANE + r * LDS_B_STRIDE + col, stageB[s]) \
        }                                                                      \
    }                                                                          \
}
#endif

#define FRAG_A_T coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA>
#define FRAG_B_T coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB>

// Where a fragment load lands. With HOIST_K the register file holds every
// K-tile of the slab at once, so the destination is indexed by the K-tile as
// well; without it there is one set of fragments, reused each K-tile.
#if HOIST_A
#define FRAG_A(kt, i) fragA[kt][i]
#else
#define FRAG_A(kt, i) fragA[i]
#endif
#if HOIST_B
#define FRAG_B(kt, j) fragB[kt][j]
#else
#define FRAG_B(kt, j) fragB[j]
#endif

// One K-slab's worth of matrix work: load WM A-fragments and WN B-fragments,
// then issue WM*WN MMAs against them. The loads are hoisted out of the MMA
// nest so each fragment is fetched once and reused across a whole accumulator
// row or column — that reuse *is* the arithmetic intensity this file is about.
//
// abase/bbase are the reduction offset k0 when reading global memory, and the
// LDS plane offset when reading shared memory.
#if USE_LDS
#define LOAD_FRAG_A(i, abase, kt)                                              \
    coopMatLoad(FRAG_A(kt, i), ldsA,                                                \
        (abase) + (waveM * (WM * TILE) + (i) * TILE) * LDS_A_STRIDE + (kt) * TILE, \
        LDS_A_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if B_COLMAJOR
#define LOAD_FRAG_B(j, bbase, kt)                                              \
    coopMatLoad(FRAG_B(kt, j), ldsB,                                                \
        (bbase) + (waveN * (WN * TILE) + (j) * TILE) * LDS_B_STRIDE + (kt) * TILE, \
        LDS_B_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
#else
#define LOAD_FRAG_B(j, bbase, kt)                                              \
    coopMatLoad(FRAG_B(kt, j), ldsB,                                                \
        (bbase) + ((kt) * TILE) * LDS_B_STRIDE + waveN * (WN * TILE) + (j) * TILE, \
        LDS_B_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
#else
#define LOAD_FRAG_A(i, abase, kt)                                              \
    coopMatLoad(FRAG_A(kt, i), a, (wm0 + (i) * TILE) * pc.lda + (abase) + (kt) * TILE, \
        pc.lda, gl_CooperativeMatrixLayoutRowMajor);
#if B_COLMAJOR
#define LOAD_FRAG_B(j, bbase, kt)                                              \
    coopMatLoad(FRAG_B(kt, j), b, (wn0 + (j) * TILE) * pc.ldb + (bbase) + (kt) * TILE, \
        pc.ldb, gl_CooperativeMatrixLayoutColumnMajor);
#else
#define LOAD_FRAG_B(j, bbase, kt)                                              \
    coopMatLoad(FRAG_B(kt, j), b, ((bbase) + (kt) * TILE) * pc.ldb + wn0 + (j) * TILE, \
        pc.ldb, gl_CooperativeMatrixLayoutRowMajor);
#endif
#endif

#if HOIST
// The same work, with each hoisted operand's whole slab of loads issued
// before the slab's first MMA. The byte set, the MMA count, the tile shape
// and the accumulator grid are all unchanged; what moves is how much of each
// row a wave has outstanding at one moment, which IDEAS §5.1b's mechanism 3
// says is the quantity the memory system actually prices (see the note at the
// top of this file). The unhoisted operand keeps the original structure —
// one set of fragments, refilled per K-tile.
#if HOIST_A
#define DECL_A FRAG_A_T fragA[BK_TILES][WM];
#define PRE_A(abase, kt)  [[unroll]] for (uint i = 0u; i < WM; i++) { LOAD_FRAG_A(i, abase, kt) }
#define INNER_A(abase, kt)
#else
#define DECL_A
#define PRE_A(abase, kt)
#define INNER_A(abase, kt) FRAG_A_T fragA[WM];                                 \
    [[unroll]] for (uint i = 0u; i < WM; i++) { LOAD_FRAG_A(i, abase, kt) }
#endif
#if HOIST_B
#define DECL_B FRAG_B_T fragB[BK_TILES][WN];
#define PRE_B(bbase, kt)  [[unroll]] for (uint j = 0u; j < WN; j++) { LOAD_FRAG_B(j, bbase, kt) }
#define INNER_B(bbase, kt)
#else
#define DECL_B
#define PRE_B(bbase, kt)
#define INNER_B(bbase, kt) FRAG_B_T fragB[WN];                                 \
    [[unroll]] for (uint j = 0u; j < WN; j++) { LOAD_FRAG_B(j, bbase, kt) }
#endif

#define MMA_BLOCK(abase, bbase) {                                              \
    DECL_A                                                                     \
    DECL_B                                                                     \
    [[unroll]] for (uint kt = 0u; kt < BK_TILES; kt++) {                       \
        PRE_A(abase, kt)                                                       \
        PRE_B(bbase, kt)                                                       \
    }                                                                          \
    [[unroll]] for (uint kt = 0u; kt < BK_TILES; kt++) {                       \
        INNER_A(abase, kt)                                                     \
        INNER_B(bbase, kt)                                                     \
        [[unroll]] for (uint i = 0u; i < WM; i++) {                            \
            [[unroll]] for (uint j = 0u; j < WN; j++) {                        \
                acc[i][j] = coopMatMulAdd(FRAG_A(kt, i), FRAG_B(kt, j), acc[i][j]); \
            }                                                                  \
        }                                                                      \
    }                                                                          \
}
#else
#define MMA_BLOCK(abase, bbase) {                                              \
    [[unroll]] for (uint kt = 0u; kt < BK_TILES; kt++) {                       \
        FRAG_A_T fragA[WM];                                                    \
        FRAG_B_T fragB[WN];                                                    \
        [[unroll]] for (uint i = 0u; i < WM; i++) { LOAD_FRAG_A(i, abase, kt) } \
        [[unroll]] for (uint j = 0u; j < WN; j++) { LOAD_FRAG_B(j, bbase, kt) } \
        [[unroll]] for (uint i = 0u; i < WM; i++) {                            \
            [[unroll]] for (uint j = 0u; j < WN; j++) {                        \
                acc[i][j] = coopMatMulAdd(FRAG_A(kt, i), FRAG_B(kt, j), acc[i][j]); \
            }                                                                  \
        }                                                                      \
    }                                                                          \
}
#endif

void main() {
    // Wave's position in the workgroup's wave grid. Both divisors are
    // compile-time powers of two, so these are shifts and masks, not the
    // integer-division sequences IDEAS §1.2 is about.
    uint waveM = gl_SubgroupID / WAVES_N;
    uint waveN = gl_SubgroupID % WAVES_N;

    // Top-left corner of this workgroup's C tile, and of this wave's slice.
    // B's row base and C's column base are separate because grouped mode puts
    // every expert's weights in one bank: the tile's B rows start at
    // expert*N + n0 while its C columns still start at n0. They are the same
    // number in every non-grouped variant, which is why nothing above this
    // line changes.
#if GROUPED
    uvec4 tile = tiles[pc.tileBase + gl_WorkGroupID.x];
    uint m0 = tile.x;
    uint n0 = tile.y;
    uint cn0 = tile.z;
#else
    uint m0 = gl_WorkGroupID.y * BM;
    uint n0 = gl_WorkGroupID.x * BN;
    uint cn0 = n0;
#endif
    uint wm0 = m0 + waveM * (WM * TILE);
    uint wn0 = n0 + waveN * (WN * TILE);
    uint wc0 = cn0 + waveN * (WN * TILE);

    coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator> acc[WM][WN];
    [[unroll]] for (uint i = 0u; i < WM; i++) {
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>(0.0);
        }
    }

#if USE_LDS
    uint tid = gl_LocalInvocationID.x;
    uvec4 stageA[A_STAGE];
    uvec4 stageB[B_STAGE];
#endif

#if USE_LDS && DOUBLE_BUFFER
    LOAD_STAGE(0u)
    STORE_STAGE(0u)
    barrier();
    uint buf = 0u;
#endif

    for (uint k0 = 0u; k0 < pc.K; k0 += BK) {
#if USE_LDS && DOUBLE_BUFFER
        // The next slab's loads are issued here but not consumed until
        // STORE_STAGE below, so their latency overlaps this slab's MMAs.
        bool more = k0 + BK < pc.K;
        if (more) LOAD_STAGE(k0 + BK)
        MMA_BLOCK(buf * LDS_A_PLANE, buf * LDS_B_PLANE)
        // Writing the *other* buffer means there is no hazard against the
        // waves still reading this one, so one barrier per K-step suffices.
        if (more) STORE_STAGE(1u - buf)
        barrier();
        buf = 1u - buf;
#elif USE_LDS
        LOAD_STAGE(k0)
        STORE_STAGE(0u)
        barrier();
        MMA_BLOCK(0u, 0u)
        // Second barrier: the next iteration overwrites the slabs this wave
        // has just read, and waves within a workgroup are not lockstep.
        barrier();
#else
        MMA_BLOCK(k0, k0)
#endif
    }

    [[unroll]] for (uint i = 0u; i < WM; i++) {
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            coopMatStore(acc[i][j], c, (wm0 + i * TILE) * pc.N + wc0 + j * TILE,
                pc.N, gl_CooperativeMatrixLayoutRowMajor);
        }
    }
}
