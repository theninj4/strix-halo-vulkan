#version 450

#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_control_flow_attributes : enable

// The grouped expert GEMM: 35.7% of llama.cpp's prefill graph, 97% of this
// checkpoint's parameters, and the last block of the model without a kernel
// (LLM.md L5b).
//
// **It reads the checkpoint's own quantised blocks.** Every other GEMM in
// this vertical takes a B operand the host has dequantised to halves and
// packed into §2.8 fragment tiles. That cannot happen here: one layer's three
// expert banks are 2.52 billion weights, 5.03 GB at fp16 and 241 GB across
// the model, against 1.57 GB and 75 GB as they ship. So the bank is staged
// **verbatim** — Q4_K and Q5_K for gate and up, Q5_1 or Q8_0 for down, Q8_0
// for the shared expert — and each workgroup unpacks its own BN x BK slab
// into LDS per K-step, which is §2.2's arrangement for the same reason it
// gave: a cooperative-matrix fragment's lane layout is not exposed, so
// nibbles cannot be unpacked into registers and declared a fragment.
//
// Two modes, and both of them fuse what llama.cpp spends a dispatch on:
//
//   MODE 0   gate and up for one (expert, row block), `silu(gate)*up` on the
//            accumulators.  The [rows, 640] pair never exists: the reference
//            writes `ffn_moe_gate` and `ffn_moe_up` and then reads them back
//            through `ggml_swiglu_split`.
//   MODE 1   down, times the row's routing weight, scattered to its
//            (token, slot).  `ffn_moe_weighted` never exists either.
//
// **The A operand of MODE 0 is gathered and the A operand of MODE 1 is not**,
// and that asymmetry is the permutation paying for itself. A routed row is
// some token's row of the block input, so MODE 0 stages BM scattered rows
// into LDS; what it writes is indexed by *permutation position*, so MODE 1's
// rows are contiguous and it loads them straight out of the fp16 arena with
// no gather at all. The scatter happens once, in MODE 1's epilogue, where it
// is a store that had to happen anyway.
//
// **No tile has a tail, and that is a choice made in the permutation.**
// L5a-4 measured the routing: 274 of 512 experts touched at a 512-token
// ubatch and 273 of them with fewer than 19 rows, so most tiles would be
// mostly padding and the padding must not write over the next expert's rows.
// A cooperative-matrix store covers sixteen rows at once and cannot be
// masked, so the obvious answer is to stage the accumulators in LDS and copy
// them out under a bound — and that answer costs 8-16 KB of LDS on a kernel
// whose occupancy is already about one wave a SIMD, which is what it is short
// of. So `llm_moe_perm.comp` rounds every expert's row range up to the
// schedule's alignment instead and fills the slack with a **sentinel**
// permutation entry naming a token one past the batch, whose activation row
// is zero. Every store then goes straight to global, and the only cost is
// arithmetic on rows nothing reads.
//
// **Since §2.12 the alignment is one fragment and the tail is short**
// (KERNELS.md G5c): the single-wave builds are `SHORT` builds that run one
// of WM copies of their loop on the record's real rows, so a 2048-token
// ubatch executes 1.19x the rows that exist instead of 1.90x. The padding
// rows that remain are the same sentinel rows as before; the whole-block
// padding above is what the multi-wave rungs still get.

// **The K loop is a software pipeline on the Q4_K up builds** (`-DPIPE=2`,
// KERNELS.md G5, §2.11). The plain loop is, per K-step, one dependent
// chain — the gathered rows, the block headers and the nibbles, each waited
// for, unpacked and stored, and only then the fragment loads and the MMAs —
// and G5's controls priced it: with the bank loads made L0 hits the up
// projection is 1.43x faster, with the slab unpacks skipped 1.76x, and with
// both stagings skipped the loop runs at ~90% of the matrix pipe, so the
// LDS round trip §2.2 blamed is not the cost. The pipeline fetches the
// next step's bytes into registers before this step's MMAs, reads a block
// header once per super-block and a nibble group once per two steps
// instead of every step, and unpacks from registers: 2.7x fewer bank load
// instructions a super-block, none of them waited for in front of the
// MMAs. Bit-identical (the same arithmetic in the same order), and the up
// projection **1.68x at 2048 tokens, 2.01x at 512, 1.57x at 4096**. The
// other formats and the down mode keep the plain loop until the pipeline
// is written for their block layouts.

#define MOE_QBANK
#include "llm_common.glsl"

#ifndef MODE
#define MODE 0      // 0 = gate/up + swiglu, 1 = down + weight + scatter
#endif
// The quantised format of this build's B. The bank ships as four of them and
// which one a tensor is, is a fact about the layer: `ffn_down_exps` is Q5_1 on
// 43 of the 48 layers and Q8_0 on the other five, gate and up are Q4_K except
// on layer 2 where they are Q5_K, and the shared expert is Q8_0 everywhere.
#define FMT_Q4_K 0
#define FMT_Q5_K 1
#define FMT_Q5_1 2
#define FMT_Q8_0 3
// P4c's two, which no tensor *ships* in: `ffn_down_exps` has a row of 640 and
// no K-quant divides it, so narrowing it below six bits means a block-32
// format the bank is transcoded into. Q4_1 is Q5_1 with the plane of fifth
// bits deleted (20 bytes, 5.0 bits a weight); IQ4_NL is 18 bytes and 4.5, its
// nibbles indexing a non-linear codebook instead of a level.
#define FMT_Q4_1 4
#define FMT_IQ4NL 5
#ifndef QFMT
#define QFMT FMT_Q4_K
#endif
#ifndef WM
#define WM 2        // accumulator tiles a wave holds, M direction
#endif
#ifndef WN
#define WN 4        // accumulator tiles, N direction
#endif
// How many waves split a tile's rows between them. They share one
// dequantised B slab, which is the whole point: unpacking 64 rows of Q4_K per
// K-step to multiply sixteen rows of A is most of what this kernel does, and
// a second wave halves that per row while doubling the occupancy of a kernel
// that runs at about one wave a SIMD.
#ifndef WAVES
#define WAVES 1
#endif

#define TILE 16
#define BM (WAVES * WM * TILE)
#define BN (WN * TILE)
// One K-step is 32 elements by default: exactly one Q5_1 or Q8_0 block, whose
// scale a lane then reads once for the whole slab.
//
// **The Q4_K nibble is read as an f16 denormal** (`-DNIB_F16=1`, KERNELS.md
// G5d, §2.13): the compiler already fuses the affine and the half
// conversion into one `v_fma_mix`, and a halfword holding one nibble *is*
// the half `nib * 2^-24`, so the extract-and-convert pair in front of every
// element goes and the scale carries the power of two. Bit-identical; the
// four-tile step's non-MMA VALU 331 -> 259, `moe.up` 1.02x. The 71 allocator
// moves a step in the m4 build are register pressure (the m2 carries four),
// and the two arms on them — the K tiles as a loop, A fetched at the top of
// the step — are dead (38 moves a tile; -12%). Both stay as knobs.
//
// It is a `-D` because Q4_K and Q5_K look as though they want 64. A 64-element
// group of those formats packs the low nibbles of all 32 bytes first and the
// high nibbles of the *same* 32 bytes second, so a 32-element step reads the
// group's bytes, uses half of every one, and then reads them again — an
// apparent 2x read amplification on 44 GB of the checkpoint, which one step
// per group removes. **Measured, it is 1.16x slower**: the doubled slab takes
// MODE 0's LDS from 12.8 KB to 23 and the workgroups a CU can hold from five
// to two, and the second read of those 32 bytes was being served out of cache
// anyway. The loop below is written to cover any BK; the ladder runs at 32.
#ifndef BK
#define BK 32
#endif
#define BK_TILES (BK / TILE)
// Halves a `uvec4` of the operand view carries (P11). BK is 32 and a fragment
// tile is 16, so a K-step is four of them a row and the loop below never has
// a remainder; a BK that is not a multiple of eight would need one.
#define A_VEC 8
#if (BK % A_VEC) != 0
#error "BK must be a whole number of uvec4 loads"
#endif
#ifndef WAVE
#define WAVE 64
#endif
#define LANES (WAVES * WAVE)
// **A short last block** (KERNELS.md G5c, §2.12). The permutation used to
// pad every expert's rows to the widest row block in the plan, so a tile was
// always whole and this kernel had nothing to bound: at a 2048-token ubatch
// that executed 1.90x the rows that exist (P11-4), and P11 measured the
// rows as nearly free because the unpack was the cost. §2.11's pipeline
// made the MMAs ~78% of the kernel, so the rows are the cost now. With SHORT
// the alignment is one fragment (sixteen rows), the record's third word —
// the block's real rows — says how many of the workgroup's WM row tiles
// exist, and the K loop and the store run as one of WM copies chosen by a
// uniform switch on that count: no bound inside the unrolled loops (P11's
// arm, which paid in registers and clauses), the same MMAs per real row in
// the same order, so it is bit-identical to the padded schedule. The A
// staging of MODE 0 still fills all BM rows (the loads are in flight behind
// the MMAs and the rows past the block are valid entries of the permuted
// space, sentinel-filled to a whole block at its end); only the MMAs and
// the stores of the missing tiles are skipped. SHORT_STEP 2 keeps only the
// copies at even tile counts (a third copy spills 15 registers on the Q4_K
// up m4 build, and a 16-row tile costs that kernel what a 32-row one does):
// the count is rounded up for the loop, and **the store stays bounded by the
// real count**, because the rows past the block belong to the next expert.
// Single-wave builds only: a multi-wave rung keeps the block whole and the
// host aligns the permutation to its BM (`moeAlign`).
#ifndef SHORT
#define SHORT 0
#endif
#ifndef SHORT_STEP
#define SHORT_STEP 1
#endif
#if SHORT && WAVES != 1
#error "SHORT is written for the single-wave rungs"
#endif

// Screening knobs (KERNELS.md G5), never shipped and wrong by construction:
// each takes one part of the K-step away so that part is priced by its
// absence, the way dit_gemm.comp's L0_LOADS and LDS_NOBAR price theirs.
// MOE_NO_UNPACK skips the B slab's unpack (the fragments read whatever LDS
// holds); MOE_NO_ASTAGE skips the gathered A staging; MOE_NIB_ONLY is
// P12-3's `float16_t(nib)`, no header, no scale, no affine; MOE_L0_BANK
// reads every lane's bank bytes from the tile's first row and MOE_L0_A every
// gathered row from token zero, so the loads are issued and waited for but
// hit the L0 (MOE_L0_BANK=2 keeps the real rows, sixty-four lines a load,
// but the same bytes every step, so what is taken away is the fetch and
// not the divergence); MOE_FRAG2 reads every fragment twice, so the LDS
// fragment reads are priced by their addition.
#ifndef MOE_NO_UNPACK
#define MOE_NO_UNPACK 0
#endif
#ifndef MOE_NO_ASTAGE
#define MOE_NO_ASTAGE 0
#endif
#ifndef MOE_NIB_ONLY
#define MOE_NIB_ONLY 0
#endif
#ifndef MOE_L0_BANK
#define MOE_L0_BANK 0
#endif
#ifndef MOE_L0_A
#define MOE_L0_A 0
#endif
#ifndef MOE_FRAG2
#define MOE_FRAG2 0
#endif
// NIB_F16 (KERNELS.md G5d): the Q4_K nibble read as an f16 *denormal*. The
// shipped unpack spends a `v_bfe_u32` and a `v_cvt_f32_u32` in front of every
// element's `v_fma_mixlo_f16`, and every VALU instruction costs the matrix
// pipe a clock (§2.10). A halfword whose low nibble is the value and whose
// other twelve bits are zero *is* the half `nib * 2^-24` — a denormal, exact —
// and `v_fma_mix` reads a half from either half of a word for free (op_sel).
// So a word's four nibbles become two masked words (`w & 0x000F000F` holds
// elements 0 and 2, `(w >> 8) & mask` elements 1 and 3): three instructions
// for four elements instead of eight, and the scale carries the 2^24 (2^20
// for the high nibble, whose halfword is `nib * 16`). `d * sc` is an
// 11-by-6-bit product, exact in fp32, and a power of two keeps it exact, so
// the fma sees the same operands to the bit and the slab is byte-identical
// (the ladder gate against a build without it says so). fp16 denormals are
// preserved by default under RADV; a build that flushed them would fail
// that gate at once, with every value `-dm`.
#ifndef NIB_F16
#define NIB_F16 0
#endif
// MOE_KT_LOOP keeps the MMA block's two K tiles as a loop the compiler
// cannot unroll, §2.10's `KT_LOOP` on this kernel: the unrolled block carries
// ~50 `v_mov`/`v_swap` a step from the allocator at 256 VGPRs.
#ifndef MOE_KT_LOOP
#define MOE_KT_LOOP 0
#endif
// PIPE_A=0 keeps the B pipeline and fetches A at the top of the step instead
// of a step ahead: an arm on the m4 build's register pressure, whose 71
// allocator moves a step the m1/m2 builds (216/240 VGPRs) do not carry.
#ifndef PIPE_A
#define PIPE_A 1
#endif
#if MOE_KT_LOOP
#define KT_UNROLL [[dont_unroll]]
#else
#define KT_UNROLL [[unroll]]
#endif
#if MOE_NIB_ONLY
#define Q_AFFINE(NIB, DS, DM) float16_t(NIB)
#define Q_AFFINE_ADD(NIB, D, M) float16_t(NIB)
#else
#define Q_AFFINE(NIB, DS, DM) float16_t((DS) * float(NIB) - (DM))
#define Q_AFFINE_ADD(NIB, D, M) float16_t(float(NIB) * (D) + (M))
#endif

layout(local_size_x = LANES) in;

// §2.2's LDS_PAD, which it measured at 1.68-1.83x, and which here is pinned
// by alignment rather than free to tune. A slab row of BK + 8 halves is 20
// dwords and `gcd(20, 32)` is 4, so the 64 lanes of the unpack — one column
// each — land on eight of the 32 banks. Two halves would make the stride 17
// dwords, coprime with 32 and conflict-free, and it is **5.4x slower**: at 34
// halves a row starts on a 4-byte boundary and the cooperative-matrix load
// off LDS loses its wide path. Every pad that keeps rows 16-byte aligned is a
// multiple of four dwords, so a bank conflict of at least four ways is the
// price of the fragment load, and eight is as good as it gets.
#ifndef LDS_PAD
#define LDS_PAD 8
#endif
#define LDS_ROW (BK + LDS_PAD)

#if MODE == 0
shared float16_t sB0[BN * LDS_ROW];
shared float16_t sB1[BN * LDS_ROW];
shared float16_t sA[BM * LDS_ROW];
#else
shared float16_t sB0[BN * LDS_ROW];
#endif

#define FRAG_A_T coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA>
#define FRAG_B_T coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB>
#define ACC_T coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>
#define ACC16_T coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>

// ---- The formats. Each is stated as "bytes a block covers" and "elements a
// block covers", so a row's byte length is (K / QK) * QB and nothing below
// has to know which axis it is walking.
#if QFMT == FMT_Q4_K
#define QK 256u
#define QB 144u
#elif QFMT == FMT_Q5_K
#define QK 256u
#define QB 176u
#elif QFMT == FMT_Q5_1
#define QK 32u
#define QB 24u
#elif QFMT == FMT_Q4_1
#define QK 32u
#define QB 20u
#elif QFMT == FMT_IQ4NL
#define QK 32u
#define QB 18u
#else
#define QK 32u
#define QB 34u
#endif

#if QFMT == FMT_IQ4NL
// IQ4_NL's sixteen levels — `kvalues_iq4nl`: -127, -104, -83, -65, -49, -35,
// -22, -10, 1, 13, 25, 38, 53, 69, 89, 113 — packed one signed byte a level
// into four dwords.
//
// **This is the initialiser, not the lookup**, for the reason the GEMV gives:
// the index is divergent, so reading a level out of the packed form is a
// `cndmask` chain, a bitfield extract and a convert where a level format
// needs one convert — and the slab unpack is most of what this kernel does,
// so it is the difference between a nibble format and a codebook one. The
// table is widened into LDS once per workgroup, 64 bytes beside the 12.8 KB
// the slabs already take, and the one barrier it needs is outside the K
// loop. Measured on the 512-token prefill graph: **630.5 tok/s against
// 663.6** without it, where the affine formats are unaffected.
float iq4nlConst(uint l) {
    uvec4 tab = uvec4(0xBFAD9881u, 0xF6EADDCFu, 0x26190D01u, 0x71594535u);
    return float(bitfieldExtract(int(tab[l >> 2]), int((l & 3u) << 3), 8));
}

shared float kIQ4[16];
#endif

uint qbyte(uint b) { return (qbank[b >> 2] >> ((b & 3u) * 8u)) & 0xFFu; }

// **A K-quant block's header and its scales are one sixteen-byte load** (P12).
//
// Q4_K and Q5_K open every block with `d`, `dmin` and the twelve packed
// 6-bit scale/min bytes — sixteen bytes, read as four separate dwords. That
// is four load instructions a block a row where one `uvec4` does, and this
// kernel is bound by how many loads its unpack issues (L5b-7, P11-3): at BK
// 32 a lane unpacks two rows a K-step, so it was eight scalar loads a K-step
// against the four vector ones the nibbles take.
//
// It is legal because **every block of these two formats is sixteen-byte
// aligned**, and that is three facts rather than an assumption: each of the
// six bank regions starts at `roundUpInt(nbytes, 16)` (`MoEGPU.reserve`); a
// Q4_K row is `k/256 * 144` bytes and a Q5_K row `k/256 * 176`, both
// multiples of 16 (`moeRowBytes`); and the blocks inside a row are 144 and
// 176 apart. `MoEGPU.build` checks the first of those rather than trusting
// it, for the same reason P11 checked the gather's.

// The block header, in one load. `d` and its companion are the first four
// bytes of every one of these formats and the block base is four-aligned, so
// a pair of halves comes out of a single word rather than four byte reads.
vec2 qhdr(uint blk) { return unpackHalf2x16(qbank[blk >> 2]); }

#if QFMT == FMT_Q4_K || QFMT == FMT_Q5_K
// ggml's get_scale_min_k4: eight 6-bit scale/min pairs in twelve bytes, which
// is three words read once for the whole slab. The first four pairs are plain
// fields; the last four take their low nibble from bytes 8..11 and their top
// two bits from the spare bits of bytes 0..7.
uint sbyte(uvec3 s, uint i) {
    uint w = (i < 4u) ? s.x : ((i < 8u) ? s.y : s.z);
    return (w >> ((i & 3u) * 8u)) & 0xFFu;
}

void scaleMinK4(uint j, uvec3 s, out uint sc, out uint mn) {
    if (j < 4u) {
        sc = sbyte(s, j) & 63u;
        mn = sbyte(s, j + 4u) & 63u;
    } else {
        uint a = sbyte(s, j + 4u);
        sc = (a & 0xFu) | ((sbyte(s, j - 4u) >> 6) << 4);
        mn = (a >> 4) | ((sbyte(s, j) >> 6) << 4);
    }
}
#endif

// dequantSlab writes the BK elements of bank row `row` starting at element
// `k0` into `dst` at `col * LDS_ROW`. One lane per output column, so the block
// header is read once for the whole slab.
#define DEQUANT_SLAB(NAME, DST)                                                                 \
void NAME(uint bankBase, uint row, uint k0, uint col) {                                         \
    uint rb = bankBase + (MOE_L0_BANK == 1 ? 0u : row) * ((pc.gemmK / QK) * QB);                \
    uint dst = col * LDS_ROW;                                                                   \
    DEQUANT_BODY(DST)                                                                           \
}

#if QFMT == FMT_Q4_K
#define DEQUANT_BODY(DST)                                                                       \
  [[unroll]] for (uint c = 0u; c < BK; c += 32u) {                                              \
    uint k0c = (MOE_L0_BANK == 2 ? 0u : k0) + c;                                                \
    uint within = k0c & 255u;                                                                    \
    uint g = within >> 6;                                                                       \
    uint sub = (within >> 5) & 1u;                                                              \
    uint blk = rb + (k0c >> 8) * 144u;                                                          \
    uvec4 hdr = qbank4[blk >> 4];                                                               \
    vec2 dd = unpackHalf2x16(hdr.x);                                                            \
    uint sc, mn;                                                                                \
    scaleMinK4(2u * g + sub, hdr.yzw, sc, mn);                                                  \
    float ds = dd.x * float(sc) * Q4K_SCALE(sub);                                               \
    float dm = dd.y * float(mn);                                                                \
    uint sh = sub * 4u;                                                                         \
    uint nmask = Q4K_MASK(sub);                                                                 \
    uint qv = (blk + 16u + g * 32u) >> 4;                                                       \
    uvec4 lo4 = qbank4[qv];                                                                     \
    uvec4 hi4 = qbank4[qv + 1u];                                                                \
    [[unroll]] for (uint t = 0u; t < 8u; ++t) {                                                 \
        uint w = (t < 4u) ? lo4[t] : hi4[t - 4u];                                               \
        Q4K_WORD(DST, dst + c + t * 4u, w)                                                      \
    }                                                                                           \
  }
#if NIB_F16
// The four elements of one nibble word, as f16 denormals (NIB_F16 above).
// `ds` arrives scaled by 2^24 or 2^20 (Q4K_SCALE), `nmask` is the halfword
// mask for this step's nibble.
#define Q4K_SCALE(sub) ((sub) == 0u ? 16777216.0 : 1048576.0)
#define Q4K_MASK(sub) ((sub) == 0u ? 0x000F000Fu : 0x00F000F0u)
#define Q4K_WORD(DST, at, w)                                                                    \
        {                                                                                       \
            vec2 e02 = unpackHalf2x16((w) & nmask);                                             \
            vec2 e13 = unpackHalf2x16(((w) >> 8) & nmask);                                      \
            DST[(at) + 0u] = float16_t(ds * e02.x - dm);                                        \
            DST[(at) + 1u] = float16_t(ds * e13.x - dm);                                        \
            DST[(at) + 2u] = float16_t(ds * e02.y - dm);                                        \
            DST[(at) + 3u] = float16_t(ds * e13.y - dm);                                        \
        }
#else
#define Q4K_SCALE(sub) 1.0
#define Q4K_MASK(sub) 0u
#define Q4K_WORD(DST, at, w)                                                                    \
        [[unroll]] for (uint b = 0u; b < 4u; ++b) {                                             \
            uint nib = ((w) >> (8u * b + sh)) & 0xFu;                                           \
            DST[(at) + b] = Q_AFFINE(nib, ds, dm);                                              \
        }
#endif
#elif QFMT == FMT_Q5_K
#define DEQUANT_BODY(DST)                                                                       \
  [[unroll]] for (uint c = 0u; c < BK; c += 32u) {                                              \
    uint k0c = k0 + c;                                                                          \
    uint within = k0c & 255u;                                                                    \
    uint g = within >> 6;                                                                       \
    uint sub = (within >> 5) & 1u;                                                              \
    uint blk = rb + (k0c >> 8) * 176u;                                                          \
    uvec4 hdr = qbank4[blk >> 4];                                                               \
    vec2 dd = unpackHalf2x16(hdr.x);                                                            \
    uint sc, mn;                                                                                \
    scaleMinK4(2u * g + sub, hdr.yzw, sc, mn);                                                  \
    float ds = dd.x * float(sc);                                                                \
    float dm = dd.y * float(mn);                                                                \
    uint sh = sub * 4u;                                                                         \
    uint hmask = (sub == 0u ? 1u : 2u) << (2u * g);                                             \
    uint hv = (blk + 16u) >> 4;                                                                 \
    uvec4 h0 = qbank4[hv];                                                                      \
    uvec4 h1 = qbank4[hv + 1u];                                                                 \
    uint qv = (blk + 48u + g * 32u) >> 4;                                                       \
    uvec4 lo4 = qbank4[qv];                                                                     \
    uvec4 hi4 = qbank4[qv + 1u];                                                                \
    [[unroll]] for (uint t = 0u; t < 8u; ++t) {                                                 \
        uint w = (t < 4u) ? lo4[t] : hi4[t - 4u];                                               \
        uint h = (t < 4u) ? h0[t] : h1[t - 4u];                                                 \
        [[unroll]] for (uint b = 0u; b < 4u; ++b) {                                             \
            uint nib = (w >> (8u * b + sh)) & 0xFu;                                             \
            if (((h >> (8u * b)) & hmask) != 0u) {                                              \
                nib += 16u;                                                                     \
            }                                                                                   \
            DST[dst + c + t * 4u + b] = Q_AFFINE(nib, ds, dm);                                  \
        }                                                                                       \
    }                                                                                           \
  }
#elif QFMT == FMT_Q5_1
#define DEQUANT_BODY(DST)                                                                       \
  [[unroll]] for (uint c = 0u; c < BK; c += 32u) {                                              \
    uint blk = rb + ((k0 + c) >> 5) * 24u;                                                            \
    uint hw = blk >> 2;                                                                         \
    vec2 dm = unpackHalf2x16(qbank[hw]);                                                        \
    uint qh = qbank[hw + 1u];                                                                   \
    [[unroll]] for (uint t = 0u; t < 4u; ++t) {                                                 \
        uint w = qbank[hw + 2u + t];                                                            \
        [[unroll]] for (uint b = 0u; b < 4u; ++b) {                                             \
            uint j = t * 4u + b;                                                                \
            uint by = (w >> (8u * b)) & 0xFFu;                                                  \
            uint lo = (by & 0xFu) | (((qh >> j) & 1u) << 4);                                    \
            uint hi = (by >> 4) | (((qh >> (j + 16u)) & 1u) << 4);                              \
            DST[dst + c + j] = Q_AFFINE_ADD(lo, dm.x, dm.y);                                    \
            DST[dst + c + j + 16u] = Q_AFFINE_ADD(hi, dm.x, dm.y);                              \
        }                                                                                       \
    }                                                                                           \
  }
#elif QFMT == FMT_Q4_1
// Q4_1 asks nothing of the addressing: twenty bytes a block keeps every block
// four-aligned under a row that is, and the pairs split the way Q5_1's do.
#define DEQUANT_BODY(DST)                                                                       \
  [[unroll]] for (uint c = 0u; c < BK; c += 32u) {                                              \
    uint hw = (rb + ((k0 + c) >> 5) * 20u) >> 2;                                                \
    vec2 dm = unpackHalf2x16(qbank[hw]);                                                        \
    [[unroll]] for (uint t = 0u; t < 4u; ++t) {                                                 \
        uint w = qbank[hw + 1u + t];                                                            \
        [[unroll]] for (uint b = 0u; b < 4u; ++b) {                                             \
            uint j = t * 4u + b;                                                                \
            uint by = (w >> (8u * b)) & 0xFFu;                                                  \
            DST[dst + c + j] = float16_t(float(by & 0xFu) * dm.x + dm.y);                       \
            DST[dst + c + j + 16u] = float16_t(float(by >> 4) * dm.x + dm.y);                   \
        }                                                                                       \
    }                                                                                           \
  }
#elif QFMT == FMT_IQ4NL
// IQ4_NL's rows are **ours rather than ggml's records**: blocks in pairs of
// 36 bytes — two scales, then two sixteen-byte nibble groups
// (`pairIQ4NLRow`). An eighteen-byte record is not a multiple of four, so
// ggml's layout would put every other block two bytes into a word and take
// Q8_0's two-word window. **A plane of scales is not the answer**: it suits
// the GEMV, whose lane group walks one row, and costs this kernel 36%,
// because a slab unpack reads one block of sixty-four *different* rows per
// K-step and a scale a row away from its nibbles doubles the lines that
// opens. 36 bytes is aligned and keeps the two together.
#define DEQUANT_BODY(DST)                                                                       \
  [[unroll]] for (uint c = 0u; c < BK; c += 32u) {                                              \
    uint m = (k0 + c) >> 5;                                                                     \
    uint pw = (rb + (m >> 1) * 36u) >> 2;                                                       \
    vec2 dd = unpackHalf2x16(qbank[pw]);                                                        \
    float d = ((m & 1u) == 0u) ? dd.x : dd.y;                                                   \
    uint bw = pw + 1u + (m & 1u) * 4u;                                                          \
    [[unroll]] for (uint t = 0u; t < 4u; ++t) {                                                 \
        uint w = qbank[bw + t];                                                                 \
        [[unroll]] for (uint b = 0u; b < 4u; ++b) {                                             \
            uint j = t * 4u + b;                                                                \
            uint by = (w >> (8u * b)) & 0xFFu;                                                  \
            DST[dst + c + j] = float16_t(kIQ4[by & 0xFu] * d);                                  \
            DST[dst + c + j + 16u] = float16_t(kIQ4[by >> 4] * d);                              \
        }                                                                                       \
    }                                                                                           \
  }
#else
// Q8_PK (research/rune-vertical.md R10, Rune's experts): a word's four int8s
// into fp16 two at a time instead of one at a time through fp32. Each byte
// goes into a half's low mantissa under the exponent of 1024 (0x6400 | b is
// 1024 + b exactly), xor'd with 0x80 first so a signed byte comes out as
// 1152 + q, and one packed subtract and one packed multiply by the block's
// scale finish it. Bit-identical to the plain path: q * d is exact in fp32
// (8 and 11 significant bits), so its rounding to fp16 is the correctly
// rounded fp16 product the packed multiply computes. A third of the VALU
// work, which in this kernel is matrix clocks (research §2.10).
#ifndef Q8_PK
#define Q8_PK 0
#endif
#if Q8_PK
#define Q8_WORD(DST, at, w, d)                                                                  \
    {                                                                                           \
        uint e01 = ((w) & 0xFFu) | (((w) & 0xFF00u) << 8);                                       \
        uint e23 = (((w) >> 16) & 0xFFu) | (((w) >> 8) & 0xFF0000u);                             \
        f16vec2 d2 = f16vec2(float16_t(d));                                                     \
        f16vec2 h01 = (unpackFloat2x16((e01 ^ 0x00800080u) | 0x64006400u) - f16vec2(1152.0)) * d2; \
        f16vec2 h23 = (unpackFloat2x16((e23 ^ 0x00800080u) | 0x64006400u) - f16vec2(1152.0)) * d2; \
        DST[(at)] = h01.x;                                                                      \
        DST[(at) + 1u] = h01.y;                                                                 \
        DST[(at) + 2u] = h23.x;                                                                 \
        DST[(at) + 3u] = h23.y;                                                                 \
    }
#else
#define Q8_WORD(DST, at, w, d)                                                                  \
    [[unroll]] for (uint b = 0u; b < 4u; ++b) {                                                 \
        uint by = ((w) >> (8u * b)) & 0xFFu;                                                    \
        DST[(at) + b] = float16_t(float(int(by) - int((by >> 7) << 8)) * (d));                  \
    }
#endif
// Q8_TILED (research/rune-vertical.md R10): Rune's experts, quantised by us
// as Q8_0 and laid out for this loop. Within each group of 16 bank rows the
// blocks of one K-step are one 544-byte tile: the 16 rows' fp16 scales, then
// their 16 x 32 int8s row by row. A lane's block is then one scale and two
// 16-byte loads, and a step's loads over a column block are contiguous where
// the GGUF layout puts them 34 bytes into rows 2,992 apart. A group spans the
// same bytes its 16 rows did, so every bank size and offset is Q8_0's.
#ifndef Q8_TILED
#define Q8_TILED 0
#endif
#if QFMT == FMT_Q8_0 && Q8_TILED
#define DEQUANT_BODY(DST)                                                                       \
  [[unroll]] for (uint c = 0u; c < BK; c += 32u) {                                              \
    uint r16 = (MOE_L0_BANK == 1 ? 0u : row) & 15u;                                             \
    uint tile = rb - r16 * ((pc.gemmK / QK) * QB) + ((k0 + c) >> 5) * 544u;                     \
    vec2 dd = unpackHalf2x16(qbank[(tile + r16 * 2u) >> 2]);                                    \
    float d = (r16 & 1u) == 0u ? dd.x : dd.y;                                                   \
    uint qv = (tile + 32u + r16 * 32u) >> 4;                                                    \
    uvec4 qa = qbank4[qv];                                                                      \
    uvec4 qb = qbank4[qv + 1u];                                                                 \
    [[unroll]] for (uint t = 0u; t < 4u; ++t) {                                                 \
        Q8_WORD(DST, dst + c + t * 4u, qa[t], d)                                                \
        Q8_WORD(DST, dst + c + 16u + t * 4u, qb[t], d)                                          \
    }                                                                                           \
  }
#elif QFMT == FMT_Q8_0
// Q8_0 alone is not word-aligned below the row: 34 bytes a block puts the
// int8s at an offset of 2 mod 4 on every other one, so the 32 bytes come out
// of nine words through a rotating window rather than out of eight.
#define DEQUANT_BODY(DST)                                                                       \
  [[unroll]] for (uint c = 0u; c < BK; c += 32u) {                                              \
    uint blk = rb + ((k0 + c) >> 5) * 34u;                                                      \
    uint hw = blk >> 2;                                                                         \
    vec2 dd = unpackHalf2x16(qbank[hw]);                                                        \
    float d = ((blk & 2u) == 0u) ? dd.x : dd.y;                                                 \
    uint base = blk + 2u;                                                                       \
    uint bw = base >> 2;                                                                        \
    bool odd = (base & 2u) != 0u;                                                               \
    uint carry = qbank[bw];                                                                     \
    [[unroll]] for (uint t = 0u; t < 8u; ++t) {                                                 \
        uint nxt = qbank[bw + t + 1u];                                                          \
        uint w = odd ? ((carry >> 16) | (nxt << 16)) : carry;                                   \
        carry = nxt;                                                                            \
        Q8_WORD(DST, dst + c + t * 4u, w, d)                                                    \
    }                                                                                           \
  }
#endif
#endif

DEQUANT_SLAB(dequantB0, sB0)
#if MODE == 0
DEQUANT_SLAB(dequantB1, sB1)
#endif

float sigmoidf(float x) { return 1.0 / (1.0 + exp(-x)); }

// MODE 0's activation on the gate: silu for the LLM, and GELU-tanh for Gemma 4
// (`-DACT_GELU=1`, research/rune-vertical.md R5), PyTorch's
// `gelu(x, approximate="tanh")`. The tanh argument is clamped because Mesa
// lowers tanh through exp and returns NaN past about 44; at 15 it is already
// 1.0 in fp32. A macro, and the GELU function only under its flag, so the
// silu builds' SPIR-V is byte for byte what it was.
#ifndef ACT_GELU
#define ACT_GELU 0
#endif
#if ACT_GELU
float geluf(float g) {
    return 0.5 * g * (1.0 + tanh(clamp(0.7978845608028654 * (g + 0.044715 * g * g * g), -15.0, 15.0)));
}
#define GATE_ACT(g) geluf(g)
#else
#define GATE_ACT(g) g * sigmoidf(g)
#endif

// ---- PIPE (KERNELS.md G5): the K loop as a software pipeline.
//
// The shipped loop is, per K-step, one dependent chain: the permutation
// entries, then the gathered rows they name, then the block headers and
// nibbles, each waited for, unpacked and stored, and only then the fragment
// loads and the MMAs. Nothing of step k+1 is in flight while step k's MMAs
// run, and with one wave a workgroup and four of them a SIMD the chain is
// covered by three other waves in the same phase. The pipeline moves the
// *loads* one step ahead: the bytes a lane will unpack at step k+1 are
// fetched into registers before step k's MMAs issue, so their latency lands
// behind the matrix work instead of in front of it. The unpack itself, the
// LDS slab and the fragment reads are exactly the shipped ones — same
// arithmetic, same order, bit-identical — and the permutation entries, which
// never change across K, are read once before the loop rather than once a
// step.
//
// Written for the up mode over Q4_K at BK 32, which is the kernel a prefill
// token spends a quarter of itself in; the other formats keep the plain
// loop until this one is measured.
#ifndef PIPE
#define PIPE 0
#endif
#if PIPE
#if !((MODE == 0 && (QFMT == FMT_Q4_K || (QFMT == FMT_Q8_0 && Q8_TILED))) || (MODE == 1 && QFMT != FMT_Q4_K && QFMT != FMT_Q5_K)) || BK != 32
#error "PIPE is written for the Q4_K up mode and the block-32 down formats, at BK 32"
#endif
#endif
#if PIPE && MODE == 1
// The down mode's pipeline: B only (its A is read by the fragment loads
// straight from the arena), one column a lane, the block's words fetched
// a step ahead as `uint`s from the word base the plain unpack computes.
// DN_W is the words a step's unpack touches: Q5_1's 24-byte block is six,
// Q4_1's twenty bytes five, Q8_0's 34-byte block reaches nine words past
// its scale through the rotating window, and IQ4_NL's 36-byte pair is
// nine, fetched once per two steps under PIPE 2.
#if QFMT == FMT_Q5_1
#define DN_W 6
#elif QFMT == FMT_Q4_1
#define DN_W 5
#elif QFMT == FMT_IQ4NL
#define DN_W 9
#else
#define DN_W 10
#endif

void pipeFetchDown(uint k0, uint tid, uint bankBase, inout uint fw[DN_W]) {
    if (tid < BN) {
        uint rb = pc.bOff + (bankBase + tid) * ((pc.gemmK / QK) * QB);
#if QFMT == FMT_IQ4NL
        uint m = k0 >> 5;
        if (PIPE < 2 || (m & 1u) == 0u) {
            uint pw = (rb + (m >> 1) * 36u) >> 2;
            [[unroll]] for (uint i = 0u; i < DN_W; ++i) { fw[i] = qbank[pw + i]; }
        }
#elif QFMT == FMT_Q8_0 && Q8_TILED
        // The block's scale (fp32 bits), then the row's 32 int8s as two uvec4.
        uint r16 = (bankBase + tid) & 15u;
        uint tile = rb - r16 * ((pc.gemmK / QK) * QB) + (k0 >> 5) * 544u;
        vec2 dd = unpackHalf2x16(qbank[(tile + r16 * 2u) >> 2]);
        fw[0] = floatBitsToUint((r16 & 1u) == 0u ? dd.x : dd.y);
        uint qv = (tile + 32u + r16 * 32u) >> 4;
        uvec4 qa = qbank4[qv], qb = qbank4[qv + 1u];
        [[unroll]] for (uint i = 0u; i < 4u; ++i) { fw[1u + i] = qa[i]; fw[5u + i] = qb[i]; }
#else
        uint hw = (rb + (k0 >> 5) * QB) >> 2;
        [[unroll]] for (uint i = 0u; i < DN_W; ++i) { fw[i] = qbank[hw + i]; }
#endif
    }
}

// The plain unpack's arithmetic verbatim, off the fetched words.
void pipeUnpackDown(uint k0, uint tid, uint bankBase, uint fw[DN_W]) {
    if (tid < BN) {
        uint dst = tid * LDS_ROW;
#if QFMT == FMT_Q5_1
        vec2 dm = unpackHalf2x16(fw[0]);
        uint qh = fw[1];
        [[unroll]] for (uint t = 0u; t < 4u; ++t) {
            uint w = fw[2u + t];
            [[unroll]] for (uint b = 0u; b < 4u; ++b) {
                uint j = t * 4u + b;
                uint by = (w >> (8u * b)) & 0xFFu;
                uint lo = (by & 0xFu) | (((qh >> j) & 1u) << 4);
                uint hi = (by >> 4) | (((qh >> (j + 16u)) & 1u) << 4);
                sB0[dst + j] = Q_AFFINE_ADD(lo, dm.x, dm.y);
                sB0[dst + j + 16u] = Q_AFFINE_ADD(hi, dm.x, dm.y);
            }
        }
#elif QFMT == FMT_Q4_1
        vec2 dm = unpackHalf2x16(fw[0]);
        [[unroll]] for (uint t = 0u; t < 4u; ++t) {
            uint w = fw[1u + t];
            [[unroll]] for (uint b = 0u; b < 4u; ++b) {
                uint j = t * 4u + b;
                uint by = (w >> (8u * b)) & 0xFFu;
                sB0[dst + j] = float16_t(float(by & 0xFu) * dm.x + dm.y);
                sB0[dst + j + 16u] = float16_t(float(by >> 4) * dm.x + dm.y);
            }
        }
#elif QFMT == FMT_IQ4NL
        uint m = k0 >> 5;
        vec2 dd = unpackHalf2x16(fw[0]);
        float d = ((m & 1u) == 0u) ? dd.x : dd.y;
        uint bw = 1u + (m & 1u) * 4u;
        [[unroll]] for (uint t = 0u; t < 4u; ++t) {
            uint w = fw[bw + t];
            [[unroll]] for (uint b = 0u; b < 4u; ++b) {
                uint j = t * 4u + b;
                uint by = (w >> (8u * b)) & 0xFFu;
                sB0[dst + j] = float16_t(kIQ4[by & 0xFu] * d);
                sB0[dst + j + 16u] = float16_t(kIQ4[by >> 4] * d);
            }
        }
#elif QFMT == FMT_Q8_0 && Q8_TILED
        float d = uintBitsToFloat(fw[0]);
        [[unroll]] for (uint t = 0u; t < 8u; ++t) {
            Q8_WORD(sB0, dst + t * 4u, fw[1u + t], d)
        }
#else
        // Q8_0: the plain body's rotating window over the fetched words,
        // with the block's byte parity recomputed from the same address.
        uint rb = pc.bOff + (bankBase + tid) * ((pc.gemmK / QK) * QB);
        uint blk = rb + (k0 >> 5) * 34u;
        vec2 dd = unpackHalf2x16(fw[0]);
        float d = ((blk & 2u) == 0u) ? dd.x : dd.y;
        uint base = blk + 2u;
        uint bo = (base >> 2) - (blk >> 2);
        bool odd = (base & 2u) != 0u;
        uint carry = fw[bo];
        [[unroll]] for (uint t = 0u; t < 8u; ++t) {
            uint nxt = fw[bo + t + 1u];
            uint w = odd ? ((carry >> 16) | (nxt << 16)) : carry;
            carry = nxt;
            [[unroll]] for (uint b = 0u; b < 4u; ++b) {
                uint by = (w >> (8u * b)) & 0xFFu;
                sB0[dst + t * 4u + b] = float16_t(float(int(by) - int((by >> 7) << 8)) * d);
            }
        }
#endif
    }
}
#endif
#if PIPE && MODE == 0
#define A_ITERS ((BM * (BK / A_VEC)) / LANES)
#if A_ITERS * LANES != BM * (BK / A_VEC)
#error "PIPE wants the gathered rows' loads to divide the lanes"
#endif
#if LANES == 64
#define B_ITERS 2
#else
#define B_ITERS ((2 * BN + LANES - 1) / LANES)
#endif

// One lane's share of a step's bytes: A_ITERS gathered `uvec4` of the block
// input, and for each slab column it unpacks the block header and the two
// `uvec4` of nibbles P12 reads.
void pipeFetch(uint k0, uint tid, uint bankBase, uint aP[A_ITERS],
    out uvec4 aV[A_ITERS], inout uvec4 hdr[B_ITERS], inout uvec4 lo[B_ITERS], inout uvec4 hi[B_ITERS]) {
    uint slots = MOE_USED + 1u;
#if PIPE_A
    [[unroll]] for (uint n = 0u; n < A_ITERS; ++n) {
        uint idx = tid + n * LANES;
        uint r = idx / (BK / A_VEC);
        uint c = (idx - r * (BK / A_VEC)) * A_VEC;
        aV[n] = hact4[(pc.xnOff + (aP[n] / slots) * pc.lda + k0 + c) / A_VEC];
    }
#endif
    [[unroll]] for (uint n = 0u; n < B_ITERS; ++n) {
#if LANES == 64
        // Pass n is slab n's column tid (the unpack's static split).
        uint r = tid + n * BN;
        if (tid < BN) {
#else
        uint r = tid + n * LANES;
        if (r < 2u * BN) {
#endif
            uint base = r < BN ? pc.bOff : pc.moeBOff2;
            uint row = bankBase + (r < BN ? r : r - BN);
            uint rb = base + row * ((pc.gemmK / QK) * QB);
#if QFMT == FMT_Q8_0
            // Q8_TILED: hdr.x the block's scale (fp32 bits), lo and hi its 32 int8s.
            uint r16 = row & 15u;
            uint tile = rb - r16 * ((pc.gemmK / QK) * QB) + (k0 >> 5) * 544u;
            vec2 dd = unpackHalf2x16(qbank[(tile + r16 * 2u) >> 2]);
            hdr[n].x = floatBitsToUint((r16 & 1u) == 0u ? dd.x : dd.y);
            uint qv = (tile + 32u + r16 * 32u) >> 4;
            lo[n] = qbank4[qv];
            hi[n] = qbank4[qv + 1u];
        }
    }
}
#else
            uint blk = rb + (k0 >> 8) * 144u;
            uint g = (k0 & 255u) >> 6;
            uint qv = (blk + 16u + g * 32u) >> 4;
#if PIPE >= 2
            // The header serves eight steps and a nibble group two: fetch
            // each once, on the step that enters it, and keep it. The
            // bytes a step reads are then read once from the cache instead
            // of two to eight times, for the same sixty-four lines a load.
            if ((k0 & 255u) == 0u) {
                hdr[n] = qbank4[blk >> 4];
            }
            if ((k0 & 63u) == 0u) {
                lo[n] = qbank4[qv];
                hi[n] = qbank4[qv + 1u];
            }
#else
            hdr[n] = qbank4[blk >> 4];
            lo[n] = qbank4[qv];
            hi[n] = qbank4[qv + 1u];
#endif
        }
    }
}
#endif

// The same bytes unpacked into the slabs, the shipped arithmetic verbatim:
// the A halves are a reinterpretation, the B values `Q_AFFINE` in the same
// order the plain loop writes them.
#if QFMT == FMT_Q8_0
#define PIPE_UNPACK_COL(DST, n)                                                             \
    {                                                                                       \
        uint dst = col * LDS_ROW;                                                           \
        float d = uintBitsToFloat(hdr[n].x);                                                \
        [[unroll]] for (uint t = 0u; t < 4u; ++t) {                                         \
            Q8_WORD(DST, dst + t * 4u, lo[n][t], d)                                         \
            Q8_WORD(DST, dst + 16u + t * 4u, hi[n][t], d)                                   \
        }                                                                                   \
    }
#else
#define PIPE_UNPACK_COL(DST, n)                                                             \
    {                                                                                       \
        uint dst = col * LDS_ROW;                                                           \
        uint within = k0 & 255u;                                                            \
        uint g = within >> 6;                                                               \
        uint sub = (within >> 5) & 1u;                                                      \
        vec2 dd = unpackHalf2x16(hdr[n].x);                                                 \
        uint sc, mn;                                                                        \
        scaleMinK4(2u * g + sub, hdr[n].yzw, sc, mn);                                       \
        float ds = dd.x * float(sc) * Q4K_SCALE(sub);                                       \
        float dm = dd.y * float(mn);                                                        \
        uint sh = sub * 4u;                                                                 \
        uint nmask = Q4K_MASK(sub);                                                         \
        [[unroll]] for (uint t = 0u; t < 8u; ++t) {                                         \
            uint w = (t < 4u) ? lo[n][t] : hi[n][t - 4u];                                   \
            Q4K_WORD(DST, dst + t * 4u, w)                                                  \
        }                                                                                   \
    }
#endif

void pipeUnpack(uint k0, uint tid, uint aP[A_ITERS], uvec4 aV[A_ITERS], uvec4 hdr[B_ITERS], uvec4 lo[B_ITERS], uvec4 hi[B_ITERS]) {
    [[unroll]] for (uint n = 0u; n < A_ITERS; ++n) {
        uint idx = tid + n * LANES;
        uint r = idx / (BK / A_VEC);
        uint c = (idx - r * (BK / A_VEC)) * A_VEC;
        uint dst = r * LDS_ROW + c;
#if !PIPE_A
        aV[n] = hact4[(pc.xnOff + (aP[n] / (MOE_USED + 1u)) * pc.lda + k0 + c) / A_VEC];
#endif
        [[unroll]] for (uint w = 0u; w < 4u; ++w) {
            f16vec2 h = unpackFloat2x16(aV[n][w]);
            sA[dst + 2u * w] = h.x;
            sA[dst + 2u * w + 1u] = h.y;
        }
    }
#if LANES == 64 && BN == 64
    // One wave over the full column block: its first pass is the gate
    // slab's column tid, its second the up slab's, statically.
    { uint col = tid; PIPE_UNPACK_COL(sB0, 0) }
    { uint col = tid; PIPE_UNPACK_COL(sB1, 1) }
#elif LANES == 64
    // One wave over a narrow block (the n-rungs): the same two passes, the
    // lanes past BN idle in each.
    if (tid < BN) { uint col = tid; PIPE_UNPACK_COL(sB0, 0) }
    if (tid < BN) { uint col = tid; PIPE_UNPACK_COL(sB1, 1) }
#else
    {
        uint r = tid;
        if (r < BN) {
            uint col = r;
            PIPE_UNPACK_COL(sB0, 0)
        } else if (r < 2u * BN) {
            uint col = r - BN;
            PIPE_UNPACK_COL(sB1, 0)
        }
    }
#endif
}
#endif

void main() {
    uint tid = gl_LocalInvocationID.x;
    // Which rows of the tile this wave owns. Every cooperative-matrix op
    // below is subgroup-scoped, so the waves share LDS and nothing else.
    uint wrow = (tid / WAVE) * (WM * TILE);
    uint tileIdx = gl_WorkGroupID.y;
    // Every row block past the schedule's end returns before it reads a
    // weight. The grid is a static upper bound — ceil(tokens*used/BM) plus
    // one partial block per expert — because the real count is only known on
    // the device, and an empty workgroup costs a launch.
    if (tileIdx >= actu[pc.moeTileOff]) {
        return;
    }
    uint rec = pc.moeTileOff + 2u + 3u * tileIdx;
    uint expert = actu[rec];
    uint rowStart = actu[rec + 1u];
    // The record's third word is how many of the block's rows are real. A
    // plain build never reads it: the schedule pads every expert's range to
    // the block, so a record's block is full by construction. A SHORT build
    // rounds it up to the schedule's alignment (`pc.gemmM`, `MoEGPU.pad`) and
    // runs that many fragments of rows — the whole block under a wide
    // alignment, the last tiles skipped under a narrow one.
#if SHORT && WM > 1
    uint blkRows = ((actu[rec + 2u] + pc.gemmM - 1u) / pc.gemmM) * pc.gemmM;
    uint wmReal = max((blkRows + TILE - 1u) / TILE, 1u);
    uint wmEff = (wmReal + SHORT_STEP - 1u) / SHORT_STEP * SHORT_STEP;
#endif
    uint n0 = gl_WorkGroupID.x * BN;
    uint slots = MOE_USED + 1u;

    // Expert e's output row n is bank row e*gemmN + n, which is what makes a
    // three-axis GGUF tensor addressable without a stride table.
    uint bankBase = expert * pc.gemmN + n0;

    ACC_T acc0[WM][WN];
#if MODE == 0
    ACC_T acc1[WM][WN];
#endif
    [[unroll]] for (uint i = 0u; i < WM; i++) {
        [[unroll]] for (uint j = 0u; j < WN; j++) {
            acc0[i][j] = ACC_T(0.0);
#if MODE == 0
            acc1[i][j] = ACC_T(0.0);
#endif
        }
    }

#if QFMT == FMT_IQ4NL
    // Before the first slab: the codebook, and the only barrier in this
    // kernel that is not the K loop's own.
    if (tid < 16u) {
        kIQ4[tid] = iq4nlConst(tid);
    }
    barrier();
#endif

// ---- The MMA block, one K-step of fragments out of the slabs, as a macro
// so the pipelined loop below can issue it twice a trip without a second
// copy of the text. The `#if`s it needs are resolved into the helpers first
// (a macro body cannot hold a directive).
#if MODE == 0
#define LOAD_A(dst, i, kt, K0)                                                             \
    coopMatLoad(dst, sA, (wrow + (i) * TILE) * LDS_ROW + (kt) * TILE, LDS_ROW,             \
        gl_CooperativeMatrixLayoutRowMajor);
#define LOAD_A2(dst, i, kt, K0)                                                            \
    coopMatLoad(dst, sA, (wrow + (i) * TILE) * LDS_ROW + (kt) * TILE + f2, LDS_ROW,        \
        gl_CooperativeMatrixLayoutRowMajor);
#else
// MODE 1's rows are permutation positions and so contiguous: no gather, and
// the overhang past this expert reads the next one's swiglu rows and is
// thrown away at the store.
#define LOAD_A(dst, i, kt, K0)                                                             \
    coopMatLoad(dst, hact,                                                                 \
        pc.ctxOff + (rowStart + wrow + (i) * TILE) * pc.ldCtx + (K0) + (kt) * TILE, pc.ldCtx, \
        gl_CooperativeMatrixLayoutRowMajor);
#define LOAD_A2(dst, i, kt, K0)                                                            \
    coopMatLoad(dst, hact,                                                                 \
        pc.ctxOff + (rowStart + wrow + (i) * TILE) * pc.ldCtx + (K0) + (kt) * TILE + f2, pc.ldCtx, \
        gl_CooperativeMatrixLayoutRowMajor);
#endif
#if MOE_FRAG2
// The same fragments again at an address the compiler cannot fold onto the
// first (pc.moeUsed's top bits are zero), consumed by the second half of
// each grid so neither copy is dead.
#define FRAG2_A(kt, K0)                                                                    \
    FRAG_A_T fragA2[WM];                                                                   \
    [[unroll]] for (uint i = 0u; i < WM; i++) { LOAD_A2(fragA2[i], i, kt, K0) }
#define FRAG2_B(SLAB, j, kt)                                                               \
    coopMatLoad(fragB2, SLAB, ((j) * TILE) * LDS_ROW + (kt) * TILE + f2, LDS_ROW,          \
        gl_CooperativeMatrixLayoutColumnMajor);
#define FRAG2_B_DECL FRAG_B_T fragB2;
// The four ways an MMA can pick its copies, on unrolled indices, so each is
// a folded branch and not a select (SPIR-V has no select on a cooperative
// matrix).
#define MMA_AT(ACC, i, j, B, B2)                                                           \
    if ((j) < WN / 2u) {                                                                  \
        if ((i) < WM / 2u) { ACC = coopMatMulAdd(fragA[i], B, ACC); }                     \
        else               { ACC = coopMatMulAdd(fragA[i], B2, ACC); }                    \
    } else {                                                                              \
        if ((i) < WM / 2u) { ACC = coopMatMulAdd(fragA2[i], B, ACC); }                    \
        else               { ACC = coopMatMulAdd(fragA2[i], B2, ACC); }                   \
    }
#else
#define FRAG2_A(kt, K0)
#define FRAG2_B(SLAB, j, kt)
#define FRAG2_B_DECL
#define fragB2 fragB
#define MMA_AT(ACC, i, j, B, B2) ACC = coopMatMulAdd(fragA[i], B, ACC);
#endif
#if MODE == 0
#define MMA_UP(j, kt, WME)                                                                 \
    coopMatLoad(fragB, sB1, ((j) * TILE) * LDS_ROW + (kt) * TILE, LDS_ROW,                 \
        gl_CooperativeMatrixLayoutColumnMajor);                                            \
    FRAG2_B(sB1, j, kt)                                                                    \
    [[unroll]] for (uint i = 0u; i < (WME); i++) { MMA_AT(acc1[i][j], i, j, fragB, fragB2) }
#else
#define MMA_UP(j, kt, WME)
#endif
// WME is how many of the wave's WM row tiles this block has (SHORT), or WM.
#define MMA_BLOCK(K0, WME)                                                                 \
    KT_UNROLL for (uint kt = 0u; kt < BK_TILES; kt++) {                                    \
        FRAG_A_T fragA[WM];                                                                \
        [[unroll]] for (uint i = 0u; i < (WME); i++) { LOAD_A(fragA[i], i, kt, K0) }       \
        FRAG2_A(kt, K0)                                                                    \
        [[unroll]] for (uint j = 0u; j < WN; j++) {                                        \
            FRAG_B_T fragB;                                                                \
            FRAG2_B_DECL                                                                   \
            coopMatLoad(fragB, sB0, ((j) * TILE) * LDS_ROW + (kt) * TILE, LDS_ROW,         \
                gl_CooperativeMatrixLayoutColumnMajor);                                    \
            FRAG2_B(sB0, j, kt)                                                            \
            [[unroll]] for (uint i = 0u; i < (WME); i++) { MMA_AT(acc0[i][j], i, j, fragB, fragB2) } \
            MMA_UP(j, kt, WME)                                                             \
        }                                                                                  \
    }
#if MOE_FRAG2
    uint f2 = pc.moeUsed >> 20;
#endif

// ---- The K loop, as a macro over WME so a SHORT build can hold one copy
// per block height. What comes before it (the pipeline's first fetch) is
// shared by every copy; each copy is the loop and the store.
#if PIPE && MODE == 1
    uint fw[DN_W];
    pipeFetchDown(0u, tid, bankBase, fw);
#define K_LOOP(WME)                                                                        \
    for (uint k0 = 0u; k0 < pc.gemmK; k0 += BK) {                                          \
        pipeUnpackDown(k0, tid, bankBase, fw);                                             \
        uint kn = k0 + BK;                                                                 \
        pipeFetchDown(kn < pc.gemmK ? kn : k0, tid, bankBase, fw);                         \
        barrier();                                                                         \
        MMA_BLOCK(k0, WME)                                                                 \
        barrier();                                                                         \
    }
#elif PIPE
    // The permutation entries once, then step 0's bytes in flight before
    // the loop; every step unpacks what it holds and fetches the next
    // step's into the same registers (their old values are dead by then).
    // A two-set form, so the fetch could be hoisted above the unpack, was
    // measured: it spills at m4 and buys nothing where it fits.
    uint aP[A_ITERS];
    [[unroll]] for (uint n = 0u; n < A_ITERS; ++n) {
        uint r = (tid + n * LANES) / (BK / A_VEC);
        aP[n] = actu[pc.moePermOff + rowStart + r];
    }
    uvec4 pA[A_ITERS], pH[B_ITERS], pL[B_ITERS], pI[B_ITERS];
    pipeFetch(0u, tid, bankBase, aP, pA, pH, pL, pI);
    // The next step's bytes, or this step's again at the end (in bounds,
    // never read back).
#define K_LOOP(WME)                                                                        \
    for (uint k0 = 0u; k0 < pc.gemmK; k0 += BK) {                                          \
        pipeUnpack(k0, tid, aP, pA, pH, pL, pI);                                           \
        uint kn = k0 + BK;                                                                 \
        pipeFetch(kn < pc.gemmK ? kn : k0, tid, bankBase, aP, pA, pH, pL, pI);             \
        barrier();                                                                         \
        MMA_BLOCK(k0, WME)                                                                 \
        barrier();                                                                         \
    }
#else
    // The plain loop's staging, one K-step of it.
#if MODE == 0 && !MOE_NO_ASTAGE
    // The A operand is gathered: BM rows of the block input, named by the
    // permutation and belonging to BM different tokens.
    //
    // **Eight halves a load, not one** (P11). This loop used to run
    // `BM * BK / LANES` times — 32 iterations a lane a K-step at BM 64 —
    // and each iteration fetched *two bytes*, where the B unpack below
    // fetches 32 in one `uvec4`. It is the same finding L5b-7 made about
    // the unpack, on the operand instead of the weight: the kernel is
    // bound by how many load instructions it issues. A K-step is BK
    // halves, so a row is `BK / A_VEC` sixteen-byte loads and the
    // permutation entry behind it is read once per load rather than once
    // per half. Bit for bit the same slab: `unpackFloat2x16` is a
    // reinterpretation, the LDS layout is unchanged, and the loop covers
    // the same (r, c) in the same order.
#define STAGE_A(K0)                                                                        \
    for (uint idx = tid; idx < BM * (BK / A_VEC); idx += LANES) {                          \
        uint r = idx / (BK / A_VEC);                                                       \
        uint c = (idx - r * (BK / A_VEC)) * A_VEC;                                         \
        uint p = MOE_L0_A != 0 ? 0u : actu[pc.moePermOff + rowStart + r];                  \
        uvec4 v = hact4[(pc.xnOff + (p / slots) * pc.lda + (K0) + c) / A_VEC];             \
        uint dst = r * LDS_ROW + c;                                                        \
        [[unroll]] for (uint w = 0u; w < 4u; ++w) {                                        \
            f16vec2 h = unpackFloat2x16(v[w]);                                             \
            sA[dst + 2u * w] = h.x;                                                        \
            sA[dst + 2u * w + 1u] = h.y;                                                   \
        }                                                                                  \
    }
#else
#define STAGE_A(K0)
#endif
#if MOE_NO_UNPACK
#define STAGE_B(K0)
#elif MODE == 0
    // The two matrices are one staging pass, so every lane of every wave
    // has a row to unpack rather than half of them idling.
#define STAGE_B(K0)                                                                        \
    for (uint r = tid; r < 2u * BN; r += LANES) {                                          \
        if (r < BN) {                                                                      \
            dequantB0(pc.bOff, bankBase + r, K0, r);                                       \
        } else {                                                                           \
            dequantB1(pc.moeBOff2, bankBase + r - BN, K0, r - BN);                         \
        }                                                                                  \
    }
#else
#define STAGE_B(K0)                                                                        \
    for (uint r = tid; r < BN; r += LANES) {                                               \
        dequantB0(pc.bOff, bankBase + r, K0, r);                                           \
    }
#endif
#define K_LOOP(WME)                                                                        \
    for (uint k0 = 0u; k0 < pc.gemmK; k0 += BK) {                                          \
        STAGE_A(k0)                                                                        \
        STAGE_B(k0)                                                                        \
        barrier();                                                                         \
        MMA_BLOCK(k0, WME)                                                                 \
        barrier();                                                                         \
    }
#endif

    // ---- The epilogue. MODE 0 applies `ggml_swiglu_split(gate, up)` =
    // silu(gate)*up on the accumulators, so the [rows, ffn] pair the
    // reference materialises never exists; MODE 1 writes the down
    // projection's rows where they already are, in permutation order, and
    // leaves the routing weight to the combine — which has to read every one
    // of these values once anyway, and which is the only place that knows
    // which (token, slot) a row belongs to without a gather.
#if MODE == 0
#define STORE_TILE(i, j)                                                                   \
    {                                                                                      \
        ACC16_T sw;                                                                        \
        [[unroll]] for (uint e = 0u; e < acc0[i][j].length(); e++) {                       \
            float g = float(acc0[i][j][e]);                                                \
            sw[e] = float16_t(GATE_ACT(g) * float(acc1[i][j][e]));                         \
        }                                                                                  \
        coopMatStore(sw, hact,                                                             \
            pc.ctxOff + (rowStart + wrow + (i) * TILE) * pc.ldCtx + n0 + (j) * TILE,       \
            pc.ldCtx, gl_CooperativeMatrixLayoutRowMajor);                                 \
    }
#else
#define STORE_TILE(i, j)                                                                   \
    coopMatStore(acc0[i][j], act,                                                          \
        pc.gatedOff + (rowStart + wrow + (i) * TILE) * pc.nEmbd + n0 + (j) * TILE, pc.nEmbd, \
        gl_CooperativeMatrixLayoutRowMajor);
#endif
// A rounded-up copy computes tiles the block does not have; it must not
// store them (the rows are the next expert's). A uniform branch, in the
// epilogue only.
#if SHORT && WM > 1 && SHORT_STEP > 1
#define STORE_IF(i) if ((i) < wmReal)
#else
#define STORE_IF(i)
#endif
#define EPILOGUE(WME)                                                                      \
    [[unroll]] for (uint i = 0u; i < (WME); i++) {                                         \
        STORE_IF(i) {                                                                      \
            [[unroll]] for (uint j = 0u; j < WN; j++) {                                    \
                STORE_TILE(i, j)                                                           \
            }                                                                              \
        }                                                                                  \
    }

#if SHORT && WM > 1
    // One copy of the loop and the store per block height, on a uniform
    // switch: the block's fragments are the record's, the widest is the
    // default so no clamp is needed.
    switch (wmEff) {
#if WM > 3 && SHORT_STEP == 1
    case 3u: { K_LOOP(3u) EPILOGUE(3u) break; }
#endif
#if WM > 2
    case 2u: { K_LOOP(2u) EPILOGUE(2u) break; }
#endif
#if SHORT_STEP == 1
    case 1u: { K_LOOP(1u) EPILOGUE(1u) break; }
#endif
    default: { K_LOOP(WM) EPILOGUE(WM) break; }
    }
#else
    K_LOOP(WM)
    EPILOGUE(WM)
#endif
}
