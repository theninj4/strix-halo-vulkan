#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// Narrow an fp32 [rows, C] activation into the fp16 arena as the A operand of
// shaders/dit_gemm.comp: same rows, row stride pc.lda rather than C.
//
// The pad is why the stride is its own field. A fragment load of A issues 16
// addresses one row apart, so an unpadded 512-column row -- 1 KB, a quarter
// of the 4 KB channel rotation -- would put all sixteen in the same DRAM
// channels (§2.3). The pad columns are never read: the reduction stops at
// pc.gemmK.
//
// Rows past pc.aux0 are the GEMM's tile padding. They are written as zeros so
// that whatever the arena held before cannot become an infinity in an operand
// -- the pad rows of C are ignored, but a NaN in A is cheaper to prevent here
// than to explain later.
//
// One workgroup per row, which makes both sides contiguous.

#include "vae_common.glsl"

layout(binding = 2) writeonly buffer HAct { float16_t hact[]; };

#define WG 256
layout(local_size_x = WG) in;

void main() {
    uint r = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    bool live = r < pc.aux0;
    for (uint c = tid; c < pc.C; c += WG) {
        hact[pc.outOff + r * pc.lda + c] = live
            ? float16_t(act[pc.inOff + r * pc.C + c])
            : float16_t(0.0);
    }
}
