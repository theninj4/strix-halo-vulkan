#version 450

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

// The QSA indexer's score: llama.cpp's MUL_MAT f32 + RELU + SUM_ROWS and the
// adds around them, one workgroup a (token, stripe).
//
// **The expansion to cells left here in P9** and is
// `llm_attn_expand.comp`. It had to: it reads every block's score, so it was
// a `barrier()` behind this loop, and a barrier is what pinned the whole
// kernel to one workgroup. A decode step is one token, so the grid was
// (1, 1) — one compute unit of forty scoring every pooled block of the
// context, which at 65 536 cells was 0.304 ms a token a layer and the
// largest kernel left in the block once P8 had split the attention. Two
// dispatches is the same ordering without that constraint, and the grid's y
// is now a stripe of the blocks.
//
// The scorer is not attention and the difference is the rectifier. Each of the
// four heads dots its 128-wide query against a block's pooled key and the
// **positive** parts are summed: a head that disagrees contributes nothing
// rather than cancelling a head that agrees, which is DeepSeek's lightning
// indexer and is why there is no softmax anywhere in here.
//
// **Both operands are F32 tensors and the reference still evaluates this in
// fp16** (research/l2e-attention.md): computing it in f32 gives 3.52e-03 rms
// against llama.cpp, computing it in *float64* gives the same 3.52e-03 — so it
// is not precision on our side — and rounding both operands to halves gives
// 5.11e-05. The backend is putting an f32 matmul on the fp16 matrix cores. Our
// operands arrive as halves from llm_attn_idx.comp, so this kernel is that
// arithmetic rather than a model of it, and the fp16 the whole vertical
// computes in concedes nothing the reference keeps.
//
// The bias is the part that cannot be inferred from the graph.
//
//	a block past the last whole one      -inf, it does not exist
//	a block at or after this token's
//	  incomplete tail                    1e9, "always visible"
//	the spare block that collects every
//	  unpooled cell                      1e9
//	anything else                        0
//
// **Everything here counts cells, not tokens** (L7a). Token t of the run is
// cell SEQ_PAST + t, the cache holds SEQ_PAST + T of them, and the causal
// mask compares a cell against this token's *position*. On a fresh sequence
// SEQ_PAST is zero and every line below is what it was.
//
// 1e9 and not an infinity, so that it can never meet the mask's -inf and make
// a NaN. And the expansion to cells routes every cell past the last whole
// block to that one spare block, which is what makes the incomplete tail
// visible without giving it a score.
//
// What this kernel does **not** do is the selection. `top_k + ratio - 1` is
// 2051 against a 256-cell cache, so it names every cell and is bit-identical
// to not selecting at all — and llama.cpp's own TOP_K turns out to be a
// selection and not a sort, returning the identity permutation here. Neither
// the width nor the order is observable until the context is longer than
// top_k, so the selection is L4's, with a dump to check it against; the
// attention kernel beside this one runs dense causal, which at this width is
// the same computation.

#include "llm_common.glsl"

#ifndef IDX_DIM
#define IDX_DIM 128
#endif
#ifndef IDX_HEADS
#define IDX_HEADS 4
#endif
#define WG 256

layout(local_size_x = WG) in;

// This token's queries, read once and then hit by every block.
shared float16_t qs[IDX_HEADS * IDX_DIM];

// The one score every block past the last whole one has. See below.
shared float deadScore;

void main() {
    uint t = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (t >= pc.tokens) {
        return;
    }
    uint pos = SEQ_PAST + t;
    uint nCells = SEQ_PAST + pc.tokens;
    uint nBlocks = (pc.nKV + pc.ratio - 1u) / pc.ratio;
    uint nBid = nCells / pc.ratio;
    uint deadBid = (nBid >= nBlocks) ? nBlocks - 1u : nBid;

    for (uint i = tid; i < IDX_HEADS * IDX_DIM; i += WG) {
        qs[i] = hact[pc.idxQOff + t * IDX_HEADS * IDX_DIM + i];
    }
    barrier();

    // **Only the whole blocks are scored** (P7). Every block at or past `nBid`
    // pools cell 0 `ratio` times and is unrotated (llm_attn_idx.comp says so,
    // and TestAttnGPUEmptyBlocksPoolCellZero checks it), so all of them hold
    // *the same* 128 halves and therefore the same score — one dot product,
    // not `nBlocks - nBid` of them.
    //
    // This is what makes the kernel cost the context's **depth** instead of
    // the cache's **size**. The table is nKV/ratio rows wide however few cells
    // exist, so scoring it row by row charged a 131k-cell cache 32 768 dots a
    // token a layer at every depth, empty or not — 6.94 ns a cell a token a
    // layer measured at depth zero, which is 11.4 ms of a decode step across
    // the twelve attention layers before the first cell is real. The tensor
    // this writes is unchanged: every dead row still gets its value, and the
    // value is still the one the pooled key implies.
    uint first = gl_WorkGroupID.y * WG + tid;
    uint step = gl_NumWorkGroups.y * WG;
    for (uint b = first; b < nBid && b < nBlocks; b += step) {
        uint kb = pc.idxKOff + b * IDX_DIM;
        float s = 0.0;
        [[unroll]] for (uint h = 0u; h < IDX_HEADS; h++) {
            float d = 0.0;
            for (uint j = 0u; j < IDX_DIM; j++) {
                d += float(qs[h * IDX_DIM + j]) * float(hact[kb + j]);
            }
            s += max(d, 0.0);
        }
        act[pc.scoreOff + t * nBlocks + b] = s;
    }
    if (nBid < nBlocks) {
        if (tid == 0u) {
            uint kb = pc.idxKOff + nBid * IDX_DIM;
            float s = 0.0;
            [[unroll]] for (uint h = 0u; h < IDX_HEADS; h++) {
                float d = 0.0;
                for (uint j = 0u; j < IDX_DIM; j++) {
                    d += float(qs[h * IDX_DIM + j]) * float(hact[kb + j]);
                }
                s += max(d, 0.0);
            }
            deadScore = s;
        }
        barrier();
        float dead = deadScore;
        for (uint b = nBid + first; b < nBlocks; b += step) {
            act[pc.scoreOff + t * nBlocks + b] = dead;
        }
    }
}
