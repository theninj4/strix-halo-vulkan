#version 450

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

// Same as softmax_shared.comp but both reductions use subgroupMax/subgroupAdd;
// workgroup size must equal this device's subgroup size (64).
layout(local_size_x = 64) in;

layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) writeonly buffer Y { float y[]; };

layout(push_constant) uniform PC {
    uint rows;
    uint n;
} pc;

shared float rowMaxShared;
shared float rowSumShared;

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.rows) {
        return;
    }
    uint base = row * pc.n;
    uint tid = gl_LocalInvocationID.x;

    float m = -3.402823e38;
    for (uint i = tid; i < pc.n; i += gl_WorkGroupSize.x) {
        m = max(m, x[base + i]);
    }
    float groupMax = subgroupMax(m);
    if (subgroupElect()) {
        rowMaxShared = groupMax;
    }
    barrier();
    float rowMax = rowMaxShared;

    float sum = 0.0;
    for (uint i = tid; i < pc.n; i += gl_WorkGroupSize.x) {
        sum += exp(x[base + i] - rowMax);
    }
    float groupSum = subgroupAdd(sum);
    if (subgroupElect()) {
        rowSumShared = groupSum;
    }
    barrier();
    float rowSum = rowSumShared;

    for (uint i = tid; i < pc.n; i += gl_WorkGroupSize.x) {
        y[base + i] = exp(x[base + i] - rowMax) / rowSum;
    }
}
