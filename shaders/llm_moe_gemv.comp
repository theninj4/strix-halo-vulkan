#version 450

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_clustered : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_control_flow_attributes : enable

// The grouped expert GEMM **at one token** (LLM.md L8d).
//
// `llm_moe_gemm.comp` is the same two modes as a cooperative-matrix GEMM, and
// at prefill it is the right kernel: a workgroup unpacks a BN x BK slab of the
// checkpoint's own Q4_K into LDS per K-step and multiplies it by BM rows of A,
// so the unpack — which is most of what the block does — is amortised over
// sixteen to sixty-four rows. **At decode there is one row.** Every row block
// is fifteen sixteenths padding, the slab is unpacked for one real row, and
// the loop that does it is a barrier, a dependent load and a consume per
// K-step with one wave in flight per workgroup: 93 GB/s of a 242 GB/s bus on
// the up mode and 46 on the shared expert's, against the lm head's 194 on the
// same kind of bank (L7d-3, L8b).
//
// So this is the other kernel, and the three things it changes are the three
// leads L8d names:
//
//   **the grid** — a workgroup is LPR lanes per output column and NCOL
//   columns, so the up mode's grid is (640/NCOL) x tiles rather than
//   (640/BN) x tiles: hundreds to thousands of workgroups where the GEMM has
//   ten to four hundred, on a 40-CU device that was short of workgroups and
//   not of rows (D11);
//
//   **the LDS round trip** — there is none. A lane unpacks its own dwords of
//   the weight straight into registers and multiplies them there. §2.2's rule
//   that nibbles cannot be unpacked into a cooperative-matrix *fragment*
//   still holds; it says nothing about a dot product, which has no fragment.
//   The A vector is the only thing in LDS, staged once for the whole
//   workgroup rather than once per K-step;
//
//   **the loads** — a lane's dwords are independent of each other and of
//   every barrier, so the whole row's worth of loads is in flight at once
//   instead of one K-step's being issued and immediately consumed (§2.7).
//
// **It is a decode kernel and it says so.** A tile is (expert, row block) and
// this reads ROWS rows of it from the base — one when the batch is a single
// token, because the top-k of one token names ten distinct experts with one
// row each and the permutation puts that row at the tile's base. The host
// refuses the rung above ROWS rather than this silently dropping rows.
//
// **ROWS is P5b.** A verification pass is two rows (research/p5a-draft-head.md
// §3) and the GEMM the host used to fall back to costs this block **5.8x** at
// two tokens — 196 us a layer to 1149 — of which most is padding: the grouped
// GEMM executes 544 tile-rows to compute 20 real ones. A dot product extends
// to R rows for the price of R A-vectors in LDS and R accumulators; the bank
// is read once for all of them, which is the whole point, since the bank is
// what the block is made of.
//
// **The padded rows are safe to compute, because the permutation guards
// them**, and since CONCURRENCY.md C5 they are not computed. `llm_moe_perm.comp`
// fills every routed row with a sentinel — `(token, slot)` one token past the
// batch, whose activation row is a zero pad — before the scatter overwrites
// the real ones, so a padding row multiplies by zeros and writes into output
// slots the combine does not read. That made them harmless and, at P5b's two
// rows of one sequence, nearly free: consecutive tokens share experts, so
// most tiles had two real rows. Three *conversations* do not: of the ~27
// experts a three-row pass touches, most serve one row, so two-thirds of the
// work was padding, and `moe.up` grew 4.9x from one row to three where its
// bank grew 2.7x. The tile record's third word is now the tile's real row
// count, and every loop below stops at it — a branch that is uniform across
// the workgroup, because a workgroup is a tile.
//
// It is a **specialization constant**, so the seventy-odd `.spv` of this
// family do not double; MAXROWS is the compile-time bound the LDS and the
// accumulators are sized by.
//
// **The arithmetic is not the GEMM's, and the difference is below the floor
// the block already sits on.** The GEMM stores `float16_t(ds*nib - dm)` into
// LDS because a fragment is halves; here the unpacked weight stays an f32 and
// the product with the f16 activation is exact, so a dot product carries one
// fewer rounding per weight. It cannot be made bit-identical to that path from
// a register — D10: `float(float16_t(x))` is folded away by RADV, and unlike
// L8b-2's `float16_t(q) * d` there is no pair of exact halves to multiply
// here. Measured rather than assumed: the two kernels differ by rms 2.5e-06 on
// an `ffn_out` whose distance from llama.cpp's own is 4.65e-05, so it is fifty
// times under the difference the block already has (TestMoEGPUDecode).

#define MOE_QBANK
#include "llm_common.glsl"

#ifndef MODE
#define MODE 0      // 0 = gate/up + swiglu, 1 = down, scattered by position
#endif
#define FMT_Q4_K 0
#define FMT_Q5_K 1
#define FMT_Q5_1 2
#define FMT_Q8_0 3
// P4c's two: the block-32 formats `ffn_down_exps` can be narrowed to, since
// its row of 640 is two and a half K-quant super-blocks and no `_K` format
// exists for it. Q4_1 is Q5_1 without the plane of fifth bits (20 bytes, 5.0
// bits); IQ4_NL is 18 bytes and 4.5, a scale and nibbles that index a
// non-linear codebook rather than a level.
#define FMT_Q4_1 4
#define FMT_IQ4NL 5
#ifndef QFMT
#define QFMT FMT_Q4_K
#endif
// Lanes that share one output column. It is the only ladder axis that changes
// the shape of a load: a column's row of the bank is `nqd` quantised dwords
// and LPR lanes walk it in stride, so LPR consecutive lanes read LPR
// consecutive dwords — 4*LPR contiguous bytes an instruction, up to a whole
// 256-byte pair of cache lines at 64.
//
// It has to divide 64 and it wants to divide `nqd`. The four shapes this
// block runs are Q4_K/Q5_K at K = 2560 (320 dwords), Q8_0 at 2560 (640) and
// at 640 (160), and Q5_1 at 640 (80) — so 16 divides every one of them, 32
// all but Q5_1's and 64 only the two at 2560. The loop below covers any
// remainder; the ladder is what says which rung to stand on.
//
// **Q4_K's unit is the quad, not the dword** (`loadQuad`), so its row of 2560
// is 80 units: 16 divides it and 32 and 64 do not. At v64 the last pass over a
// row ran 16 lanes of 64, and the routed up mode moved to v16w4 with the quad
// (`MoEPlanFor`).
#ifndef LPR
#define LPR 64
#endif
// Waves a workgroup, which here buys exactly one thing: the A vector is
// staged in LDS once per workgroup, so four waves read it a quarter as many
// times. It changes no arithmetic and no weight traffic.
#ifndef WAVES
#define WAVES 1
#endif

// Rows of A this dispatch carries: P5b. See the header.
layout(constant_id = 0) const uint ROWS = 1;
#define MAXROWS 3

#define WAVE 64
#define LANES (WAVES * WAVE)
#define NCOL (LANES / LPR)
// The longest A this block has: the up mode reduces over nEmbd = 2560 and the
// down mode over the expert width, 640.
#ifndef AKMAX
#define AKMAX 2560
#endif

layout(local_size_x = LANES) in;

// One A vector per row, staged once for the whole workgroup. At the widest
// shape this block runs (K = 2560) that is 5 KB a row.
shared float16_t sA[MAXROWS * AKMAX];

// ---- The formats, as the GEMM states them: bytes a block covers, elements a
// block covers, and — the one thing a GEMV needs that a slab unpack does not
// — how many **dwords of quantised payload** a block holds, because that is
// the axis the lanes divide.
#if QFMT == FMT_Q4_K
#define QK 256u
#define QB 144u
#define QSDB 32u
#elif QFMT == FMT_Q5_K
#define QK 256u
#define QB 176u
#define QSDB 32u
#elif QFMT == FMT_Q5_1
#define QK 32u
#define QB 24u
#define QSDB 4u
#elif QFMT == FMT_Q4_1
#define QK 32u
#define QB 20u
#define QSDB 4u
#elif QFMT == FMT_IQ4NL
#define QK 32u
#define QB 18u
#define QSDB 4u
#else
#define QK 32u
#define QB 34u
#define QSDB 8u
#endif

#if QFMT == FMT_IQ4NL
// IQ4_NL's sixteen levels — `kvalues_iq4nl`: -127, -104, -83, -65, -49, -35,
// -22, -10, 1, 13, 25, 38, 53, 69, 89, 113 — packed one signed byte a level
// into four dwords.
//
// **This is the initialiser, not the lookup.** A nibble's level is needed
// eight times per payload dword and the index is divergent, so reading it out
// of the packed form costs a `cndmask` chain for the vector component, a
// bitfield extract and a convert — around five instructions in the hottest
// loop in the kernel, against Q4_1's one convert. So sixteen lanes widen the
// table into LDS once per workgroup and the loop indexes that instead: the
// codebook is 64 bytes beside the 5 KB of A that is already there, and the
// barrier it needs is the one the A staging already does.
float iq4nlConst(uint l) {
    uvec4 tab = uvec4(0xBFAD9881u, 0xF6EADDCFu, 0x26190D01u, 0x71594535u);
    return float(bitfieldExtract(int(tab[l >> 2]), int((l & 3u) << 3), 8));
}

shared float kIQ4[16];
#endif

#if QFMT == FMT_Q4_K || QFMT == FMT_Q5_K
// ggml's get_scale_min_k4, unchanged from the GEMM's copy.
uint sbyte(uvec3 s, uint i) {
    uint w = (i < 4u) ? s.x : ((i < 8u) ? s.y : s.z);
    return (w >> ((i & 3u) * 8u)) & 0xFFu;
}

void scaleMinK4(uint j, uvec3 s, out uint sc, out uint mn) {
    if (j < 4u) {
        sc = sbyte(s, j) & 63u;
        mn = sbyte(s, j + 4u) & 63u;
    } else {
        uint a = sbyte(s, j + 4u);
        sc = (a & 0xFu) | ((sbyte(s, j - 4u) >> 6) << 4);
        mn = (a >> 4) | ((sbyte(s, j) >> 6) << 4);
    }
}
#endif

// unpackDword is the whole kernel's load: the `d`-th quantised dword of the
// bank row that starts at byte `rb`, unpacked into registers as the weights
// of the elements of A it covers. Eight elements for every format — four
// bytes, two nibbles each for the nibble formats: `lo[b]` multiplies element
// `kLo + b` and `hi[b]` element `kHi + b`. Q8_0's dword is four int8s and has
// no `hi`, which is why its row holds twice the dwords for the same K.
//
// **It is separate from the dot product because of the rows** (CONCURRENCY.md
// C5): a dword is unpacked once and `dotRow` consumes it for every real row
// of the tile. When the two were one function a row repeated the load, the
// scale decode and the unpack, and the shared expert — the same bytes at any
// row count — cost 15.6, 23.4 and 32.2 us a dispatch at one, two and three
// rows. Every product and every sum is the one the fused function computed,
// in the same order, so a row's result does not depend on how many rows its
// tile has.
struct W8 {
    vec4 lo;
    vec4 hi;
    uint kLo;
    uint kHi;
#if QFMT == FMT_IQ4NL
    float scale;    // the block's, applied to the dword's sum as before
#endif
};

#if QFMT == FMT_Q4_K
W8 unpackDword(uint rb, uint d) {
    uint sb = d >> 5;               // which 256-element super-block
    uint ll = d & 31u;              // which of its 32 payload dwords
    uint blk = rb + sb * QB;
    uint hw = blk >> 2;
    vec2 dd = unpackHalf2x16(qbank[hw]);
    uvec3 s = uvec3(qbank[hw + 1u], qbank[hw + 2u], qbank[hw + 3u]);
    // A dword's four bytes are one 32-element sub-block in their low nibbles
    // and the next one in their high nibbles, so both of the super-block's
    // scale pairs for this 64-group are needed and neither is read twice.
    uint g = ll >> 3;
    uint sc0, mn0, sc1, mn1;
    scaleMinK4(2u * g, s, sc0, mn0);
    scaleMinK4(2u * g + 1u, s, sc1, mn1);
    float ds0 = dd.x * float(sc0), dm0 = dd.y * float(mn0);
    float ds1 = dd.x * float(sc1), dm1 = dd.y * float(mn1);
    uint w = qbank[hw + 4u + ll];
    W8 o;
    o.kLo = sb * QK + g * 64u + (ll & 7u) * 4u;
    o.kHi = o.kLo + 32u;
    [[unroll]] for (uint b = 0u; b < 4u; ++b) {
        uint by = (w >> (8u * b)) & 0xFFu;
        o.lo[b] = ds0 * float(by & 0xFu) - dm0;
        o.hi[b] = ds1 * float(by >> 4) - dm1;
    }
    return o;
}
#elif QFMT == FMT_Q5_K
W8 unpackDword(uint rb, uint d) {
    uint sb = d >> 5;
    uint ll = d & 31u;
    uint blk = rb + sb * QB;
    uint hw = blk >> 2;
    vec2 dd = unpackHalf2x16(qbank[hw]);
    uvec3 s = uvec3(qbank[hw + 1u], qbank[hw + 2u], qbank[hw + 3u]);
    uint g = ll >> 3;
    uint sc0, mn0, sc1, mn1;
    scaleMinK4(2u * g, s, sc0, mn0);
    scaleMinK4(2u * g + 1u, s, sc1, mn1);
    float ds0 = dd.x * float(sc0), dm0 = dd.y * float(mn0);
    float ds1 = dd.x * float(sc1), dm1 = dd.y * float(mn1);
    // The fifth bit of element j of the super-block is bit (j >> 5) of
    // qh[j & 31], and a dword's eight elements share one qh byte per byte of
    // payload — so one dword of qh covers this lane's four.
    uint h = qbank[hw + 4u + (ll & 7u)];
    uint w = qbank[hw + 12u + ll];
    W8 o;
    o.kLo = sb * QK + g * 64u + (ll & 7u) * 4u;
    o.kHi = o.kLo + 32u;
    [[unroll]] for (uint b = 0u; b < 4u; ++b) {
        uint by = (w >> (8u * b)) & 0xFFu;
        uint hb = (h >> (8u * b)) & 0xFFu;
        uint lo = (by & 0xFu) | (((hb >> (2u * g)) & 1u) << 4);
        uint hi = (by >> 4) | (((hb >> (2u * g + 1u)) & 1u) << 4);
        o.lo[b] = ds0 * float(lo) - dm0;
        o.hi[b] = ds1 * float(hi) - dm1;
    }
    return o;
}
#elif QFMT == FMT_Q5_1
W8 unpackDword(uint rb, uint d) {
    uint m = d >> 2;                // which 32-element block
    uint qq = d & 3u;               // which of its four payload dwords
    uint blk = rb + m * QB;
    uint hw = blk >> 2;
    vec2 dm = unpackHalf2x16(qbank[hw]);
    uint qh = qbank[hw + 1u];
    uint w = qbank[hw + 2u + qq];
    uint j0 = qq * 4u;
    W8 o;
    o.kLo = m * QK + j0;
    o.kHi = o.kLo + 16u;
    [[unroll]] for (uint b = 0u; b < 4u; ++b) {
        uint j = j0 + b;
        uint by = (w >> (8u * b)) & 0xFFu;
        uint lo = (by & 0xFu) | (((qh >> j) & 1u) << 4);
        uint hi = (by >> 4) | (((qh >> (j + 16u)) & 1u) << 4);
        o.lo[b] = float(lo) * dm.x + dm.y;
        o.hi[b] = float(hi) * dm.x + dm.y;
    }
    return o;
}
#elif QFMT == FMT_Q4_1
// Q4_1 is the one format in this block with no addressing question at all:
// twenty bytes a block keeps every block four-aligned, and the nibble pairs
// split 0..15 / 16..31 exactly as Q5_1's do.
W8 unpackDword(uint rb, uint d) {
    uint m = d >> 2;                // which 32-element block
    uint qq = d & 3u;               // which of its four payload dwords
    uint hw = (rb + m * QB) >> 2;
    vec2 dm = unpackHalf2x16(qbank[hw]);
    uint w = qbank[hw + 1u + qq];
    W8 o;
    o.kLo = m * QK + qq * 4u;
    o.kHi = o.kLo + 16u;
    [[unroll]] for (uint b = 0u; b < 4u; ++b) {
        uint by = (w >> (8u * b)) & 0xFFu;
        o.lo[b] = float(by & 0xFu) * dm.x + dm.y;
        o.hi[b] = float(by >> 4) * dm.x + dm.y;
    }
    return o;
}
#elif QFMT == FMT_IQ4NL
// IQ4_NL is the one format here whose rows are **ours and not ggml's
// records**: blocks in pairs of 36 bytes — two scales, then the two blocks'
// sixteen nibble bytes each (`pairIQ4NLRow`).
//
// ggml's eighteen-byte record is not a multiple of four, so every other block
// would start two bytes into a word and a payload dword would come out of
// Q8_0's two-word window: **180.2 GB/s against Q4_1's 211.4** on 10% fewer
// bytes. A plane of scales and a plane of nibbles fixes that for *this*
// kernel — 203.3 — and costs the GEMM 36%, because a slab unpack touches one
// block of sixty-four different rows per K-step and a split scale doubles the
// lines it opens. **36 is a multiple of four and keeps a block's scale beside
// its own nibbles**, which is the arrangement both kernels want.
W8 unpackDword(uint rb, uint d) {
    uint m = d >> 2;                    // which 32-element block
    uint qq = d & 3u;                   // which of its four payload dwords
    // The pair's record: two scales in the first word, then two 16-byte
    // nibble groups.
    uint pw = (rb + (m >> 1) * 36u) >> 2;
    vec2 dd = unpackHalf2x16(qbank[pw]);
    float dq = ((m & 1u) == 0u) ? dd.x : dd.y;
    uint w = qbank[pw + 1u + (m & 1u) * 4u + qq];
    W8 o;
    o.kLo = m * QK + qq * 4u;
    o.kHi = o.kLo + 16u;
    // The scale is the block's, so it multiplies the sum rather than each of
    // the eight terms — eight fewer multiplies a dword than an affine format
    // can hoist, because there is no min to add per element.
    o.scale = dq;
    [[unroll]] for (uint b = 0u; b < 4u; ++b) {
        uint by = (w >> (8u * b)) & 0xFFu;
        o.lo[b] = kIQ4[by & 0xFu];
        o.hi[b] = kIQ4[by >> 4];
    }
    return o;
}
#else
// Q8_0's 34-byte block is the one that is not word-aligned below the row: the
// int8s start at an offset of 2 mod 4 on every other block, so a payload
// dword comes out of a two-word rotating window.
W8 unpackDword(uint rb, uint d) {
    uint m = d >> 3;
    uint qq = d & 7u;
    uint blk = rb + m * QB;
    uint hw = blk >> 2;
    vec2 dd = unpackHalf2x16(qbank[hw]);
    float dq = ((blk & 2u) == 0u) ? dd.x : dd.y;
    uint base = blk + 2u;
    uint bw = (base >> 2) + qq;
    uint w = ((base & 2u) != 0u) ? ((qbank[bw] >> 16) | (qbank[bw + 1u] << 16)) : qbank[bw];
    W8 o;
    o.kLo = m * QK + qq * 4u;
    o.kHi = o.kLo;
    o.hi = vec4(0.0);
    [[unroll]] for (uint b = 0u; b < 4u; ++b) {
        uint by = (w >> (8u * b)) & 0xFFu;
        o.lo[b] = float(int(by) - int((by >> 7) << 8)) * dq;
    }
    return o;
}
#endif

// dotRow is one row of A against an unpacked dword: the fused function's
// sum, term for term.
float dotRow(W8 w, uint row) {
    uint a = row * AKMAX;
    float acc = 0.0;
    [[unroll]] for (uint b = 0u; b < 4u; ++b) {
        acc += w.lo[b] * float(sA[a + w.kLo + b]);
#if QFMT != FMT_Q8_0
        acc += w.hi[b] * float(sA[a + w.kHi + b]);
#endif
    }
#if QFMT == FMT_IQ4NL
    return acc * w.scale;
#else
    return acc;
#endif
}

#if QFMT == FMT_Q4_K
// **Q4_K is walked a quad at a time: four payload dwords, one `uvec4`**
// (CONCURRENCY.md, after C6). A dword at a time, a lane issued five scalar
// loads for every four bytes of nibbles — the header's `d`/`dmin` and its
// three scale words, then the payload — and this kernel is bound by how many
// loads it issues, which is the finding P12 made about the GEMM's slab and
// L5b-7 before it. Four consecutive dwords of a super-block's nibbles are
// sixteen bytes of one 64-element group, so they share both scale pairs, and
// the quad is two sixteen-byte loads: the header and the payload. Every Q4_K
// block is sixteen-byte aligned (`MoEGPU.build` checks it; see
// llm_moe_gemm.comp's `qhdr`).
//
// A row of K = 2560 is ten super-blocks of eight quads. Quad `q`'s low
// nibbles are elements `kLo .. kLo+15` of the row and its high nibbles the
// sixteen 32 further on.
struct Q4KQuad {
    uvec4 q;
    float ds0, dm0, ds1, dm1;
    uint kLo;
};

Q4KQuad loadQuad(uint rb, uint q) {
    uint sb = q >> 3;               // which 256-element super-block
    uint qq = q & 7u;               // which of its eight payload quads
    uint g = qq >> 1;               // which 64-element group
    uint blk = rb + sb * QB;
    uvec4 hdr = qbank4[blk >> 4];
    vec2 dd = unpackHalf2x16(hdr.x);
    uint sc0, mn0, sc1, mn1;
    scaleMinK4(2u * g, hdr.yzw, sc0, mn0);
    scaleMinK4(2u * g + 1u, hdr.yzw, sc1, mn1);
    Q4KQuad o;
    o.q = qbank4[(blk + 16u + qq * 16u) >> 4];
    o.ds0 = dd.x * float(sc0);
    o.dm0 = dd.y * float(mn0);
    o.ds1 = dd.x * float(sc1);
    o.dm1 = dd.y * float(mn1);
    o.kLo = sb * QK + g * 64u + (qq & 1u) * 16u;
    return o;
}

// dotQuad is one row of A against a quad. The nibbles are unpacked per row
// rather than held unpacked across rows: thirty-two floats a quad per mode
// would be the kernel's registers, and a tile's rows past the first are rare
// when the rows are different conversations (C5).
float dotQuad(Q4KQuad w, uint row) {
    uint a = row * AKMAX + w.kLo;
    float acc = 0.0;
    [[unroll]] for (uint t = 0u; t < 4u; ++t) {
        [[unroll]] for (uint b = 0u; b < 4u; ++b) {
            uint by = (w.q[t] >> (8u * b)) & 0xFFu;
            acc += (w.ds0 * float(by & 0xFu) - w.dm0) * float(sA[a + t * 4u + b]);
            acc += (w.ds1 * float(by >> 4) - w.dm1) * float(sA[a + 32u + t * 4u + b]);
        }
    }
    return acc;
}
#endif

float sigmoidf(float x) { return 1.0 / (1.0 + exp(-x)); }

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tileIdx = gl_WorkGroupID.y;
    // The grid is the same static upper bound the GEMM's is, and the same
    // early return: the schedule's real length lives on the device.
    if (tileIdx >= actu[pc.moeTileOff]) {
        return;
    }
    uint rec = pc.moeTileOff + 2u + 3u * tileIdx;
    uint expert = actu[rec];
    uint rowStart = actu[rec + 1u];
    // The real rows; the rest of the tile is padding (see the header). Every
    // guard below tests ROWS as well, which is a constant, so that a one-row
    // build still compiles to one row's code.
    uint real = actu[rec + 2u];
    uint slots = MOE_USED + 1u;

    // The row. MODE 0's is some token's row of the block input, named by the
    // permutation; MODE 1's is the permutation position itself, which is what
    // MODE 0 wrote. One row per tile — see the header.
    [[unroll]] for (uint r = 0u; r < MAXROWS; r++) {
        if (r >= ROWS || r >= real) {
            continue;
        }
#if MODE == 0
        uint p = actu[pc.moePermOff + rowStart + r];
        uint aBase = pc.xnOff + (p / slots) * pc.lda;
#else
        uint aBase = pc.ctxOff + (rowStart + r) * pc.ldCtx;
#endif
        for (uint k = tid; k < pc.gemmK; k += LANES) {
            sA[r * AKMAX + k] = hact[aBase + k];
        }
    }
#if QFMT == FMT_IQ4NL
    if (tid < 16u) {
        kIQ4[tid] = iq4nlConst(tid);
    }
#endif
    barrier();

    uint lane = tid & (LPR - 1u);
    uint n0 = gl_WorkGroupID.x * NCOL + (tid / LPR);
    uint rowBytes = (pc.gemmK / QK) * QB;
    uint bankRow = expert * pc.gemmN + n0;
    uint rb0 = pc.bOff + bankRow * rowBytes;
#if MODE == 0
    uint rb1 = pc.moeBOff2 + bankRow * rowBytes;
#endif

    uint nqd = (pc.gemmK / QK) * QSDB;
    // **The row loop is inside the dword loop, and P5c is why.** P5b put it
    // outside on the argument that registers were scarcer than bank traffic —
    // the bank row would be in the L1 by the second pass over it, so the
    // weight would still be read once from DRAM. On a two-layer fixture that
    // is true. In the whole model it is not: `moe.up` measured **101 GB/s of
    // bank at two rows against 141 at one**, which is a second DRAM read and
    // not an L1 hit, and it cost the block 2.42x a one-row pass where the
    // expert set only grew 1.74x. Forty-eight layers of expert bank do not
    // stay in anything.
    //
    // So a dword (a quad, for Q4_K) is loaded once and consumed by every row
    // before the next one is issued. The cost is MAXROWS live accumulators
    // per mode. Until C5's follow-up the load sat *inside* the per-row call
    // and was issued again for each row; see `unpackDword`.
    float acc0[MAXROWS];
#if MODE == 0
    float acc1[MAXROWS];
#endif
    [[unroll]] for (uint r = 0u; r < MAXROWS; r++) {
        acc0[r] = 0.0;
#if MODE == 0
        acc1[r] = 0.0;
#endif
    }
#if QFMT == FMT_Q4_K
    uint nquad = (pc.gemmK / QK) * 8u;
    for (uint q = lane; q < nquad; q += LPR) {
        Q4KQuad w0 = loadQuad(rb0, q);
#if MODE == 0
        Q4KQuad w1 = loadQuad(rb1, q);
#endif
        [[unroll]] for (uint r = 0u; r < MAXROWS; r++) {
            if (r >= ROWS || r >= real) {
                continue;
            }
            acc0[r] += dotQuad(w0, r);
#if MODE == 0
            acc1[r] += dotQuad(w1, r);
#endif
        }
    }
#else
    for (uint d = lane; d < nqd; d += LPR) {
        W8 w0 = unpackDword(rb0, d);
#if MODE == 0
        W8 w1 = unpackDword(rb1, d);
#endif
        [[unroll]] for (uint r = 0u; r < MAXROWS; r++) {
            if (r >= ROWS || r >= real) {
                continue;
            }
            acc0[r] += dotRow(w0, r);
#if MODE == 0
            acc1[r] += dotRow(w1, r);
#endif
        }
    }
#endif

    [[unroll]] for (uint r = 0u; r < MAXROWS; r++) {
        if (r >= ROWS || r >= real) {
            continue;
        }
        float s0 = subgroupClusteredAdd(acc0[r], LPR);
#if MODE == 0
        float s1 = subgroupClusteredAdd(acc1[r], LPR);
#endif
        if (lane != 0u) {
            continue;
        }
#if MODE == 0
        // `ggml_swiglu_split` on the two sums, so the [rows, 640] pair the
        // reference materialises never exists here either.
        hact[pc.ctxOff + (rowStart + r) * pc.ldCtx + n0] =
            float16_t(s0 * sigmoidf(s0) * s1);
#else
        act[pc.gatedOff + (rowStart + r) * pc.nEmbd + n0] = s0;
#endif
    }
}
